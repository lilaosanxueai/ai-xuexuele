  "teach": {
    "sections": [
      {
        "title": "动量 p = mv",
        "body": "【动量 = 质量 × 速度，矢量，方向与速度相同，单位 kg·m/s】\n卡车 10m/s 和自行车 10m/s 速度相同，动量差百倍。\n动量描述\"运动量\"的多少，是状态量。"
      },
      {
        "title": "动量守恒定律",
        "body": "【系统不受外力或外力矢量和为零时，总动量保持不变】\nm₁v₁ + m₂v₂ = m₁v₁′ + m₂v₂′\n碰撞、爆炸、反冲（火箭）都近似守恒——内力远大于外力的瞬间过程。\n守恒是矢量守恒：先定正方向，反向速度取负。"
      },
      {
        "title": "弹性与非弹性",
        "body": "【弹性碰撞：动量守恒 + 动能守恒，碰后分开不粘】\n【完全非弹性碰撞：碰后合体同速，动能损失最大】\n例：等质量弹性碰撞——速度\"交换\"（台球定杆）。\n能量去向：非弹性碰撞的动能变成了内能（发热变形）。"
      }
    ],
    "examples": [
      {
        "q": "2kg 的甲球以 4m/s 撞静止的 2kg 乙球（弹性碰撞），碰后各多快？",
        "steps": [
          "等质量弹性碰撞速度交换",
          "甲碰后速度 0",
          "乙碰后速度 4m/s",
          "验证：2×4 = 2×0 + 2×4 ✓"
        ],
        "tip": "等质量弹性=速度交换"
      },
      {
        "q": "为什么火箭能在真空中加速？",
        "steps": [
          "火箭+燃气组成系统",
          "燃气高速向后喷（获得向后动量）",
          "系统总动量守恒",
          "火箭必获得等量向前动量"
        ],
        "tip": "反冲是守恒的体现"
      }
    ],
    "mistakes": [
      "动量守恒当标量算（必须先定正方向）",
      "认为非弹性碰撞动量也不守恒（守恒的是动量，不是动能）"
    ]
  },
