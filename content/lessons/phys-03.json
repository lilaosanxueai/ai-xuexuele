  "starterCode": "# 动量守恒碰撞台\nm1 = 2   # 甲球质量（kg）\nm2 = 2   # 乙球质量（kg，静止）\nv1 = 4   # 甲球初速（m/s）\n\nhide()\np0 = m1 * v1\nu1 = (m1 - m2) * v1 / (m1 + m2)\nu2 = 2 * m1 * v1 / (m1 + m2)\np1 = m1 * u1 + m2 * u2\nfill_rect(0, 150, 360, 28, \"#1d4ed8\")\nwrite(\"碰前总动量 \" + p0 + \" = 碰后总动量 \" + p1, 0, 150, \"#fff\", 11)\ncircle(-140, 60, m1 * 9, \"#dc2626\")\nwrite(\"m1\", -140, 60, \"#fff\", 11)\npen_color(\"#dc2626\")\npen_down()\ngo_to(-125, 60)\ngo_to(-125 + v1 * 8, 60)\npen_up()\nwrite(\"v1=\" + v1, -90, 78, \"#dc2626\", 10)\ncircle(120, 60, m2 * 9, \"#2563eb\")\nwrite(\"m2\", 120, 60, \"#fff\", 11)\nwrite(\"静止\", 120, 88, \"#64748b\", 10)\ncircle(-140, -50, m1 * 9, \"#dc2626\")\nwrite(\"u1\", -140, -50, \"#fff\", 11)\npen_color(\"#7c3aed\")\npen_down()\ngo_to(-140 + m1 * 9, -50)\ngo_to(-140 + m1 * 9 + u1 * 8, -50)\npen_up()\ncircle(120, -50, m2 * 9, \"#2563eb\")\nwrite(\"u2\", 120, -50, \"#fff\", 11)\npen_color(\"#16a34a\")\npen_down()\ngo_to(120 + m2 * 9, -50)\ngo_to(120 + m2 * 9 + u2 * 8, -50)\npen_up()\nwrite(\"碰后：u1 = \" + u1 + \" m/s，u2 = \" + u2 + \" m/s（弹性碰撞）\", 0, -120, \"#0f172a\", 11)\nwrite(\"上：碰前   下：碰后\", 0, -145, \"#94a3b8\", 10)\n",
