  "teach": {
    "sections": [
      {
        "title": "遗忘曲线",
        "body": "【发现者】德国心理学家艾宾浩斯（1885 年），用无意义音节在自己身上做实验。\n【规律】先快后慢：20 分钟忘 42%，1 天忘 67%，6 天后趋于平缓。\n【意义】记忆的敌人不是时间，而是\"头几天不复习\"。"
      },
      {
        "title": "间隔复习法",
        "body": "【节奏】当天→第2天→第4天→第7天→第15天→第30天。\n【原理】在遗忘临界点复习，记忆痕迹被反复加深，遗忘曲线越来越平。\n【工具】错题本+闪卡（正面问题背面答案）天然适合间隔复习。"
      },
      {
        "title": "高效记忆策略",
        "body": "【主动回忆】测试自己>重读课本。\n【多感官】读出声+写下来+画成图——通道越多痕迹越深。\n【睡眠】学习后睡好觉，大脑在夜里完成\"存盘\"。"
      }
    ],
    "examples": [
      {
        "q": "周一听写周五考，怎样复习最省力？",
        "steps": [
          "周一当天过一遍（堵住最大遗忘口）",
          "周二再过一遍",
          "周四用主动回忆自测",
          "周五考前只需轻松确认"
        ],
        "tip": "间隔+主动回忆"
      },
      {
        "q": "为什么\"看懂了\"不等于\"记住了\"？",
        "steps": [
          "看懂=理解（当时明白）",
          "记住=存入长期记忆",
          "理解后不复习照样忘",
          "理解+间隔复习才落袋"
        ],
        "tip": "理解和记忆是两回事"
      }
    ],
    "mistakes": [
      "认为忘得快=记性差（所有人都先快后慢）",
      "认为复习次数越多越好（卡对时机比次数重要）"
    ]
  },
