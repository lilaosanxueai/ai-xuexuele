  "teach": {
    "sections": [
      {
        "title": "遗忘曲线",
        "body": "【艾宾浩斯1885】无意义音节实验：遗忘先快后慢，6天后趋于稳定约25%保留率。\n意义：不是你记性差，是所有人都这样——差别在有没有在正确的时间点复习。"
      },
      {
        "title": "记忆三阶段",
        "body": "【感觉→短时→长时】注意是闸门：没注意的信息连短时记忆都进不了。\n组块化（138 0013 8000→分三段）扩展短时容量：7±2 个组块。"
      },
      {
        "title": "高效复习三招",
        "body": "【间隔效应】分散复习>集中突击。\n【测试效应】主动回忆>被动重读；错题重做是最强的记忆训练。\n【睡眠】睡前复习+睡够=海马体夜间归档。"
      }
    ],
    "examples": [
      {
        "q": "背 40 个单词明天要考，怎么安排？",
        "steps": [
          "今晚：全部过一遍+难的做标记",
          "睡前：只复习标记的难词",
          "明早：快速自测一遍全部",
          "间隔三轮远胜今晚只背一遍"
        ],
        "tip": "当天+睡前+早晨=三保险"
      },
      {
        "q": "为什么\"反复看笔记\"感觉都会但一考就懵？",
        "steps": [
          "看笔记=再认（认识≠会提取）",
          "考试=回忆（要从零提取）",
          "练习方式要匹配考试方式",
          "合上书自己复述一遍才有效"
        ],
        "tip": "用考试的方式复习"
      }
    ],
    "mistakes": [
      "认为一遍就记住不再复习（一天后只剩三分之一）",
      "认为熬夜刷题效果好（缺睡阻断记忆归档）"
    ]
  },
