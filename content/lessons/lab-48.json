  "views": [
    {
      "when": 1,
      "title": "洗菜",
      "subtitle": "干净第一",
      "color": "green",
      "emoji": "🥬",
      "blocks": [
        {
          "kind": "steps",
          "title": "洗菜四步",
          "items": [
            "先洗手：用流动水和肥皂洗20秒——手干净菜才干净",
            "流动水冲洗：开着水轻轻搓洗——泡在盆里洗=在泥水里洗澡",
            "叶菜掰开洗：一片一片掰开·根部的泥重点搓——虫和泥都藏在缝里",
            "洗完沥水：放漏篮里控干水——带水下锅会溅油"
          ]
        },
        {
          "kind": "info",
          "icon": "⏱️",
          "title": "浸泡的小知识",
          "text": "草莓杨梅这类直接入口的水果·可以用淡盐水泡5-10分钟再冲净——更安心；绿叶菜也可以泡一泡：泡完一定再用流动水冲一遍"
        },
        {
          "kind": "highlight",
          "text": "先洗手·流动水·掰开搓·控干水——洗菜四步"
        }
      ]
    },
    {
      "when": 2,
      "title": "削皮",
      "subtitle": "安全第一",
      "color": "amber",
      "emoji": "🥔",
      "blocks": [
        {
          "kind": "steps",
          "title": "削皮安全三则",
          "items": [
            "刀口朝外：削皮器朝远离手的方向削——永远朝自己身体外面用力",
            "固定好：水果放在垫板上·或拿稳不动·削皮的手稳稳走",
            "慢慢来：不用求快——削皮不是比赛·安全比速度重要一百倍"
          ]
        },
        {
          "kind": "info",
          "icon": "🏆",
          "title": "进阶小挑战",
          "text": "学会基本削法后·试试「一条皮挑战」：转着圈削苹果·皮不断开连成一条长龙——需要稳和耐心·断了自己偷偷笑一下重来"
        },
        {
          "kind": "info",
          "icon": "🗑️",
          "title": "果皮去哪",
          "text": "果皮蔬菜皮是厨余垃圾——削完顺手放进厨余袋·台面擦干净：做完一件事的标志是「现场干干净净」"
        },
        {
          "kind": "highlight",
          "text": "刀口朝外·水果固定·不求快——削皮三安全"
        }
      ]
    },
    {
      "when": 3,
      "title": "果盘",
      "subtitle": "好看好吃",
      "color": "red",
      "emoji": "🌈",
      "blocks": [
        {
          "kind": "steps",
          "title": "摆果盘三步",
          "items": [
            "配颜色：红（苹果草莓）+黄（香蕉橙子）+绿（猕猴桃青提）——三种颜色就漂亮",
            "切与摆：需要刀的请大人切·自己摆：沿盘边一圈一圈排·或中间高周围低堆成小山",
            "加创意：摆成笑脸·花朵·彩虹——最后给果盘起个名字请全家吃"
          ]
        },
        {
          "kind": "info",
          "icon": "🧠",
          "title": "为什么帮厨值得",
          "text": "一顿饭要买菜·洗·切·炒·摆·洗碗——参与一次才知道每口饭的来历：会帮忙的孩子不是「打下手」·是家里真正的一分子"
        },
        {
          "kind": "highlight",
          "text": "三色搭配·大人切我摆·给作品起名字——果盘小艺术家"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "洗菜",
        "body": "【四步】洗手→流动水→掰开搓→沥水。\n【浸泡】直接入口的水果淡盐水泡。"
      },
      {
        "title": "削皮",
        "body": "【三则】刀口朝外·固定好·慢慢来。\n【挑战】一条皮连成龙。\n【收尾】果皮进厨余·台面擦净。"
      },
      {
        "title": "果盘",
        "body": "【颜色】红黄绿三色起步。\n【分工】大人切·自己摆。\n【创意】笑脸花朵彩虹+起名字。"
      }
    ],
    "examples": [
      {
        "q": "晚饭前想帮忙洗青菜",
        "steps": [
          "先把手洗干净",
          "流动水一片片掰开洗",
          "根部泥多搓一搓",
          "漏篮沥水交给妈妈"
        ],
        "tip": "干净交给家长检查"
      },
      {
        "q": "客人来了想摆果盘",
        "steps": [
          "挑红黄绿三种水果",
          "请大人切块",
          "摆成花朵或彩虹",
          "端出去说请品尝"
        ],
        "tip": "颜色+造型"
      }
    ],
    "mistakes": [
      "把菜泡在盆里洗（等于在泥水里洗澡·要流动水）",
      "削皮求快刀口朝自己（安全永远第一）"
    ]
  },
