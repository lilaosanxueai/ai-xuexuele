  ],
  "views": [
    {
      "when": 1,
      "title": "公式",
      "subtitle": "必背表",
      "color": "blue",
      "emoji": "📋",
      "blocks": [
        {
          "kind": "compare",
          "title": "核心公式表",
          "items": [
            {
              "label": "幂函数",
              "value": "(xⁿ)′ = n·xⁿ⁻¹——幂次落下来·指数减一（最常用·必须条件反射）"
            },
            {
              "label": "指数·对数",
              "value": "(eˣ)′ = eˣ（唯一导数等于自己的函数）；(lnx)′ = 1/x"
            },
            {
              "label": "三角",
              "value": "(sinx)′ = cosx·(cosx)′ = −sinx——「正余互换·余变号」"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "⚡",
          "title": "eˣ 的特殊地位",
          "text": "导数等于自己——增长速度与自身一样大（「滚雪球式增长」的数学原型）：银行复利·人口增长· radioactive 衰变全都用它建模：一个公式连接整个自然界"
        },
        {
          "kind": "highlight",
          "text": "xⁿ 落幂减一·eˣ 原封不动·sin/cos 互换变号"
        }
      ]
    },
    {
      "when": 2,
      "title": "四则",
      "subtitle": "加减乘除",
      "color": "green",
      "emoji": "➗",
      "blocks": [
        {
          "kind": "compare",
          "title": "四条法则",
          "items": [
            {
              "label": "加减",
              "value": "[f±g]′ = f′±g′——各求各的·简单"
            },
            {
              "label": "乘法",
              "value": "(fg)′ = f′g + fg′——「前导后不导 + 前不导后导」：乘法不能各自求导再乘（常见错误！）"
            },
            {
              "label": "除法",
              "value": "(f/g)′ = (f′g − fg′)/g²——「分子导乘分母减原乘分母导·除以分母平方」：复杂但机械"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "⚠️",
          "title": "两大高频错误",
          "text": "(fg)′ ≠ f′·g′！（乘法要展开两项）；(f/g)′ 别忘了分母平方：这两个错误占导数计算失分的一半——记法则别「想当然」"
        },
        {
          "kind": "highlight",
          "text": "乘法分两项·除法分母平方——别想当然"
        }
      ]
    },
    {
      "when": 3,
      "title": "链式",
      "subtitle": "剥洋葱",
      "color": "violet",
      "emoji": "🧅",
      "blocks": [
        {
          "kind": "steps",
          "title": "复合函数求导（链式法则）",
          "items": [
            "识别层次：y = f(g(x))——外层 f·内层 g（像洋葱有几层）",
            "由外到内逐层求导·再把各层导数相乘：y′ = f′(g(x))·g′(x)",
            "例：y = sin(x²)：外层 sin 的导数 cos·内层 x² 的导数 2x → y′ = cos(x²)·2x"
          ]
        },
        {
          "kind": "info",
          "icon": "🧠",
          "title": "剥洋葱心法",
          "text": "从最外层剥起·每剥一层乘一个导数——三层套娃 y=f(g(h(x)))：f′·g′·h′ 连乘：链式法则是「复杂问题的分解术」——AI 里的反向传播就是链式法则的工业化版本"
        },
        {
          "kind": "info",
          "icon": "🏭",
          "title": "工程与科学",
          "text": "物理公式代入（复合量的变化率）·经济学（边际成本链式传导）·机器学习（梯度计算每层连乘）——这条「洋葱公式」是现代计算数学的中枢神经"
        },
        {
          "kind": "highlight",
          "text": "由外到内·层层求导·导数连乘——AI 反传的心脏"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "公式表",
        "body": "【幂】(xⁿ)′=nxⁿ⁻¹。【指对】(eˣ)′=eˣ·(lnx)′=1/x。\n【三角】sin↔cos·余变号。"
      },
      {
        "title": "四则",
        "body": "【加减】各自求。【乘】f′g+fg′。\n【除】(f′g−fg′)/g²。\n【警告】(fg)′≠f′g′。"
      },
      {
        "title": "链式",
        "body": "【公式】[f(g(x))]′=f′(g)·g′(x)。\n【心法】由外到内·导数连乘。\n【应用】AI反向传播=链式工业化。"
      }
    ],
    "examples": [
      {
        "q": "求 y=x³·sinx 的导数",
        "steps": [
          "乘法法则两项",
          "3x²·sinx + x³·cosx",
          "别偷懒各自乘",
          "完成"
        ],
        "tip": "前导后不导"
      },
      {
        "q": "求 y=e^(2x) 的导数",
        "steps": [
          "外层 e^u 导数还是 e^u",
          "内层 2x 导数是 2",
          "链式相乘",
          "2e^(2x)"
        ],
        "tip": "剥两层"
      }
    ],
    "mistakes": [
      "乘积求导直接相乘（漏了交叉项）",
      "复合函数忘记乘内层导数（链式漏乘）"
    ]
  },
