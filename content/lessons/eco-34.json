  "views": [
    {
      "when": 1,
      "title": "交换",
      "subtitle": "劳动=商品",
      "color": "blue",
      "emoji": "🔄",
      "blocks": [
        {
          "kind": "info",
          "icon": "🏪",
          "title": "上班=卖东西",
          "text": "大人上班是在\"卖\"：卖时间+体力+脑力——公司付的工资=买这些的钱：外卖员卖奔跑·程序员卖思考·老师卖知识——人人都在做交换"
        },
        {
          "kind": "info",
          "icon": "📊",
          "title": "为什么价格不同",
          "text": "三个因素决定工资：①稀缺（会的人越少越贵）②创造的价值（帮公司赚越多越贵）③风险与辛苦（危险的夜班要加钱）——不是\"谁更了不起\""
        },
        {
          "kind": "highlight",
          "text": "工资是市场给\"劳动\"标的价——不是给\"人\"打分"
        }
      ]
    },
    {
      "when": 2,
      "title": "技能",
      "subtitle": "让自己值钱",
      "color": "green",
      "emoji": "🛠️",
      "blocks": [
        {
          "kind": "steps",
          "title": "值钱三引擎",
          "items": [
            "稀缺技能：别人不会你会（会修电脑的全班都求他）——稀缺=议价权",
            "组合技能：会两样>只会一样（会画+会讲=漫画老师）——1+1>2 的叠加",
            "好口碑：靠谱比聪明稀缺（答应的事一定做到）——信任是最值钱的品牌"
          ]
        },
        {
          "kind": "info",
          "icon": "📚",
          "title": "读书为什么有用",
          "text": "学校学的知识像工具箱——工具越多能修的东西越多·能解决的问题越难：挣钱的本质是\"帮别人解决问题\"的大小与难度——读书=在给未来的自己攒工具"
        },
        {
          "kind": "highlight",
          "text": "让自己值钱=攒更多工具+建立好口碑"
        }
      ]
    },
    {
      "when": 3,
      "title": "尊重",
      "subtitle": "每种劳动",
      "color": "amber",
      "emoji": "🙏",
      "blocks": [
        {
          "kind": "info",
          "icon": "🌃",
          "title": "看不见的凌晨",
          "text": "你睡醒前的城市：环卫工 4 点扫街·菜贩 5 点进货·早餐店 5 点生火·送奶工 6 点跑楼——你的一天是无数劳动托起来的：经济学教\"价格\"·不教\"贵贱\""
        },
        {
          "kind": "info",
          "icon": "⚖️",
          "title": "价格≠价值",
          "text": "清洁工工资不高·但没有他们城市一天就瘫痪——市场给的\"价格\"和工作的\"社会价值\"是两回事：看不起任何劳动者的人没读懂社会"
        },
        {
          "kind": "info",
          "icon": "🌱",
          "title": "你的第一步",
          "text": "小学生也能创造价值：帮同学讲一道题·帮妈妈洗碗·班级图书角管理——每一次\"帮到别人\"都是劳动的练习：值钱的能力从值钱的习惯长出来"
        },
        {
          "kind": "highlight",
          "text": "挣钱是本事·尊重劳动是教养——两样都要有"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "劳动与收入",
        "body": "【本质】卖时间+体力+脑力换工资。\n【三因素】稀缺·价值创造·风险辛苦。\n【澄清】工资是劳动价格非人的分。"
      },
      {
        "title": "值钱三引擎",
        "body": "【稀缺】别人不会你会。\n【组合】1+1>2 叠加技能。\n【口碑】靠谱的信任品牌。\n【读书】攒未来的工具箱。"
      },
      {
        "title": "劳动观",
        "body": "【看见】凌晨的城市运转者。\n【区分】价格≠社会价值。\n【实践】帮到别人=劳动练习。"
      }
    ],
    "examples": [
      {
        "q": "为什么医生工资比收银员高？",
        "steps": [
          "学医 10 年+（投入大）",
          "能做的事难度高（稀缺）",
          "创造的价值大（救命）",
          "不是人高贵·是劳动组合贵"
        ],
        "tip": "拆开看"
      },
      {
        "q": "同学说\"学习不好去送外卖\"",
        "steps": [
          "送外卖也是正经劳动",
          "凌晨雨天的辛苦你看见了吗",
          "每种劳动都托着城市",
          "看不起劳动者才是真的没文化"
        ],
        "tip": "价格≠贵贱"
      }
    ],
    "mistakes": [
      "把工资高低当人的贵贱（是劳动的市场定价）",
      "认为值钱只靠天赋（技能可攒·口碑可养）"
    ]
  },
