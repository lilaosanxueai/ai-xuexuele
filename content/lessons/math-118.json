  "id": "math-118",
  "order": 1077,
  "title": "独立事件：互不影响",
  "emoji": "🎲",
  "textbook": "人教A版数学（必修二）",
  "curriculum": {
    "module": "概率",
    "points": [
      "独立性定义",
      "乘法公式",
      "独立重复试验"
    ]
  },
  "story": "掷两次硬币·第二次的结果会受第一次影响吗？不会——这就是「独立」。独立性让概率可以相乘：从连续投篮到彩票中奖·大量现实问题靠它建模。",
  "goals": [
    "理解独立性的定义",
    "掌握乘法公式",
    "认识独立重复试验"
  ],
  "aiIntro": "🎲 互不干涉——独立事件",
  "param": {
    "name": "in",
    "label": "独立站",
    "min": 1,
    "max": 3,
    "step": 1,
    "value": 1
  },
  "explore": [
    "独立和互斥差在哪？",
    "概率何时相乘？",
    "连续失败概率多大？"
  ],
  "views": [
    {
      "when": 1,
      "title": "定义",
      "subtitle": "彼此无感",
      "color": "blue",
      "emoji": "🔀",
      "blocks": [
        {
          "kind": "info",
          "icon": "📖",
          "title": "独立事件",
          "text": "A 的发生与否不影响 B 发生的概率——P(B|A) = P(B)：定义式 P(AB) = P(A)·P(B)（同时发生的概率=概率之积）：「一个已经发生」不改变「另一个的剧本」"
        },
        {
          "kind": "compare",
          "title": "独立 ≠ 互斥",
          "items": [
            {
              "label": "互斥",
              "value": "一个发生·另一个必然不发生——影响强烈（P(AB)=0）：掷骰子的 1 和 2"
            },
            {
              "label": "独立",
              "value": "一个发生·另一个概率纹丝不动（P(AB)=P(A)P(B)）：两次射击"
            },
            {
              "label": "判断",
              "value": "互斥的 P(AB)=0·若都非零则不可能独立——两个都为正概率的事件·互斥与独立不能兼得：新手最容易混的一对概念"
            }
          ]
        },
        {
          "kind": "highlight",
          "text": "互斥=强烈影响·独立=毫无影响——别混"
        }
      ]
    },
    {
      "when": 2,
      "title": "乘法",
      "subtitle": "概率相乘",
      "color": "green",
      "emoji": "✖️",
      "blocks": [
        {
          "kind": "steps",
          "title": "乘法公式的用法",
          "items": [
            "判独立：物理上是否「各掷各的」（新样本·重置·不同对象）",
            "同时发生：P(AB)=P(A)·P(B)——连中两次 = 0.8 × 0.8 = 0.64",
            "依次发生：P(A)·P(B̄) 等组合·逐段相乘（如「第一次中第二次不中」=0.8×0.2）"
          ]
        },
        {
          "kind": "info",
          "icon": "🎰",
          "title": "赌徒谬误",
          "text": "连开 10 把「大」·下一把「该出小了」？——独立！轮盘没有记忆·概率永远是 18/37：直觉的「平衡补偿」不存在：独立事件的反面教材·赌场最爱的错觉"
        },
        {
          "kind": "info",
          "icon": "📉",
          "title": "小概率连乘",
          "text": "一个零件合格率 99%·十个零件全合格 = 0.99¹⁰ ≈ 0.904——「个个都好」反而只有九成：质量管理的数学：串联系统越拉越长·可靠度越乘越低"
        },
        {
          "kind": "highlight",
          "text": "独立则相乘——0.99 连乘十次只剩九成"
        }
      ]
    },
    {
      "when": 3,
      "title": "重复",
      "subtitle": "n 次独立试验",
      "color": "amber",
      "emoji": "🏹",
      "blocks": [
        {
          "kind": "info",
          "icon": "🎯",
          "title": "n 重伯努利试验",
          "text": "同一试验独立重复 n 次·每次成功概率 p——「恰好 k 次成功」：C(n,k)·pᵏ·(1−p)ⁿ⁻ᵏ（选哪 k 次成功 × 成功的 × 失败的）：二项分布的雏形"
        },
        {
          "kind": "steps",
          "title": "实战一例",
          "items": [
            "投篮命中率 0.7·投 4 次恰好 2 中",
            "选位置：C(4,2)=6 种",
            "成功²：0.7²=0.49",
            "失败²：0.3²=0.09 → 6×0.49×0.09≈0.264"
          ]
        },
        {
          "kind": "info",
          "icon": "🧬",
          "title": "科学采样",
          "text": "临床试验分组·质检抽检·A/B 测试——都默认「独立同分布」才能统计推断：独立性是现代统计学得以站住的第一根柱子"
        },
        {
          "kind": "highlight",
          "text": "C(n,k)·pᵏ·(1−p)ⁿ⁻ᵏ——恰好 k 次成功的公式"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "独立性",
        "body": "【定义】P(AB)=P(A)P(B)·互不影响。\n【对比】互斥=强影响（P(AB)=0）。\n【警告】正概率事件互斥与独立不可兼得。"
      },
      {
        "title": "乘法公式",
        "body": "【同时】P(A)P(B)。【依次】逐段相乘。\n【谬误】赌徒谬误——独立无记忆。\n【串联】0.99¹⁰≈0.904。"
      },
      {
        "title": "独立重复",
        "body": "【模型】n 重伯努利试验。\n【公式】C(n,k)pᵏ(1−p)ⁿ⁻ᵏ。\n【应用】投篮·质检·AB测试。"
      }
    ],
    "examples": [
      {
        "q": "两射手各 0.6·同时命中概率",
        "steps": [
          "两人射击独立",
          "乘法公式",
          "0.6 × 0.6",
          "= 0.36"
        ],
        "tip": "独立相乘"
      },
      {
        "q": "4 次独立试验恰好 3 次成功 p=0.5",
        "steps": [
          "C(4,3)=4",
          "0.5³×0.5=0.0625",
          "4×0.0625",
          "=0.25"
        ],
        "tip": "选位×概率"
      }
    ],
    "mistakes": [
      "把互斥当成独立（概念混淆）",
      "相信「该轮到了」的赌徒谬误（独立事件无记忆）"
    ]
  },
