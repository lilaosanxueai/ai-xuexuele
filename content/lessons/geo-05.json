  "starterCode": "# 时区环球旅行：每 15 度经度 = 1 小时时差\nsay(\"环球时区之旅，出发!\")\nfor i in range(6):\n    go_to(-150 + i * 60, 0)\n    wait(0.3)\n    if i == 2:\n        say(\"东京站：东九区，比北京快 1 小时\")\n    if i == 5:\n        say(\"Greenwich! 0 度经线，一切时间的起点!\")\n",
