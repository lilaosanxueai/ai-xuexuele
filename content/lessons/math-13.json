  "teach": {
    "sections": [
      {
        "title": "周长是什么",
        "body": "【围成图形一周的长度叫周长】\n沿着图形边界走一圈，走过的总长度就是周长。\n不规则图形可以用绳子围一圈再拉直量。"
      },
      {
        "title": "长方形和正方形的周长公式",
        "body": "【长方形周长 =（长 + 宽）× 2；正方形周长 = 边长 × 4】\n长方形有两条长两条宽，所以是（长+宽）×2。\n正方形四条边一样长，直接边长×4。"
      }
    ],
    "examples": [
      {
        "q": "长 8 厘米、宽 5 厘米的长方形，周长是多少？",
        "steps": [
          "周长 =（8 + 5）× 2",
          "= 13 × 2",
          "= 26 厘米"
        ],
        "tip": "先加后乘，括号不能丢"
      }
    ],
    "mistakes": [
      "周长和面积混淆：周长是\"一圈的长度\"，面积是\"占的地方大小\"——单位也不同（厘米 vs 平方厘米）"
    ]
  }
