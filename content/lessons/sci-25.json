  "teach": {
    "sections": [
      {
        "title": "脊椎五纲",
        "body": "【鱼：鳃呼吸鳍游泳，卵生体外受精】\n【两栖：幼体水生鳃呼吸，成体肺+皮肤，变态发育】\n【爬行：鳞甲覆盖肺呼吸，卵有坚韧壳——真正陆生】\n【鸟：羽毛前肢成翼，气囊双重呼吸，适飞三件套（流线型/骨中空/直肠短）】\n【哺乳：胎生哺乳恒温，牙齿分化——最高等】"
      },
      {
        "title": "无脊椎",
        "body": "【腔肠动物：水母海蜇（辐射对称）】\n【扁形：血吸虫；线形：蛔虫（寄生）】\n【环节：蚯蚓沙蚕（身体分节）】\n【软体：河蚌蜗牛乌贼（贝壳/外套膜）】\n【节肢：门中之冠——昆虫（三对足）·甲壳·蛛形·多足】\n昆虫是种类最多的动物类群。"
      },
      {
        "title": "分类方法",
        "body": "【检索表：从主特征开始二选一逐级下分】\n先分有无脊椎→脊椎看呼吸生殖→无脊椎看体节外壳足数。\n易错题：鲸鲨是鱼（卵生鳃呼吸）；鲸是哺乳（胎生肺呼吸）。\n蝙蝠会飞是哺乳（胎生哺乳），企鹅不会飞是鸟（羽毛卵生）——分类看本质特征不看表象。"
      }
    ],
    "examples": [
      {
        "q": "蝙蝠会飞，为什么是哺乳类？",
        "steps": [
          "有羽毛吗？没有（翼膜）",
          "胎生哺乳✓ 恒温✓",
          "飞行只是运动方式",
          "本质特征定分类"
        ],
        "tip": "本质非表象"
      },
      {
        "q": "青蛙比鱼高级在哪？",
        "steps": [
          "成体有肺，可上陆",
          "心脏三腔（鱼两腔）",
          "但仍需皮肤辅助呼吸、离不开水",
          "两栖类是过渡类群"
        ],
        "tip": "过渡地位"
      }
    ],
    "mistakes": [
      "按会不会飞分类（蝙蝠企鹅陷阱）",
      "认为青蛙成体还用鳃呼吸（是肺+皮肤）"
    ]
  },
