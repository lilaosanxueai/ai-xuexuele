  "teach": {
    "sections": [
      {
        "title": "开凿概况",
        "body": "【时间：隋炀帝时（605年起）】\n以洛阳为中心，北达涿郡，南至余杭。\n分为永济渠·通济渠·邗沟·江南河四段。\n沟通五大水系，全长两千多公里。"
      },
      {
        "title": "开凿目的",
        "body": "【根本目的：加强南北交通，巩固隋王朝对全国的统治】\n江南经济发达，粮食财赋需要北运。\n隋朝统一后国力强盛，具备开凿的条件。"
      },
      {
        "title": "历史评价",
        "body": "【积极】古代世界最长的运河，促进南北经济文化交流，至今仍在使用（京杭大运河）。\n【消极】滥用民力，徭役繁重，加速隋亡。\n方法：评价历史事件要一分为二，分清「当时」与「长远」。"
      }
    ],
    "examples": [
      {
        "q": "记忆运河走向有什么口诀？",
        "steps": [
          "中心：洛阳",
          "北到涿郡（北京）",
          "南到余杭（杭州）",
          "连起海黄淮长钱五大水系"
        ],
        "tip": "一个中心两个基本点"
      },
      {
        "q": "为什么唐朝是运河最大受益者？",
        "steps": [
          "隋朝修河，唐朝用河",
          "南粮北运支撑长安百万人口",
          "沿河城市扬州汴州繁荣起来",
          "前人栽树后人乘凉"
        ],
        "tip": "功在千秋"
      }
    ],
    "mistakes": [
      "把运河的中心记成长安（是洛阳）",
      "认为开运河纯粹为了隋炀帝游玩（根本目的是巩固统治）"
    ]
  },
