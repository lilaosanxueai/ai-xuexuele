  "teach": {
    "sections": [
      {
        "title": "定理",
        "body": "【内容】垂直于弦的直径平分弦·且平分两条弧。\n【本质】圆的轴对称性。\n【模型】R²=d²+a²。"
      },
      {
        "title": "推论",
        "body": "【互换】平分弦（非直径）的直径垂直于弦。\n【常用】弦的垂直平分线过圆心。\n【例外】弦若是直径·平分≠垂直。"
      },
      {
        "title": "应用",
        "body": "【拱桥】跨20拱高4→R=14.5。\n【其他】管道·破镜重圆·赵州桥。\n【套路】见弦作垂线·勾股列式。"
      }
    ],
    "examples": [
      {
        "q": "弦长16·弦心距6·求半径",
        "steps": [
          "半弦=8",
          "R²=6²+8²",
          "R²=100",
          "R=10"
        ],
        "tip": "勾股一步"
      },
      {
        "q": "破镜重圆找圆心",
        "steps": [
          "弧上取三点连两弦",
          "分别作两弦的垂直平分线",
          "交点即圆心",
          "垂径/中垂线原理"
        ],
        "tip": "两线交点"
      }
    ],
    "mistakes": [
      "把弦心距当成弦的一半（两个不同的量）",
      "推论忘加「弦非直径」条件（直径互相平分不垂直）"
    ]
  },
