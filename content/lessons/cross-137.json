  "teach": {
    "sections": [
      {
        "title": "热机的原理",
        "body": "【热机：燃料化学能 → 内能 → 机械能的装置】\n蒸汽机（外燃）、内燃机（汽油机/柴油机）、汽轮机、喷气发动机都是热机。\n工业革命的引擎，也是现代交通的心脏。"
      },
      {
        "title": "四冲程内燃机",
        "body": "【吸气冲程→压缩冲程→做功冲程→排气冲程，为一个循环】\n只有做功冲程输出动力，其余三个靠飞轮惯性完成。\n曲轴每转两圈完成一个循环（活塞往复两次）。"
      },
      {
        "title": "效率与代价",
        "body": "【热机效率 = 转化为机械能的能量 ÷ 燃料完全燃烧放出的能量，通常仅 20~40%】\n废气带走大量废热；尾气造成空气污染。\n提高效率 + 新能源（电动化）是方向。"
      }
    ],
    "examples": [
      {
        "q": "汽油机的四个冲程中，对外做功的是？",
        "options_ignore": true,
        "steps": [
          "吸气：吸入汽油混合气（耗功）",
          "压缩：压缩混合气（耗功）",
          "做功：火花塞点火燃气膨胀推动活塞（对外做功！）",
          "排气：排出废气（耗功）"
        ],
        "tip": "一个循环只有一次做功，靠飞轮惯性撑过其余三个"
      },
      {
        "q": "某发动机燃烧燃料放出 4000J，输出机械能 1200J，效率是多少？",
        "steps": [
          "η = 机械能/总能量",
          "= 1200/4000",
          "= 30%（属于正常水平）"
        ],
        "tip": "剩下的 70% 主要变成废热排走"
      }
    ],
    "mistakes": [
      "以为每个冲程都做功（只有做功冲程）",
      "热机效率超过 100%（违反能量守恒）"
    ]
  },
