  "teach": {
    "sections": [
      {
        "title": "指挥的基本技术",
        "body": "【右手】打拍子：速度·节拍·重音。\n【左手】表情：渐强渐弱·声部进出·音乐线条。\n【眼睛】与演奏者交流：提醒·鼓励·纠正。\n【身体】重心移动传递能量。"
      },
      {
        "title": "拍号与图示",
        "body": "【2/4】下-上；【3/4】下-右-上；【4/4】下-左-右-上。\n每小节第一拍永远\"向下\"=强拍——这是所有指挥图示的共同规律。"
      },
      {
        "title": "乐团的层级",
        "body": "【首席】第一小提琴的第一位：弦乐组的领袖。\n【各声部首席】木管·铜管·打击各有一人负责。\n【指挥】最终决策者：解释音乐·协调平衡·控制速度。"
      }
    ],
    "examples": [
      {
        "q": "为什么指挥演出时不怎么纠正错误？",
        "steps": [
          "演出时来不及反应",
          "错误已在排练中解决",
          "演出职责是给大方向",
          "排练是上课·演出是考试"
        ],
        "tip": "功夫在场下"
      },
      {
        "q": "右手和左手分别管什么？",
        "steps": [
          "右手：节拍速度",
          "左手：表情力度",
          "两半脑分工",
          "像电脑的双核处理器"
        ],
        "tip": "双手双核"
      }
    ],
    "mistakes": [
      "认为指挥就是\"挥手打拍子\"（更重要的是音乐解释和团队领导）",
      "认为演出时指挥最忙（排练时才是）"
    ]
  },
