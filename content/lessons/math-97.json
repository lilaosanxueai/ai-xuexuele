  "teach": {
    "sections": [
      {
        "title": "线段图",
        "body": "【把题目画成一条线段：两端是出发地，标上速度和时间】\n相遇问题：两车从两端相向而行，线段被相遇点分成两段。\n追及问题：两车同向而行，线段差就是追及路程。\n画图三步：定两端→标已知→找等量关系。"
      },
      {
        "title": "相遇问题",
        "body": "【等量关系：甲走的路程 + 乙走的路程 = 总路程】\n公式：(v1 + v2) × t = s\n相遇时间 = 总路程 ÷ 速度和。\n例：300 km，甲 40 乙 20 相向 → 300÷60 = 5 小时相遇。"
      },
      {
        "title": "追及问题",
        "body": "【等量关系：快者走的路程 − 慢者走的路程 = 初始相距】\n公式：(v快 − v慢) × t = 路程差\n追及时间 = 路程差 ÷ 速度差。\n例：相距 60 km，甲 50 乙 20 同向 → 60÷30 = 2 小时追上。"
      }
    ],
    "examples": [
      {
        "q": "甲乙两地相距 480 km，两车相向而行，甲 55 km/h、乙 65 km/h，几小时相遇？",
        "steps": [
          "画线段图找等量关系",
          "速度和 = 55+65 = 120",
          "(55+65)t = 480",
          "t = 4 小时"
        ],
        "tip": "速度和×时间"
      },
      {
        "q": "甲在乙前方 100 km，甲 40 km/h、乙 60 km/h 同向而行，几小时追上？",
        "steps": [
          "追及看速度差",
          "速度差 = 60-40 = 20",
          "20t = 100",
          "t = 5 小时"
        ],
        "tip": "速度差×时间"
      }
    ],
    "mistakes": [
      "相遇用速度差（应用速度和）",
      "追及用速度和（应用速度差）"
    ]
  },
