    "code": "# 行程演示台：两地相距 300 km，相向而行\nv1 = 40   # 甲速 km/h\nv2 = 20   # 乙速 km/h\nt = 2     # 行驶时间 h\n\nhide()\nd = 300\nx1 = v1 * t\nx2 = d - v2 * t\nmeet = \"还没相遇：继续开\"\ncol = \"#f97316\"\nif x1 >= x2:\n    meet = \"已经相遇（或擦肩而过）！\"\n    col = \"#16a34a\"\nfill_rect(0, 130, 340, 30, \"#2563eb\")\nwrite(\"两地 300km · 甲 \" + v1 + \" km/h · 乙 \" + v2 + \" km/h · \" + t + \" 小时\", 0, 130, \"#fff\", 10)\nfill_rect(-160, 60, 320, 8, \"#94a3b8\")\ncircle(-150, 82, 10, \"#2563eb\")\nwrite(\"甲\", -150, 82, \"#fff\", 9)\ncircle(150, 82, 10, \"#dc2626\")\nwrite(\"乙\", 150, 82, \"#fff\", 9)\nif x1 < 300:\n    circle(-150 + x1 * 0.5, 38, 8, \"#2563eb\")\nif x2 > 0:\n    circle(-150 + x2 * 0.5, 38, 8, \"#dc2626\")\nfill_rect(0, -14, 320, 46, \"#f8fafc\")\nwrite(\"甲走了 \" + x1 + \" km · 乙走了 \" + (v2 * t) + \" km · 共 \" + (x1 + v2 * t) + \" km\", 0, -14, \"#334155\", 10)\nwrite(meet, 0, -70, col, 12)\nwrite(\"相遇：v1 t + v2 t = 总路程\", -20, -104, \"#7c3aed\", 10)\n"
