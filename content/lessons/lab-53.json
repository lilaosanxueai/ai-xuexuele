  "story": "空调越吹越不凉·油烟机越抽越没劲——先别叫师傅·多半是「脏堵了」。拆下滤网那一刻你会震惊：灰尘毛絮糊成毯。这一课学会最常用的两项家电清洗。",
  "goals": [
    "理解脏堵的危害",
    "学会清洗空调滤网",
    "掌握油烟机日常保养"
  ],
  "aiIntro": "🧽 省电又健康的家务——家电清洗",
  "param": {
    "name": "hc",
    "label": "清洗站",
    "min": 1,
    "max": 3,
    "step": 1,
    "value": 1
  },
  "explore": [
    "滤网脏了会怎样？",
    "空调滤网怎样拆洗？",
    "油烟机怎样保养？"
  ],
  "views": [
    {
      "when": 1,
      "title": "为什么",
      "subtitle": "脏堵的账",
      "color": "amber",
      "emoji": "📉",
      "blocks": [
        {
          "kind": "info",
          "icon": "💸",
          "title": "电费的账",
          "text": "滤网糊死→风过不去→空调拼命工作也吹不凉——实测脏堵能让耗电多两三成：清洗一次滤网=电表喘口气：最便宜的家庭节能"
        },
        {
          "kind": "info",
          "icon": "😷",
          "title": "健康的账",
          "text": "滤网上的灰尘里混着螨虫排泄物和霉菌孢子——一开机全吹进房间：过敏·鼻炎·咳嗽的隐形源头。家有老人小孩更该勤洗：干净的风才敢深呼吸"
        },
        {
          "kind": "info",
          "icon": "🔥",
          "title": "安全的账",
          "text": "油烟机油垢积厚——明火一蹿就可能引燃（厨房火灾常见原因）：定期清洗不是洁癖·是安全底线"
        },
        {
          "kind": "highlight",
          "text": "电费+健康+安全——三笔账都指向同一件事：定期清洗"
        }
      ]
    },
    {
      "when": 2,
      "title": "空调",
      "subtitle": "滤网五步",
      "color": "blue",
      "emoji": "❄️",
      "blocks": [
        {
          "kind": "steps",
          "title": "洗滤网五步",
          "items": [
            "断电：拔插头或关空开——动手先断电是铁律",
            "开盖取出滤网：双手轻压面板两侧卡扣·往外拉（每家机型不同·先看说明或请家长演示）",
            "冲洗：用软刷+流水轻刷灰尘（太顽固可用中性洗涤剂）——不能刷狠了（网很软）",
            "晾干：阴凉处自然晾干·不能晒不能烤（会变形）",
            "装回：确认完全干燥·按原路装回扣好面板——开机试运行"
          ]
        },
        {
          "kind": "info",
          "icon": "📅",
          "title": "频率",
          "text": "一般家庭：滤网 2-4 周洗一次（用得勤的更频繁）；换季开机前必洗。深层的蒸发器清洗要专业药剂和工具——请师傅做：自己洗滤网·师傅洗深度·分工合理"
        },
        {
          "kind": "highlight",
          "text": "断电→取网→轻刷→阴干→装回——滤网五步"
        }
      ]
    },
    {
      "when": 3,
      "title": "油烟机",
      "subtitle": "日常保养",
      "color": "green",
      "emoji": "🍳",
      "blocks": [
        {
          "kind": "steps",
          "title": "三件日常",
          "items": [
            "趁热擦：每次做完菜·趁着余温用厨房纸擦内壁和油网——油没凝住时最好擦（一分钟的事）",
            "油杯勤倒：油杯七分满就倒——满了会溢到机器里：倒进瓶子丢厨余·别倒下水道",
            "滤网月洗：油网拆下泡热水+洗洁精（或小苏打）——刷净晾干装回"
          ]
        },
        {
          "kind": "info",
          "icon": "⚠️",
          "title": "两条红线",
          "text": "①不拆电机和风轮自己洗（内部带电·部件精密——深度清洗请专业人员）；②不用钢丝球猛刮涂层（涂层刮花更积油）：日常做表面·深度交给师傅"
        },
        {
          "kind": "info",
          "icon": "🧾",
          "title": "请师傅的时机",
          "text": "噪音变大·吸力明显减弱·滴油——该深度清洗了（一般1-2年一次）：一次几百元·换来安全省电——这笔钱不能省"
        },
        {
          "kind": "highlight",
          "text": "趁热擦·勤倒油·月洗网——日常三件+深度请师傅"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "为什么洗",
        "body": "【电】脏堵耗电多两三成。\n【健康】螨虫霉菌随风吹。\n【安全】油垢是厨房火源。"
      },
      {
        "title": "空调滤网",
        "body": "【五步】断电→取网→轻刷→阴干→装回。\n【频率】2-4周一次·换季必洗。\n【分工】自己洗滤网·深度请师傅。"
      },
      {
        "title": "油烟机",
        "body": "【日常】趁热擦内壁·油杯七分倒·滤网月泡洗。\n【红线】不拆电机·不用钢丝球。\n【信号】噪音大吸力弱→深度洗。"
      }
    ],
    "examples": [
      {
        "q": "空调吹出来有霉味",
        "steps": [
          "断电取出滤网看",
          "大概率长霉积尘",
          "清洗晾干装回",
          "仍有味请师傅洗蒸发器"
        ],
        "tip": "风的问题先查网"
      },
      {
        "q": "油烟机滴油了",
        "steps": [
          "先关机断电",
          "倒掉油杯积油",
          "擦净油网周围",
          "吸力仍弱约深度清洗"
        ],
        "tip": "别拖到着火"
      }
    ],
    "mistakes": [
      "滤网没干就装回开机（湿网吹进电机易出故障）",
      "钢丝球猛刮油烟机油网涂层（刮花更积油）"
    ]
  },
