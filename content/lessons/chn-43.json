        {
          "kind": "info",
          "icon": "📏",
          "title": "什么是微写作",
          "text": "150-300字的小型写作任务——写一个场景·一个观点·一件应用文（通知·倡议·邀请词）：麻雀虽小·五脏俱全：立意·结构·语言一样不能少"
        },
        {
          "kind": "info",
          "icon": "⚖️",
          "title": "难在哪",
          "text": "字数少=容错低——大作文写废一段还有篇幅救·微写作每一句都要「干活」：考的是精确：能把300字写到句句有用·写3000字就不会注水"
        },
        {
          "kind": "highlight",
          "text": "微写作=高密度表达——每句话都要领工资"
        }
      ]
    },
    {
      "when": 2,
      "title": "三类",
      "subtitle": "各有一套",
      "color": "green",
      "emoji": "🗂️",
      "blocks": [
        {
          "kind": "compare",
          "title": "三类写法",
          "items": [
            {
              "label": "描写类",
              "value": "写场景/画面——选点聚焦（不贪多·写一个角落）+感官细节（视听说触嗅）+一个特写收尾：如「清晨的粥铺」：蒸气·吆喝·勺碰碗"
            },
            {
              "label": "议论类",
              "value": "亮观点+两论据+小结——观点句直接开头（不必铺垫）·每论据两三句·结尾回扣：像小型议论文的压缩饼干"
            },
            {
              "label": "应用类",
              "value": "通知·倡议·邀请词——格式（称呼正文落款）占一半分数+对象意识（对谁说什么）+措辞得体（呼应用上一课）：格式错·文采再好也白搭"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🎬",
          "title": "通用心法",
          "text": "开头直入（微写作没篇幅「起承」）·中间具体（细节和例子是血肉）·结尾点睛（一句话收束升华）：三段式极简版——不绕弯·不注水·有回味"
        },
        {
          "kind": "highlight",
          "text": "描写靠细节·议论靠结构·应用靠格式——直入·具体·点睛"
        }
      ]
    },
    {
      "when": 3,
      "title": "练法",
      "subtitle": "三个日常",
      "color": "violet",
      "emoji": "🏋️",
      "blocks": [
        {
          "kind": "steps",
          "title": "三个训练法",
          "items": [
            "缩写：把一篇千字文压成300字——保留主干砍掉枝叶：练「判断什么重要」的眼力",
            "扩写：给一句话（「他走进教室」）扩成一段场景——练细节想象力：一缩一扩·收放自如",
            "对比修改：同题写两版·隔天自己找差距改一版——修改比多写更能进步：好文章是改出来的"
          ]
        },
        {
          "kind": "info",
          "icon": "🗂️",
          "title": "素材卡片",
          "text": "日常积累三行卡：一行场景（地铁里打盹的工人）·一行观点（金句式）·一行数据事例：微写作时直接调用——考场上的从容来自平时的卡片盒"
        },
        {
          "kind": "info",
          "icon": "⏱️",
          "title": "考场策略",
          "text": "建议10-12分钟：2分钟审题定类型（描写/议论/应用？）·7分钟写·3分钟改：宁可短而精·不要长而水——微写作超字数也会扣分"
        },
        {
          "kind": "highlight",
          "text": "一缩一扩一修改+素材卡片——微写作的日常功"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "认识微写作",
        "body": "【定义】150-300字小任务。\n【特点】容错低·句句干活。\n【价值】练好它大作文是加长版。"
      },
      {
        "title": "三类写法",
        "body": "【描写】选点+感官+特写。\n【议论】观点+两据+小结。\n【应用】格式+对象+得体。\n【心法】直入·具体·点睛。"
      },
      {
        "title": "日常练法",
        "body": "【缩写】千字压300练眼力。\n【扩写】一句扩一段练细节。\n【修改】同题两版找差距。\n【卡片】场景观点数据三行卡。"
      }
    ],
    "examples": [
      {
        "q": "写「课间十分钟」的场景",
        "steps": [
          "选点：只写走廊一角",
          "感官：声音气味动作",
          "一个特写收尾",
          "控制在300字内"
        ],
        "tip": "不贪多"
      },
      {
        "q": "写「读书有益」议论微写作",
        "steps": [
          "首句直接亮观点",
          "两个论据各三句",
          "结尾一句回扣",
          "数一数字数删水词"
        ],
        "tip": "压缩饼干"
      }
    ],
    "mistakes": [
      "开头铺垫太长绕不到正题（微写作要直入）",
      "应用类忘写格式要素（称呼落款占一半分）"
    ]
  },
