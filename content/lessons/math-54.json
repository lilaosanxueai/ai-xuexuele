  "teach": {
    "sections": [
      {
        "title": "圆柱的认识",
        "body": "【圆柱有两个完全相同的圆形底面，侧面展开是长方形】\n侧面展开的长 = 底面周长 2πr，宽 = 高 h。\n圆柱有无数条高，都等于两底面之间的距离。"
      },
      {
        "title": "圆柱的体积",
        "body": "【V = Sh = πr²h（底面积 × 高）】\n推导：把圆柱切成许多扇形拼成长方体（与圆面积同理）。\n半径 2 倍 → 体积 4 倍（r 平方）；高 2 倍 → 体积 2 倍（正比）。"
      },
      {
        "title": "圆锥：三分之一",
        "body": "【等底等高时，圆锥体积 = 圆柱体积 × 1/3：V锥 = πr²h ÷ 3】\n实验：圆柱装满水倒入等底等高的圆锥，正好倒满 3 次。\n别忘了 ÷3——这是圆锥计算最常丢的分！"
      }
    ],
    "examples": [
      {
        "q": "圆柱底面半径 3、高 5，体积是多少？（π 取 3.14）",
        "steps": [
          "底面积 = πr² = 3.14×9 = 28.26",
          "V = 28.26 × 5",
          "= 141.3"
        ],
        "tip": "先算底面积再乘高，两步走不易错"
      },
      {
        "q": "等底等高的圆锥底面半径 3、高 5，体积是多少？",
        "steps": [
          "同底等高圆柱体积 = 141.3（上题）",
          "圆锥 = 141.3 ÷ 3",
          "= 47.1"
        ],
        "tip": "见到圆锥，条件反射地 ÷3"
      }
    ],
    "mistakes": [
      "圆锥体积忘记除以 3",
      "半径翻倍以为体积翻倍（实际 4 倍，因为 r²）"
    ]
  },
