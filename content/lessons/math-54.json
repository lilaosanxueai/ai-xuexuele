    "code": "# 圆柱圆锥体积探索台\nr = 2   # 底面半径\nh = 5   # 高\n\nhide()\nV = 3.14 * r * r * h\n# 圆柱（正面视角：矩形 + 上下底面椭圆感）\nfill_rect(0, -30 + h * 12, 110, h * 24, \"#93c5fd\")\ncircle(-55, -30 + h * 24, 9, \"#bfdbfe\")\ncircle(55, -30 + h * 24, 9, \"#bfdbfe\")\nfill_rect(-55, -30 + h * 24 + 12, 110, 10, \"#60a5fa\")\nwrite(\"圆柱 r=\" + r + \" h=\" + h, 0, 130, \"#1d4ed8\", 12)\nwrite(\"V = πr²h ≈ \" + V * 0.01 + \" 百\", -95, -55, \"#1d4ed8\", 12)\n# 圆锥（右）\ncx = 150\ni = 0\nwhile i < h:\n    w = 110 - i * 110 / h\n    fill_rect(cx, -30 + i * 24 + 12, w, 22, \"#fdba74\")\n    i = i + 1\ncircle(cx, -30 + h * 24, 55, \"#fed7aa\")\nwrite(\"圆锥（等底等高）\", cx, -55, \"#b45309\", 11)\nwrite(\"V锥 = V柱 ÷ 3 ≈ \" + V / 3 * 0.01 + \" 百\", cx - 30, -75, \"#dc2626\", 12)\nwrite(\"倒三次圆锥水 = 一圆柱\", cx - 10, -95, \"#ea580c\", 11)\nwrite(\"半径翻倍→体积4倍；高翻倍→体积2倍\", -150, 155, \"#1d4ed8\", 11)\n"
