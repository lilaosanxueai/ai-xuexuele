  "teach": {
    "sections": [
      {
        "title": "压力的倒U形曲线",
        "body": "【耶克斯-多德森定律】压力与表现呈倒U形：零压力表现差，中等压力表现最好，高压表现崩。\n所以目标不是\"消灭压力\"，而是把压力调到中等——像调收音机找到清晰频道。"
      },
      {
        "title": "识别超载信号",
        "body": "【身体】失眠·头疼·胃疼·免疫力下降。\n【情绪】易怒·想哭·对喜欢的事提不起劲。\n【行为】拖延·刷手机停不下来。\n出现这些信号=气球气太足，该放气了。"
      },
      {
        "title": "两个放气阀",
        "body": "【54321着地法】激活五感回到当下，急性焦虑快速刹车。\n【渐进肌肉放松】绷紧5秒再松开，身体松了大脑跟着松。\n加上运动、睡眠、倾诉——压力管理三件套人人可用。"
      }
    ],
    "examples": [
      {
        "q": "考前心跳加速脑子发蒙，怎么办？",
        "steps": [
          "识别：这是压力偏高信号",
          "做三轮深呼吸（吸4呼6）",
          "54321着地法拉回注意力",
          "暗示：适度紧张帮我进入状态"
        ],
        "tip": "先放气再上场"
      },
      {
        "q": "放假躺了一周反而更累，为什么？",
        "steps": [
          "零压力=大脑唤起不足",
          "作息紊乱生物钟乱套",
          "缺少完成感的反馈",
          "安排小目标小挑战，回到飞行区"
        ],
        "tip": "休息≠躺平"
      }
    ],
    "mistakes": [
      "认为所有压力都是坏的（中等压力是最佳燃料）",
      "认为放松就是刷手机（刷完更焦虑，不是真放松）"
    ]
  },
