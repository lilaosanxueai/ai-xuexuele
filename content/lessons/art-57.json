          "items": [
            {
              "label": "直线",
              "value": "像站着——硬朗·稳定·有精神：画高楼·画旗杆·画挺直的树干"
            },
            {
              "label": "曲线",
              "value": "像跳舞——柔软·流动·很开心：画云朵·画头发·画小鱼吐的泡泡"
            }
          ]
        },
        {
          "kind": "highlight",
          "text": "五种基本线——所有画的起点"
        }
      ]
    },
    {
      "when": 2,
      "title": "疏密魔法",
      "subtitle": "排线的节奏",
      "color": "amber",
      "emoji": "🎛️",
      "blocks": [
        {
          "kind": "info",
          "icon": "🌓",
          "title": "密=深·疏=浅",
          "text": "同样的区域：线排得密看上去就暗（像影子）·排得疏看上去就亮（像光）：不用涂色，排线就能画出亮暗——黑白照片就是靠这个"
        },
        {
          "kind": "info",
          "icon": "🎵",
          "title": "疏密像音乐节拍",
          "text": "一片密·一片疏·再一片密——画面就有了节奏感（像鼓点：咚-哒-咚）：老画家排线像弹琴，密疏相间才好听"
        },
        {
          "kind": "highlight",
          "text": "密的地方变暗影——排线就是黑白魔法"
        }
      ]
    },
    {
      "when": 3,
      "title": "一笔到底",
      "subtitle": "不许抬笔挑战",
      "color": "green",
      "emoji": "🌀",
      "blocks": [
        {
          "kind": "info",
          "icon": "🎮",
          "title": "游戏规则",
          "text": "从纸的左下角出发·笔不离开纸·不重复路线·一直画到右下角：路可以转弯·可以绕圈·就是不能断：这就是「一笔画」——五角星就能一笔画成"
        },
        {
          "kind": "info",
          "icon": "🗺️",
          "title": "像走迷宫",
          "text": "先想好路线再出发：从哪进·从哪出·中间经过哪：画错了也不懊恼——绕过去的路常常变成新的花纹：意外的线条最有趣"
        },
        {
          "kind": "highlight",
          "text": "不抬笔·不重复——旅行本身就是画"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "线条的种类",
        "body": "【五种】直·曲·折·波浪·螺旋。\n【表情】直线硬朗·曲线柔软。\n【用途】每种线都有自己的脾气。"
      },
      {
        "title": "疏密与节奏",
        "body": "【规律】排线密=暗·疏=亮。\n【节奏】密疏相间如鼓点。\n【例子】黑白照片全是排线。"
      },
      {
        "title": "一笔画",
        "body": "【规则】不抬笔·不重复路线。\n【方法】先想路线再出发。\n【心态】画错绕行变新花纹。"
      }
    ],
    "examples": [
      {
        "q": "画一片树叶的影子",
        "steps": [
          "先画叶子外轮廓",
          "叶脉用波浪线",
          "影子处排密线",
          "亮处留白或排疏线"
        ],
        "tip": "密处是影"
      },
      {
        "q": "一笔画小蜗牛",
        "steps": [
          "从壳中心螺旋出发",
          "一圈圈向外绕大",
          "绕出壳后画身体",
          "最后触角收尾"
        ],
        "tip": "从中心出发"
      }
    ],
    "mistakes": [
      "以为线条越多越乱（疏密有节奏就好看）",
      "一笔画中途抬笔还继续画（那就不是一笔画了，重新挑战）"
    ]
  },
