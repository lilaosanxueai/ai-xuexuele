  "starterCode": "# 冒泡排序观察台\nstage = 1   # 1排序前 2一趟冒泡后\n\nhide()\na = 5\nb = 3\nc = 8\nd = 1\ne = 6\nif stage == 2:\n    # 一趟冒泡：相邻比较，大的往后换\n    if a > b:\n        t = a\n        a = b\n        b = t\n    if b > c:\n        t = b\n        b = c\n        c = t\n    if c > d:\n        t = c\n        c = d\n        d = t\n    if d > e:\n        t = d\n        d = e\n        e = t\nfill_rect(0, 130, 340, 30, \"#1d4ed8\")\nif stage == 1:\n    write(\"排序前：5 3 8 1 6（观察它们）\", 0, 130, \"#fff\", 11)\nif stage == 2:\n    write(\"一趟后：\" + a + \" \" + b + \" \" + c + \" \" + d + \" \" + e + \"（8 到了最后）\", 0, 130, \"#fff\", 10)\nfill_rect(-128, 60, 48, a * 10, \"#f59e0b\")\nwrite(\"\" + a, -128, 20 + a * 5, \"#b45309\", 12)\nfill_rect(-64, 60, 48, b * 10, \"#f59e0b\")\nwrite(\"\" + b, -64, 20 + b * 5, \"#b45309\", 12)\nfill_rect(0, 60, 48, c * 10, \"#f59e0b\")\nwrite(\"\" + c, 0, 20 + c * 5, \"#b45309\", 12)\nfill_rect(64, 60, 48, d * 10, \"#f59e0b\")\nwrite(\"\" + d, 64, 20 + d * 5, \"#b45309\", 12)\nfill_rect(128, 60, 48, e * 10, \"#f59e0b\")\nwrite(\"\" + e, 128, 20 + e * 5, \"#b45309\", 12)\nwrite(\"相邻比较·大的后换·一趟沉底一个\", -20, -70, \"#7c3aed\", 10)\nwrite(\"没有发生交换=已经排好\", -20, -100, \"#64748b\", 10)\n",
