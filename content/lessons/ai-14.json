  "teach": {
    "sections": [
      {
        "title": "if-else",
        "body": "【结构】条件成立走if·否则走else。\n【符号】==判断相等（=是赋值）。\n【缩进】表示归属·必须一致。"
      },
      {
        "title": "多分支 elif",
        "body": "【结构】if-elif-elif-else 从上查到下。\n【特点】命中即停·后面不看。\n【顺序】条件从严到宽排。"
      },
      {
        "title": "嵌套判断",
        "body": "【结构】分支里再开分支。\n【读法】看缩进层数。\n【实战】游戏逻辑（石头剪刀布）。"
      }
    ],
    "examples": [
      {
        "q": "写\"偶数报奇数报偶数\"",
        "steps": [
          "条件：n % 2 == 0",
          "if 偶数：print(\"偶\")",
          "else：print(\"奇\")",
          "注意 == 不是 ="
        ],
        "tip": "单岔口"
      },
      {
        "q": "BMI 等级：偏瘦/正常/超标",
        "steps": [
          "条件从窄到宽",
          "if bmi < 18.5：偏瘦",
          "elif bmi < 24：正常",
          "else：超标——顺序错了就乱"
        ],
        "tip": "elif 顺序"
      }
    ],
    "mistakes": [
      "把 == 写成 =（判断变赋值）",
      "elif 条件顺序写反（宽在前窄在后会全部误判）"
    ]
  },
