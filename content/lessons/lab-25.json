  "teach": {
    "sections": [
      {
        "title": "洗碗流程",
        "body": "【六步】刮→冲→擦→烫→立→收（教材常称七步含\"分类\"）。\n【顺序】先杯碗后盘锅（油少→油多）。\n【沥水】立着沥干比抹布擦干卫生——抹布本身就是细菌旅馆。"
      },
      {
        "title": "去油污的科学",
        "body": "【原理】洗洁精的表面活性剂一端抓油一端抓水·让油被水带走。\n【热水】降低油的黏度·化\"冻油\"为\"活油\"。\n【适量】洗洁精过量冲不净反而残留——两三滴够洗一池碗。"
      },
      {
        "title": "厨房清洁全家总动员",
        "body": "【分工】孩子负责碗筷·大人负责灶台锅具。\n【频率】每日洗碗·每周擦灶台油烟机·每月大扫除。\n【意义】家务是全家人的合作项目——不是\"帮妈妈干活\"，是\"我是家里的一员\"。"
      }
    ],
    "examples": [
      {
        "q": "一池碗：2个杯子·3个碗·2个油盘子·1口炒锅，怎么洗？",
        "steps": [
          "刮净所有残渣",
          "先洗杯子和碗（油少）",
          "再洗盘子和锅（油多）",
          "热水冲净·立着沥好"
        ],
        "tip": "油少到油多"
      },
      {
        "q": "盘子上的油已经过夜凝住了怎么办？",
        "steps": [
          "用热水冲一分钟化油",
          "或先泡热水再洗",
          "洗洁精重点擦油面",
          "记住：下次饭后立刻洗"
        ],
        "tip": "拖延让活变难"
      }
    ],
    "mistakes": [
      "认为洗碗要用很多洗洁精（过量残留反而洗不净）",
      "认为抹布擦干更干净（潮湿抹布细菌更多，沥水更卫生）"
    ]
  },
