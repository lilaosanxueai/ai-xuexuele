  "teach": {
    "sections": [
      {
        "title": "分式的概念",
        "body": "【形如 A/B（B 中含字母且 B≠0）的式子叫分式】\n有意义条件：分母不为 0。x/(x−2) 中 x≠2。\n分式与分数的区别：分母含字母。"
      },
      {
        "title": "基本性质与约分",
        "body": "【分子分母同乘（或同除）一个不为 0 的整式，分式值不变】\n约分：找分子分母的公因式约掉。6x²y/9xy² = 2x/3y（同除 3xy）。\n结果要化成最简（分子分母没有公因式）。"
      },
      {
        "title": "分式乘除",
        "body": "【乘法：分子乘分子、分母乘分母；除法：除式颠倒后相乘】\nb/c ÷ d/e = b/c × e/d。\n先约分再相乘，运算更简洁（与分数完全一致）。"
      }
    ],
    "examples": [
      {
        "q": "约分：12a³b² / 18a²b³",
        "steps": [
          "找公因式：6a²b²",
          "分子 ÷6a²b² = 2a",
          "分母 ÷6a²b² = 3b",
          "结果 = 2a/3b"
        ],
        "tip": "系数取最大公约数、字母取最低次幂"
      },
      {
        "q": "计算：x/3 ÷ (2x²/9)",
        "steps": [
          "除变乘：x/3 × 9/(2x²)",
          "约分：9 与 3 约 3、x 与 x² 约 x",
          "= 3/(2x)"
        ],
        "tip": "除法第一步永远是\"颠倒相乘\""
      }
    ],
    "mistakes": [
      "忘记检验分母不为 0 的条件",
      "约分时把加式约掉：(x+2)/(2x+4) 中的 x+2 与 2(x+2) 公因式是 (x+2)，但 x/(x+2) 不能约成 1/2——只有乘积形式才能约"
    ]
  },
