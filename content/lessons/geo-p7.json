  "id": "geo-p7",
  "order": 927,
  "title": "火山与地震：地球的脾气",
  "emoji": "🌋",
  "textbook": "科学·地理（小学拓展）",
  "curriculum": {
    "module": "地球运动",
    "points": [
      "板块运动",
      "火山喷发",
      "地震避险"
    ]
  },
  "story": "地球看起来安安静静——其实它的「外壳」是几大块拼图·一直在慢慢移动。挤一挤会地震·裂一裂冒岩浆。这一课认识地球的脾气·更重要的是学会保护自己。",
  "goals": [
    "了解板块运动",
    "认识火山喷发",
    "掌握地震避险方法"
  ],
  "aiIntro": "🌋 地球也会发脾气——火山与地震",
  "param": {
    "name": "vd",
    "label": "地动站",
    "min": 1,
    "max": 3,
    "step": 1,
    "value": 1
  },
  "explore": [
    "地球的外壳在动吗？",
    "火山喷出来的是什么？",
    "地震时第一步做什么？"
  ],
  "views": [
    {
      "when": 1,
      "title": "板块",
      "subtitle": "拼图地球",
      "color": "blue",
      "emoji": "🧩",
      "blocks": [
        {
          "kind": "info",
          "icon": "🌍",
          "title": "地球的壳是拼图",
          "text": "地球最外层的地壳不是一整块——是六大板块+一些小块拼起来的·漂浮在下面慢慢流动的软流层上：像水面上的浮冰"
        },
        {
          "kind": "info",
          "icon": "🐢",
          "title": "有多慢",
          "text": "板块每年只移动几厘米——和你指甲生长的速度差不多！但坚持几百万年：喜马拉雅山就是这样从海底挤出来的——慢不可怕·坚持可怕"
        },
        {
          "kind": "info",
          "icon": "💥",
          "title": "挤碰的结果",
          "text": "板块互相挤压·错动——岩石受力到极限突然断裂=地震；岩石被压出裂缝·岩浆喷出来=火山：地震火山都爱在板块边缝上发生（日本·印尼就在缝上）"
        },
        {
          "kind": "highlight",
          "text": "地壳=漂浮的拼图·挤碰就地震·开裂就火山——地球是活的"
        }
      ]
    },
    {
      "when": 2,
      "title": "火山",
      "subtitle": "地球的烟囱",
      "color": "red",
      "emoji": "🌋",
      "blocks": [
        {
          "kind": "info",
          "icon": "🔥",
          "title": "火山长什么样",
          "text": "地下的岩浆房（储藏）→火山通道（管道）→火山口（出口）——岩浆压力大就喷出来：喷到空中叫火山灰·流出来叫熔岩流：冷却后变成火山岩"
        },
        {
          "kind": "compare",
          "title": "火山的脾气",
          "items": [
            {
              "label": "活火山",
              "value": "正在喷或经常喷——夏威夷的基拉韦厄几乎天天流岩浆"
            },
            {
              "label": "休眠火山",
              "value": "暂时睡觉但可能醒——日本的富士山最后一次喷发是1707年"
            },
            {
              "label": "死火山",
              "value": "人类历史上再没喷过——中国的大同火山群"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🌱",
          "title": "火山也有好处",
          "text": "火山灰是天然肥料（火山周边土壤特别肥）·地热温泉（日本泡汤文化）·许多海岛就是火山造的（夏威夷群岛）——毁灭与创造是同一件事"
        },
        {
          "kind": "highlight",
          "text": "火山不全是坏蛋——肥土·温泉·海岛都是它送的礼物"
        }
      ]
    },
    {
      "when": 3,
      "title": "避险",
      "subtitle": "保命三步",
      "color": "amber",
      "emoji": "🛡️",
      "blocks": [
        {
          "kind": "steps",
          "title": "地震来了：伏地·遮挡·手抓牢",
          "items": [
            "伏地：马上蹲下——别站着·更别跑（摔倒被踩更危险）",
            "遮挡：钻到结实的桌子下护住头颈——桌子挡住坠落物",
            "手抓牢：抓紧桌腿跟着桌子走——晃动停止前别出来"
          ]
        },
        {
          "kind": "info",
          "icon": "🚫",
          "title": "绝对不要做",
          "text": "不跳楼·不坐电梯·不站在窗边阳台·不返回室内拿东西——东西没了可以再买·命只有一次。晃动停止后走楼梯到空旷地带"
        },
        {
          "kind": "info",
          "icon": "🎒",
          "title": "平时的准备",
          "text": "记熟家里最结实的桌子位置·床边放一双鞋（防碎玻璃扎脚）·和家人约定集合点——汶川地震的教训：平时多一分准备·震时多十分安全"
        },
        {
          "kind": "highlight",
          "text": "伏地·遮挡·手抓牢——九个字关键时刻能救命"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "板块运动",
        "body": "【地壳】六大板块拼图·浮在软流层。\n【速度】每年几厘米=指甲生长。\n【结果】挤碰地震·开裂火山。"
      },
      {
        "title": "火山",
        "body": "【结构】岩浆房-通道-火山口。\n【三类】活·休眠·死。\n【好处】肥土·温泉·造岛。"
      },
      {
        "title": "地震避险",
        "body": "【三步】伏地·遮挡·手抓牢。\n【禁止】跳楼·电梯·窗边·返回拿物。\n【平时】记桌子·备鞋·约集合点。"
      }
    ],
    "examples": [
