  ],
  "views": [
    {
      "when": 1,
      "title": "发现需求",
      "subtitle": "别人愿意为什么掏钱",
      "color": "green",
      "emoji": "👀",
      "blocks": [
        {
          "kind": "info",
          "icon": "👀",
          "title": "观察身边的\"不便利\"",
          "text": "放学时同学们饿→有人卖面包·天热口渴→有人卖冰水：好生意始于发现别人的\"不方便\"——你抱怨过什么\"要是有……就好了\"？"
        },
        {
          "kind": "info",
          "icon": "❓",
          "title": "验证方法",
          "text": "先问10个人\"你会花X元买Y吗？\"——如果10个里9个说\"会\"→继续；只有2个说\"会\"→换方向：用嘴验证比花钱试错便宜一万倍"
        },
        {
          "kind": "highlight",
          "text": "好的创业不是\"我想卖什么\"——是\"别人需要什么\""
        }
      ]
    },
    {
      "when": 2,
      "title": "成本收入利润",
      "subtitle": "小老板的账本",
      "color": "amber",
      "emoji": "🧾",
      "blocks": [
        {
          "kind": "compare",
          "title": "三个核心数字",
          "items": [
            {
              "label": "收入",
              "value": "卖了多少钱：30杯×5元=150元"
            },
            {
              "label": "成本",
              "value": "进货+摊位+冰块+时间=2元×30+20+5+自己2小时=90元"
            },
            {
              "label": "利润",
              "value": "收入-成本=150-90=60元——不是90！忘了算隐形成本"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "⏰",
          "title": "时间也是成本",
          "text": "你排队进货的2小时如果用来做家教赚80元——你的时间成本=80元：机会成本不只算钱，还算时间"
        },
        {
          "kind": "highlight",
          "text": "收入-成本=利润：成本永远比你以为的多"
        }
      ]
    },
    {
      "when": 3,
      "title": "小规模试错",
      "subtitle": "先小再大",
      "color": "sky",
      "emoji": "🧪",
      "blocks": [
        {
          "kind": "steps",
          "title": "精益创业法",
          "items": [
            "第一周：只做5份·看有没有人买",
            "有人买→问问他们喜欢什么·不满意什么",
            "第二周：改进后再做10份",
            "持续有人买→逐步放大；没人买→换方向（损失只有5份的成本）"
          ]
        },
        {
          "kind": "info",
          "icon": "🔄",
          "title": "失败=学费",
          "text": "第一次创业失败是大概率事件（90%创业公司前三年关门）——但每次失败都教给你\"什么行不通\"：爱迪生说我没有失败，只是找到了一千种行不通的方法"
        },
        {
          "kind": "info",
          "icon": "🌱",
          "title": "你现在的创业资本",
          "text": "时间·学习能力·不怕丢脸的勇气·零家庭负担——这些是成年人最羡慕的\"创业资本\"：从小练比长大再学便宜得多"
        },
        {
          "kind": "highlight",
          "text": "先小再大·先验证再投入·失败了就调头"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "需求发现",
        "body": "【痛点=商机】别人的\"不方便\"\"没有\"\"太贵了\"都是潜在需求。\n【验证】问·看·小规模试卖——嘴上验证<花钱验证<市场验证。"
      },
      {
        "title": "会计基础",
        "body": "【收入】单价×数量；【成本】原材料（变动）+摊位费（固定）+时间（机会成本）。\n【利润】收入-全部成本（包括隐形的）。\n【盈亏平衡】卖多少杯才不亏？=固定成本÷（单价-单位变动成本）。"
      },
      {
        "title": "创业心态",
        "body": "【小步快跑】用最小成本测试想法——错了就调头。\n【失败正常】第一次成功是例外不是常态——但每次都积累了别人买不到的经验。\n【从小开始】摆摊·义卖·帮同学代购——创业思维从任何小事都能练。"
      }
    ],
    "examples": [
      {
        "q": "义卖会卖什么好？",
        "steps": [
          "观察：同学们下课后最缺什么？",
          "验证：问10个人\"你愿意花3元买杯冰柠檬水吗？\"",
          "小规模：先做10杯看反应",
          "卖完→明天做20杯·没卖完→问为什么"
        ],
        "tip": "先问再做"
      },
      {
        "q": "30杯赚了60元值得吗？",
        "steps": [
          "算全部成本：钱+时间+精力",
          "时间成本：2小时可以做什么？",
          "如果赚到的经验>成本→值得",
          "如果纯粹累→下次换更高效的方式"
        ],
        "tip": "经验也是回报"
      }
    ],
    "mistakes": [
      "认为创业=有天才点子（好点子不值钱，验证和执行才值钱）",
      "认为收入=利润（利润要减去全部成本包括时间）"
    ]
  },
  "exercises": [
