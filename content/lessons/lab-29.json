  "teach": {
    "sections": [
      {
        "title": "早餐营养",
        "body": "【公式】主食（供能）+蛋白质（耐饿）+果蔬（维生素）。\n【假早餐】只喝含糖饮料·只吃饼干·空腹。\n【重要性】影响上午注意力与情绪——学生党的第一生产力。"
      },
      {
        "title": "免火早餐技能",
        "body": "【燕麦杯】即食燕麦+热奶焖+水果 toppings。\n【三明治】面包+蛋+蔬+奶酪组合变化。\n【早餐杯】酸奶+水果+坚果分层。\n共同点：组装式烹饪——安全·快·可自创。"
      },
      {
        "title": "厨房安全与收尾",
        "body": "【分工】热源与刀由家长操作·孩子组装。\n【卫生】洗手·生熟分开·食材冷藏。\n【收尾】清洁台面·处理垃圾——完整劳动流程。\n【礼仪】分享成果·询问过敏原。"
      }
    ],
    "examples": [
      {
        "q": "只剩10分钟上学，怎么凑齐早餐公式？",
        "steps": [
          "主食：全麦面包2片",
          "蛋白：牛奶一盒",
          "果蔬：小香蕉一根",
          "边走边吃不赶：提前10分钟起床"
        ],
        "tip": "极简1+1+1"
      },
      {
        "q": "给全家做早餐怎样显出小厨师水平？",
        "steps": [
          "提前一晚准备食材清单",
          "摆盘用彩色搭配·对角切开",
          "给每道菜起名字",
          "饭后主动收拾——完整才是专业"
        ],
        "tip": "仪式感+收尾"
      }
    ],
    "mistakes": [
