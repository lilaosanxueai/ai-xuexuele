    {
      "when": 2,
      "title": "一纸成书",
      "subtitle": "8页小书",
      "color": "green",
      "emoji": "📄",
      "blocks": [
        {
          "kind": "steps",
          "title": "一张A4折出8页书",
          "items": [
            "对折三次前先想好：横折两次竖折一次=8个页面",
            "完全展开后找到中间横向的折缝——用剪刀沿中间剪开一格（只剪中间那一小段）",
            "再整体对折：剪开处向中间一推——纸自动变成十字形",
            "把十字收拢压平——一本8页小书出现：开始写和画吧"
          ]
        },
        {
          "kind": "info",
          "icon": "📎",
          "title": "装订方式",
          "text": "厚一点的书：骑马钉（订书机对折处钉两针——最简单牢固）·线装（针线缝书脊——古书的做法·很有味道）·胶装（书本用·家里白乳胶也能做）：8页小书甚至不用装订——折好就是书"
        },
        {
          "kind": "highlight",
          "text": "一张纸·三次折·一刀剪=一本8页的书——最便宜的出版社"
        }
      ]
    },
    {
      "when": 3,
      "title": "版式",
      "subtitle": "好读的秘密",
      "color": "violet",
      "emoji": "🎨",
      "blocks": [
        {
          "kind": "compare",
          "title": "版式三原则",
          "items": [
            {
              "label": "字大行疏",
              "value": "字别太小·行距别太挤：读者舒展=读得下去。留白不是浪费——是呼吸"
            },
            {
              "label": "图文各半",
              "value": "一页字一页画交替——节奏感就出来了：全字像课本·全画像画册"
            },
            {
              "label": "统一风格",
              "value": "全部页用同一套颜色（最多3色）和字体——统一=专业：封面内页呼应"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "✨",
          "title": "封面设计公式",
          "text": "大字书名（占封面三分之一）+小字作者+一幅主图（和内容相关的画面）+一点点留白——公式虽然简单·80%的好封面都这么来"
        },
        {
          "kind": "highlight",
          "text": "版式的好=读起来舒服——留白是呼吸·统一是专业"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "书的结构",
        "body": "【封面】书名作者主图。【书脊】书架露脸位。\n【环衬】开场幕布。【内页】图文主体。"
      },
      {
        "title": "一纸成书",
        "body": "【折法】横二竖一折出8页。\n【一刀】中间剪一格推开成十字。\n【装订】骑马钉最简单·线装最有味。"
      },
      {
        "title": "版式设计",
        "body": "【原则】字大行疏·图文各半·统一风格。\n【封面】大书名+作者+主图+留白。"
      }
    ],
    "examples": [
      {
        "q": "做一本「我的暑假」小书",
        "steps": [
          "A4折出8页小书",
          "第1页设计封面：书名+名字+一幅画",
          "中间5页图文交替讲故事",
          "最后一页写结尾和日期"
        ],
        "tip": "先搭骨架再填内容"
      },
      {
        "q": "内页排版总是很挤",
        "steps": [
          "字写大一点行距拉开",
          "删掉一半文字",
          "每页配一幅小画",
          "统一两三种颜色"
        ],
        "tip": "留白呼吸"
      }
    ],
    "mistakes": [
      "一上来就画封面（先搭结构再设计门面）",
      "每页换一种风格（统一才显专业）"
    ]
  },
