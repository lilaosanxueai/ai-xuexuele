    {
      "when": 2,
      "title": "三部曲",
      "subtitle": "随身灭火器",
      "color": "blue",
      "emoji": "🧯",
      "blocks": [
        {
          "kind": "steps",
          "title": "停-呼吸-数",
          "items": [
            "第一步 停：像被\"定格\"——嘴巴闭紧·手脚不动（爆发只在一秒·停住一秒就赢一半）",
            "第二步 呼吸：慢慢吸气 4 拍·呼气 6 拍·做三轮——长呼气是身体自带的镇静按钮",
            "第三步 数/离开：心里从 10 倒数·或者直接走开喝口水——给岩浆降温的时间"
          ]
        },
        {
          "kind": "info",
          "icon": "🏃",
          "title": "离开不等于认输",
          "text": "先撤出\"火场\"再处理问题——战士也会先找掩体：等你冷静了再回来谈·你的话才有分量：冷静的人说的话·比吼出来的响十倍"
        },
        {
          "kind": "highlight",
          "text": "停-呼吸-数：三个动作救下你的一天"
        }
      ]
    },
    {
      "when": 3,
      "title": "表达",
      "subtitle": "用\"我\"说话",
      "color": "green",
      "emoji": "💬",
      "blocks": [
        {
          "kind": "steps",
          "title": "我-感受-希望",
          "items": [
            "说事实不说评价：\"你推倒了我的积木\"（不说\"你是坏蛋\"）",
            "说感受不说指责：\"我很生气·也很伤心\"（不说\"你气死我了\"）",
            "说希望不说命令：\"我希望你帮我重新搭\"（不说\"你必须赔\"）",
            "公式：当（事实）·我感到（感受）·我希望（希望）——三段式小大人表达法"
          ]
        },
        {
          "kind": "info",
          "icon": "🤝",
          "title": "如果对方不听",
          "text": "你已经好好说了·对方还闹——找老师或爸妈不是打小报告·是请裁判：会求助的孩子最聪明——硬碰硬不是勇敢"
        },
        {
          "kind": "highlight",
          "text": "说出来的是感受·吼出来的是事故"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "愤怒的信号",
        "body": "【脸】红·瞪·咬牙。\n【身体】拳紧·心跳快·呼吸粗。\n【心理】想喊想摔·必须爆发感。\n【时机】冒烟期灭火最有效。"
      },
      {
        "title": "灭火三部曲",
        "body": "【停】定格一秒（嘴巴闭手脚不动）。\n【呼吸】吸4呼6三轮（镇静按钮）。\n【数/离开】倒数10或离场喝水。\n【撤=战术】冷静后再回来谈。"
      },
      {
        "title": "我信息表达",
        "body": "【三段】事实+感受+希望。\n【公式】当…我感到…我希望…。\n【不】评价·指责·命令。\n【求助】对方不讲理找裁判。"
      }
    ],
    "examples": [
      {
        "q": "同学故意撞翻你的水杯怎么办？",
        "steps": [
          "信号：脸红拳紧",
          "三部曲：停-呼吸-数10",
          "表达：当水杯被撞翻·我很生气·我希望你帮我擦干净",
          "不听就找老师裁判"
        ],
        "tip": "先灭再谈"
      },
      {
        "q": "弟弟抢了你的玩具·你快炸了",
        "steps": [
          "察觉：想吼的冲动",
          "离开现场深呼吸",
          "回来说三段式",
          "或找妈妈当裁判"
        ],
        "tip": "撤不是输"
      }
    ],
    "mistakes": [
      "认为生气就该憋着（要表达·用三段式好好说）",
      "把离开当认输（是给冷静让路）"
    ]
  },
