  "teach": {
    "sections": [
      {
        "title": "分类三问法",
        "body": "【一问：还要用吗？——不用处理掉（扔/送/捐）】\n【二问：多久用一次？——天天用放手边，偶尔用进抽屉】\n【三问：在哪里用？——在哪用就放在哪（文具在书桌，玩具在玩具箱）】\n三问答完，每件物品都有了去处。"
      },
      {
        "title": "定位原则",
        "body": "【黄金区：最常用的东西放在最顺手、不用弯腰踮脚的位置】\n同类集中：所有笔一个笔筒，所有书一层书架。\n直立收纳：书竖放、文件立放——一眼看到全貌，抽取不倒一片。"
      },
      {
        "title": "书包分区",
        "body": "【大格：课本按课程表顺序竖放】【中格：作业本、文具盒】\n【前袋：红领巾、水卡等小件】【侧袋：水杯、雨伞】\n每晚按明天课表整理书包=早上的从容。"
      }
    ],
    "examples": [
      {
        "q": "书桌抽屉塞满了东西，第一步做什么？",
        "steps": [
          "全部拿出来摊开",
          "用三问法分类",
          "处理不用的，剩下的定位",
          "不是一股脑塞回去"
        ],
        "tip": "不清空就整理=假整理"
      },
      {
        "q": "每天用的字典该放在哪？",
        "steps": [
          "判断频率：每天用",
          "黄金区原则：最顺手的位置",
          "书桌触手可及处或书架最上层格",
          "答案：手边黄金区"
        ],
        "tip": "频率决定位置"
      }
    ],
    "mistakes": [
      "整理完没有归位习惯（三天打回原形）",
      "把\"藏起来\"当\"整理\"（看不见≠整理好）"
    ]
  },
