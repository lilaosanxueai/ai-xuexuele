  "starterCode": "# 机械效率探索台\nG = 60    # 物重（N）\nGd = 10   # 动滑轮重（N）\n\nhide()\n# 滑轮组（1 动 1 定，n=2 段绳）\ncircle(0, 100, 22, \"#94a3b8\")\nring(0, 100, 22, \"#64748b\")\ncircle(0, 20, 22, \"#78716c\")\nring(0, 20, 22, \"#57534e\")\npen_color(\"#dc2626\")\npen_down()\ngo_to(-70, 120)\ngo_to(-70, 20)\ngo_to(70, 20)\ngo_to(70, 120)\npen_up()\n# 重物\nfill_rect(0, -30, 70, 50, \"#f59e0b\")\nwrite(G + \"N\", 0, -30, \"#ffffff\", 12)\nF = (G + Gd) / 2\neta = G / (G + Gd) * 100\nwrite(\"拉力 F=(G+G动)/2=\" + F + \"N\", -170, 140, \"#1d4ed8\", 12)\nwrite(\"η = W有/W总 = G/(G+G动) = \" + eta + \"%\", -170, 115, \"#dc2626\", 13)\nwrite(\"额外功：提动滑轮+摩擦（不可避免）\", -180, 90, \"#ea580c\", 11)\nif Gd * 3 > G:\n    write(\"滑轮太重：大量功花在提滑轮上！\", -110, -80, \"#dc2626\", 11)\nif G > Gd * 5:\n    write(\"货物越重，额外功占比越小，η 越高\", -130, -80, \"#16a34a\", 11)\nwrite(\"η 永远 < 100%（摩擦无法消除）\", -150, -110, \"#64748b\", 11)\n",
