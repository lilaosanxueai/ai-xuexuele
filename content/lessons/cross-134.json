  "teach": {
    "sections": [
      {
        "title": "三本账",
        "body": "【有用功 W有：达到目的必须做的功（提升重物 G·h）】【额外功 W额：不得不做的功（提动滑轮、克服摩擦）】【总功 W总 = W有 + W额】\n使用任何机械都不省功（功的原理）。"
      },
      {
        "title": "机械效率",
        "body": "【η = W有 / W总 × 100%，永远小于 1】\nη 越大说明额外功占比越小、机械越好。\n滑轮组：η = G/(G+G动)（忽略绳重摩擦时）。"
      },
      {
        "title": "提高效率",
        "body": "【①减小动滑轮重 ②减小摩擦 ③增大提升的物重】\n同样的滑轮组吊越重的货，效率越高（额外功占比被\"摊薄\"）。\n定期润滑、用轻质材料都是工程手段。"
      }
    ],
    "examples": [
      {
        "q": "用滑轮组把 200N 的货物提升 2m，拉力 125N、绳端移动 4m。求机械效率。",
        "steps": [
          "有用功 W有 = 200 × 2 = 400J",
          "总功 W总 = 125 × 4 = 500J",
          "η = 400/500 = 80%"
        ],
        "tip": "区分两个距离：货物升 2m、绳端拉 4m"
      },
      {
        "q": "同一滑轮组分别吊 50N 和 200N 的货物，哪次效率高？",
        "steps": [
          "额外功（提滑轮）基本不变",
          "吊 200N 时有用功占比更大",
          "200N 时效率更高"
        ],
        "tip": "货越重，固定开销占比越小"
      }
    ],
    "mistakes": [
      "机械效率算成大于 100%（额外功被漏掉）",
      "认为省力机械效率就高（省力和效率是两回事）"
    ]
  },
