  "teach": {
    "sections": [
      {
        "title": "两种传棒",
        "body": "【上挑】掌心向后·从下往上送·易学。\n【下压】掌心向上·从上往下压·快不换手。\n【法则】同速中完成交接。"
      },
      {
        "title": "配合练习",
        "body": "【三级】原地口令→慢跑→加速预跑。\n【掉棒】本人捡·不抛不抄近道。\n【棒次】一枪二弯三直四冲。"
      },
      {
        "title": "接力精神",
        "body": "【重定义】配合让整体大于部分。\n【信任】伸手信队友·传棒为下人。\n【最燃】速度+四个人的故事。"
      }
    ],
    "examples": [
      {
        "q": "班级接力赛总掉棒",
        "steps": [
          "回到原地传接练口令",
