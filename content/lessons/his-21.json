  "teach": {
    "sections": [
      {
        "title": "安史之乱",
        "body": "【时间：755—763年】\n【原因】玄宗后期怠政·节度使势力膨胀·外重内轻。\n【经过】安禄山起兵范阳→攻陷两京→玄宗奔蜀，马嵬驿兵变→肃宗即位，郭子仪等平叛。\n【影响】唐朝由盛转衰的转折点。"
      },
      {
        "title": "唐朝衰落",
        "body": "【藩镇割据】安史降将封节度使，内地遍设，拥兵自重。\n【宦官专权】自唐玄宗后期，宦官逐渐掌权，甚至废立皇帝。\n【朋党之争】朝臣结党互斗，政治日益腐败。"
      },
      {
        "title": "唐末农民起义与灭亡",
        "body": "【875年】黄巢起义爆发，转战南北，给唐朝统治以致命打击。\n【907年】朱温废唐建梁，唐朝灭亡，进入五代十国。"
      }
    ],
    "examples": [
      {
        "q": "安史之乱与唐朝衰亡有什么关系？",
        "steps": [
          "直接后果：北方经济破坏，人口锐减",
          "藩镇割据从此形成，中央权威瓦解",
          "经济重心加速南移",
          "它是「由盛转衰」的转折点，不是灭亡的直接原因"
        ],
        "tip": "转折点≠终点"
      },
      {
        "q": "盛唐崩塌给我们什么启示？",
        "steps": [
          "承平日久武备废弛",
          "地方权力过大缺乏制衡",
          "统治集团腐化怠政",
          "忧劳可以兴国，逸豫可以亡身"
        ],
        "tip": "居安思危"
      }
    ],
    "mistakes": [
      "认为安史之乱直接灭亡了唐朝（唐此后还延续 144 年）",
      "把黄巢起义记成推翻汉朝（黄巢灭唐，绿林赤眉是西汉末）"
    ]
  },
