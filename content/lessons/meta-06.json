  "teach": {
    "sections": [
      {
        "title": "错误分类",
        "body": "【四类错误：概念不清·计算失误·审题偏差·方法缺失】\n不同类型的错误需要不同的\"药方\"。\n统计你的错题：哪类最多？那就是你的主要失分原因。\n概念错=最危险（影响一整片），计算错=最可惜。"
      },
      {
        "title": "归因分析",
        "body": "【每道错题问三个\"为什么\"】\n①为什么错？（分类）②当时怎么想的？（还原思路）③正确思路的关键在哪？\n把分析写在错题旁边——比抄答案有用10倍。\n只改答案不分析=白改。"
      },
      {
        "title": "变式练习",
        "body": "【同类型题做3道才算真正掌握】\n从\"做对一道\"到\"做对一类\"。\n方法：找同类题·改数字重做·自己出题。\n一周后重做原题——对了才算\"消灭\"。"
      }
    ],
    "examples": [
      {
        "q": "一道方程题：3x+5=20 解得x=3，正确答案x=5。怎么分析？",
        "steps": [
          "分类：3×5+5=20≠20→计算失误",
          "还原：移项时5-20=-15→除以3得-5?",
          "关键是移项要变号：20-5=15→15/3=5",
          "对策：移项变号处标红提醒"
        ],
        "tip": "还原思路找断点"
      },
      {
        "q": "几何证明题不知道从哪入手怎么办？",
        "steps": [
          "分类：方法缺失",
          "学例题的切入点（从结论倒推）",
          "总结此类题的常用辅助线",
          "找3道同类题练习"
        ],
        "tip": "补方法=扩武器库"
      }
    ],
    "mistakes": [
      "改完答案就翻篇（必须归因分析）",
      "把所有错误归为\"粗心\"（掩盖真正原因）"
    ]
  },
