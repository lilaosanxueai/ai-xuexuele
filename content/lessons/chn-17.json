  "teach": {
    "sections": [
      {
        "title": "送别诗",
        "body": "【高频意象：杨柳（留）、酒（饯别）、长亭、夕阳、孤帆、芳草】\n情感三档：依依不舍（桃花潭水深千尺）、真挚祝福（莫愁前路无知己）、宽慰共勉（海内存知己）。\n古代交通不便一别经年——离别是古人最大的情感事件。"
      },
      {
        "title": "边塞诗",
        "body": "【高频意象：大漠、孤烟、长河、黄沙、金甲、铁骑、羌笛、雁门】\n风格：或雄浑豪迈（不破楼兰终不还），或悲壮苍凉（可怜无定河边骨），或思乡深切（不知何处吹芦管）。\n盛唐边塞诗派：高适、岑参、王昌龄。"
      },
      {
        "title": "题材判断法",
        "body": "【第一步看标题：送/别/塞上/出塞/军行】\n【第二步圈意象：柳与酒？沙与甲？】【第三步定基调：缠绵或悲壮】\n常见题材还有：山水田园、咏史怀古、思乡怀人、咏物言志——一题一号，全套对号。"
      }
    ],
    "examples": [
      {
        "q": "\"此夜曲中闻折柳，何人不起故园情\"属于什么题材？",
        "steps": [
          "关键词：折柳、故园情",
          "折柳=离别习俗，故园=思乡",
          "答案：思乡怀人（由送别意象触发）"
        ],
        "tip": "意象即信号弹"
      },
      {
        "q": "为什么边塞诗常用羌笛和芦管？",
        "steps": [
          "乐器声哀怨悠远",
          "戍边将士闻乐思乡",
          "以乐声衬托征人愁绪",
          "答案：触发思乡的听觉意象"
        ],
        "tip": "听觉意象也定调"
      }
    ],
    "mistakes": [
      "见\"柳\"就答写景诗（柳是送别专用信号）",
      "把边塞诗一律答成豪迈（还有悲凉与反战）"
    ]
  },
