  "teach": {
    "sections": [
      {
        "title": "经济繁荣的表现",
        "body": "【农业】占城稻·双季稻，「苏湖熟天下足」。\n【手工业】景德镇瓷都·广州泉州造船·煤开采量世界第一。\n【商业】市打破时空限制·出现早市夜市草市·海外贸易繁荣（市舶司管理）。"
      },
      {
        "title": "交子",
        "body": "【背景：四川通行铁钱，重且不方便】\n北宋前期，成都出现世界最早的纸币「交子」。\n后来由官府发行，纳入官方货币体系。\n意义：商业发展的产物，货币史上的重大进步。"
      },
      {
        "title": "经济重心南移",
        "body": "【过程】唐朝中期开始 → 南宋最终完成。\n【原因】北民南迁带来劳力技术·江南相对稳定·自然条件优越。\n【标志】中央财政收入主要来自南方。"
      }
    ],
    "examples": [
      {
        "q": "交子为什么诞生在四川？",
        "steps": [
          "四川通行铁钱",
          "买贵重商品要扛几大筐",
          "金属货币太重阻碍大额交易",
          "十六家商户联合发行纸质凭证"
        ],
        "tip": "需求催生创新"
      },
      {
        "q": "经济重心为什么南移？",
        "steps": [
          "北方战乱，南方相对安定",
          "北民南迁 = 劳动力 + 技术",
          "江南水热条件好，适合种稻",
          "南宋时终于反超北方"
        ],
        "tip": "战争·人口·地理"
      }
    ],
    "mistakes": [
      "认为交子出现在南宋（是北宋前期的四川）",
      "认为经济重心南移在唐朝完成（南宋才最终完成）"
    ]
  },
