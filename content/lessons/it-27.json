    ]
  },
  "story": "一张表 3000 行数字·看十分钟找不到重点——画成图·三秒钟看清趋势。数据可视化不是「把数字变好看」·是让数字开口说话。这一课也教你识破「会撒谎的图表」。",
  "goals": [
    "理解可视化的价值",
    "学会按数据选图表",
    "识别误导性图表"
  ],
  "aiIntro": "📊 让数字开口说话——数据可视化",
  "param": {
    "name": "dv",
    "label": "可视化站",
    "min": 1,
    "max": 3,
    "step": 1,
    "value": 1
  },
  "explore": [
    "为什么图比表好懂？",
    "什么数据配什么图？",
    "图表怎样骗人？"
  ],
  "views": [
    {
      "when": 1,
      "title": "价值",
      "subtitle": "图胜千表",
      "color": "blue",
      "emoji": "👁️",
      "blocks": [
        {
          "kind": "info",
          "icon": "🧠",
          "title": "人脑爱图",
          "text": "视觉是人类带宽最大的感官——一眼能看出「哪根柱子最高·哪条线在跌」：表格需要逐个读·图表整体呈现：可视化=把数字翻译成视觉语言"
        },
        {
          "kind": "info",
          "icon": "🎯",
          "title": "可视化的三问",
          "text": "一张好图回答三个问题：①有什么模式（涨跌·分布·异常值）②谁和谁比③所以呢（结论）：不能回答「所以呢」的图·只是装饰"
        },
        {
          "kind": "highlight",
          "text": "把数字翻译成视觉语言——好图直接给结论"
        }
      ]
    },
    {
      "when": 2,
      "title": "选型",
      "subtitle": "对号入座",
      "color": "green",
      "emoji": "🧰",
      "blocks": [
        {
          "kind": "compare",
          "title": "图表选型表",
          "items": [
            {
              "label": "比较大小",
              "value": "柱状图——谁多谁少一目了然（各科平均分）：类别比较的首选"
            },
            {
              "label": "看趋势",
              "value": "折线图——时间怎么变（月度气温）：有时间轴就用它"
            },
            {
              "label": "看占比",
              "value": "饼图——部分占整体（零花钱去向）：类别别超过5块·否则看不清"
            },
            {
              "label": "看分布",
              "value": "散点图（两变量关系）·直方图（数据分布）：找相关性和分布形态"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🎨",
          "title": "设计三原则",
          "text": "一张图说一件事（标题写结论：「数学成绩持续进步」而不是「成绩图」）；少即是多（去掉花哨3D和渐变——干扰读数）；标注来源和单位（严谨是可信的外衣）"
        },
        {
          "kind": "highlight",
          "text": "比大小柱状·看趋势折线·看占比饼图——标题直接写结论"
        }
      ]
    },
    {
      "when": 3,
      "title": "防骗",
      "subtitle": "会撒谎的图",
      "color": "red",
      "emoji": "⚠️",
      "blocks": [
        {
          "kind": "compare",
          "title": "三大骗术",
          "items": [
            {
              "label": "截断Y轴",
              "value": "柱状图Y轴不从0开始——「50分 vs 52分」能画成差三倍高的柱子：差距被视觉放大：见到不从0开始的柱图·先问为什么"
            },
            {
              "label": "双轴戏法",
              "value": "两条线用左右两个不同刻度的Y轴——调整刻度能让任何两条线「相交」或「分道扬镳」：想证明什么都画得出来"
            },
            {
              "label": "3D与顺序",
              "value": "3D饼图扭曲比例（前排遮挡后排）·饼图块顺序乱排（该从大到小顺时针）：花哨常是掩盖"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🛡️",
          "title": "防骗三步",
          "text": "①看轴：从哪开始·单位是什么②看源：数据从哪来（样本多大）③想一想：换个画法结论还成立吗——带着这三步看新闻图表·你比多数读者清醒"
        },
        {
          "kind": "highlight",
          "text": "截断Y轴·双轴·3D——骗术再多·看轴看源想一遍就破"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "价值",
        "body": "【原理】视觉带宽最大·一眼见模式。\n【三问】模式？谁比谁？所以呢？"
      },
      {
        "title": "选型",
        "body": "【柱状】比大小。【折线】看时间趋势。\n【饼】占比≤5块。【散点】相关性。\n【设计】标题写结论·少装饰·标来源。"
      },
      {
        "title": "防骗",
        "body": "【截断Y轴】差距视觉放大。\n【双轴】刻度可证一切。【3D】扭曲比例。\n【三步】看轴·看源·换画法想想。"
      }
    ],
    "examples": [
      {
        "q": "展示班级各科平均分",
        "steps": [
          "类别比较→柱状图",
          "X轴科目Y轴分数从0起",
          "标题写结论：语文领先",
          "标注数据来源"
        ],
        "tip": "对号入座"
      },
      {
        "q": "发现广告图Y轴从90开始",
        "steps": [
          "识别截断Y轴骗术",
          "差距被视觉放大",
          "还原从0开始的画法",
          "结论可能站不住"
        ],
        "tip": "看轴第一步"
      }
    ],
    "mistakes": [
      "所有数据都用饼图（趋势用折线·比较用柱状）",
      "相信截断Y轴制造的大差距（轴必须看起点）"
    ]
  },
