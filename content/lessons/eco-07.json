  "teach": {
    "sections": [
      {
        "title": "信用的定义",
        "body": "【经济信用】按承诺偿还的能力和意愿。\n组成：还款能力（收入资产）+还款意愿（历史记录）——缺一不可。"
      },
      {
        "title": "银行的原理",
        "body": "【存贷差】付储户低息·收贷款高息·差额覆盖运营+风险+利润。\n【风控】准备金·分散放贷·信用评估——银行的本质=经营风险的店铺。"
      },
      {
        "title": "个人征信",
        "body": "央行征信系统收录借贷记录·逾期信息。\n信用修复：逾期记录保留5年（还清后起算）——亡羊补牢为时未晚，但最好别丢羊。"
      }
    ],
    "examples": [
      {
        "q": "为什么信用好贷款更便宜？",
        "steps": [
          "银行借钱收利息也要担风险",
          "信用好=违约概率低",
          "风险成本低→利率可以低",
          "信用差→高利率覆盖可能的损失"
        ],
        "tip": "利率=资金价格+风险价格"
      },
      {
        "q": "帮朋友做贷款担保前该想什么？",
        "steps": [
          "担保=他还不上你替还",
          "他的信用差才会需要担保人",
          "自己名下也会记录这笔担保",
          "关系再好也要评估还款能力"
        ],
        "tip": "担保不是签名是负债"
      }
    ],
    "mistakes": [
      "认为银行的钱是自己的（是储户的，银行做中介）",
      "认为小额逾期没关系（记录保留5年影响以后的大额贷款）"
    ]
  },
