      "blocks": [
        {
          "kind": "info",
          "icon": "🧮",
          "title": "一除就出",
          "text": "72 ÷ 年利率(%) ≈ 翻倍年数：利率 6%→12 年翻倍；利率 8%→9 年翻倍——不用计算器心里就有数"
        },
        {
          "kind": "info",
          "icon": "📉",
          "title": "反向用法",
          "text": "物价每年涨 3%，多少年钱缩水一半？72÷3=24 年——通胀也在\"复利\"，只是对你不利"
        },
        {
          "kind": "info",
          "icon": "⚠️",
          "title": "双刃剑提醒",
          "text": "高收益必然伴随高风险；承诺\"保本又高息\"的多数是骗局——先保本再谈收益"
        },
        {
          "kind": "highlight",
          "text": "早开始+不中断=普通人最强的理财武器"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "利息从哪来",
        "body": "存款→银行放贷→借款人创造价值→付利息→分给储户。\n利率由什么定：资金供需·期限长短·风险高低。"
      },
      {
        "title": "复利的数学",
        "body": "复利公式：终值=本金×(1+r)ⁿ。\n直觉：利率是坡度，时间是坡长——坡道越长滚得越远。\n10 岁开始每年存 1000 到 60 岁 vs 30 岁才开始：差的不只是本金，是几十年的坡道。"
      },
      {
        "title": "理财三原则",
        "body": "【先储蓄后消费】收入-储蓄=支出，不是反过来。\n【分散不押注】鸡蛋不放一个篮子。\n【警惕高息陷阱】收益与风险永远成对出现。"
      }
    ],
    "examples": [
      {
        "q": "压岁钱 2000 元年利率 3%，复利两年后约多少？",
        "steps": [
          "第一年：2000×1.03=2060",
          "第二年：2060×1.03≈2122",
          "复利=利息也进了本金",
          "两年利息约 122 元"
        ],
        "tip": "利滚利逐年加速"
      },
      {
        "q": "同学说有个App月息10%稳赚，投吗？",
        "steps": [
          "月息10%=年化超200%",
          "72法则：0.6个月翻倍？",
          "正常投资做不到",
          "保本高息=庞氏骗局经典话术"
        ],
        "tip": "收益高到离谱=骗局概率接近100%"
      }
    ],
    "mistakes": [
      "认为利息是银行白给的（是资金创造的报酬分配）",
      "认为复利能一夜暴富（复利靠时间不靠赌）"
    ]
  },
