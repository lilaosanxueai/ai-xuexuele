  "views": [
    {
      "when": 1,
      "title": "利息",
      "subtitle": "钱打工赚的",
      "color": "blue",
      "emoji": "💰",
      "blocks": [
        {
          "kind": "info",
          "icon": "🏦",
          "title": "银行不是白给你钱",
          "text": "你存钱进银行=把钱\"借\"给银行——银行转借给别人（房贷·贷款）收更多利息·分你一小杯：利息=借钱的\"租金\"：你的钱在替别人干活·赚来的辛苦费"
        },
        {
          "kind": "info",
          "icon": "🧮",
          "title": "算一算",
          "text": "利率 2%：存 100 元一年 → 102 元（多了 2 元利息）；存 1000 元 → 1020 元——本金越多利息越多：这就是\"本金越大·打工越有力\""
        },
        {
          "kind": "highlight",
          "text": "利息=你的钱替别人打工·分给你的工资"
        }
      ]
    },
    {
      "when": 2,
      "title": "复利",
      "subtitle": "滚雪球",
      "color": "green",
      "emoji": "❄️",
      "blocks": [
        {
          "kind": "steps",
          "title": "利滚利的魔法",
          "items": [
            "第一年：100 元 × 2% = 2 元利息（总 102 元）",
            "第二年：利息按 102 元算！= 2.04 元（总 104.04 元）",
            "利息也生利息——像雪球越滚越大：这叫复利",
            "爱因斯坦据说叫它\"世界第八大奇迹\""
          ]
        },
        {
          "kind": "info",
          "icon": "⏳",
          "title": "时间的力量",
          "text": "每年只存 1000 元·利率 3%：存 40 年 → 本金 4 万·复利滚成 7.5 万+！多出来的 3.5 万全是\"时间的工资\"——开始越早·雪球越大：大人拼命让年轻人开始存钱的原因"
        },
        {
          "kind": "info",
          "icon": "⚠️",
          "title": "反过来也一样",
          "text": "信用卡欠钱不还·利息也会复利滚——这次滚的是欠款（越来越欠）：雪球往哪边滚·取决于你在雪坡的哪一边"
        },
        {
          "kind": "highlight",
          "text": "复利不选边——它让存钱的人更富·让欠钱的人更穷"
        }
      ]
    },
    {
      "when": 3,
      "title": "目标",
      "subtitle": "存钱三步",
      "color": "amber",
      "emoji": "🎯",
      "blocks": [
        {
          "kind": "steps",
          "title": "梦想储蓄计划",
          "items": [
            "定目标：想买什么？（350 元的望远镜）写下来贴在罐子上",
            "拆解：每月存 50 元 → 7 个月达成——小步不怕慢",
            "放对地方：短期零花放罐子·长期目标存银行（吃利息）",
            "庆祝：达成后跟爸妈复盘——下一轮目标升级"
          ]
        },
        {
          "kind": "info",
          "icon": "💡",
          "title": "一个聪明做法",
          "text": "零花钱到手先分三份：花·存·帮（助人）——\"先存后花\"而不是\"花剩才存\"：顺序一换·结果天差地别——富人家的孩子早学的习惯"
        },
        {
          "kind": "highlight",
          "text": "存钱最难的技巧：开始——和坚持"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "利息",
        "body": "【本质】借钱的租金（你的钱打工的工资）。\n【计算】利息=本金×利率。\n【规律】本金越多利息越多。"
      },
      {
        "title": "复利",
        "body": "【定义】利息也生利息（滚雪球）。\n【时间】越早开始滚得越大。\n【反面】欠款也会复利滚——雪球选边站。"
      },
      {
        "title": "储蓄计划",
        "body": "【三步】定目标→拆月存→放对地方。\n【先存后花】顺序决定结果。\n【三份法】花·存·帮。"
      }
    ],
    "examples": [
      {
        "q": "想买 280 元的滑板，月零花 60 元怎样计划？",
        "steps": [
          "每月存 40（留 20 花）",
          "280÷40=7 个月",
          "放储蓄罐防乱花",
          "提前达成可加速——副业帮忙"
        ],
        "tip": "目标拆解"
      },
      {
        "q": "同学说\"存银行利息才 2 块没意思\"",
        "steps": [
          "看小了：利率只是速度",
          "时间是加速器（复利）",
          "100→40年750+ 不是2块的事",
          "习惯从小养成才是本金"
        ],
        "tip": "别小看时间"
      }
    ],
    "mistakes": [
      "认为利息是银行白送的（是钱的租金）",
      "只看利率不看时间（复利里时间是王牌）"
    ]
  },
