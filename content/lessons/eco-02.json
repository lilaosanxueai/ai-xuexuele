  "teach": {
    "sections": [
      {
        "title": "两条定律",
        "body": "【需求定律】价格↑需求量↓；【供给定律】价格↑供给量↑。\n记忆：买家嫌贵（反着走），卖家贪价（顺着走）。"
      },
      {
        "title": "均衡与波动",
        "body": "供给=需求时的价格叫均衡价格。\n波动之源：供给突变（天灾·技术）·需求突变（节日·流行）。\n价格波动又反过来调节供给和需求——自动回平衡。"
      },
      {
        "title": "价格的信号功能",
        "body": "价格是最浓缩的信息：一个数字同时告诉买家\"值不值\"和卖家\"种不种\"。\n理解价格=理解市场经济的底层语言。"
      }
    ],
    "examples": [
      {
        "q": "口罩为什么疫情初期涨价又回落？",
        "steps": [
          "疫情：需求暴增",
          "短期供给跟不上→价格猛涨",
          "价高吸引工厂转产口罩",
          "供给大增→价格回落甚至过剩"
        ],
        "tip": "价格调动全世界的供给"
      },
      {
        "q": "今年荔枝 30 元一斤，明年种荔枝划算吗？",
        "steps": [
          "价高→果农抢种荔枝",
          "几年后荔枝大量上市",
          "供给暴增→价格暴跌（果贱伤农）",
          "种植决策要看长期，别追价格高峰"
        ],
        "tip": "一窝蜂=下一轮过剩"
      }
    ],
    "mistakes": [
      "认为价格是老板随便定的（受供需竞争约束）",
      "认为涨价一定是商家黑心（多数是供需变化的信号）"
    ]
  },
