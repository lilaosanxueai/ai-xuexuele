  "teach": {
    "sections": [
      {
        "title": "呈示部",
        "body": "【一主题】有力紧张（小调弦乐）。\n【二主题】抒情柔和（大调如歌）。\n【结束】收束常反复。"
      },
      {
        "title": "展开再现",
        "body": "【展开】拆碎变形转调对撞·最不稳。\n【再现】主题回归统一主调·冲突解决。\n【哲学】经历冲突后的回归。"
      },
      {
        "title": "演化",
        "body": "【莫扎特】平衡优雅。【贝多芬】冲突最大化。\n【浪漫派】歌唱自由。\n【听法】记一主题→等二主题→跟展开→迎再现。"
      }
    ],
    "examples": [
      {
        "q": "用三步听贝五第一乐章",
        "steps": [
          "「当当当当」=第一主题",
          "温柔段落=第二主题",
          "中间最乱=展开",
          "主题回归=再现部"
        ],
        "tip": "跟踪叙事"
      },
      {
        "q": "分不清呈示和再现",
        "steps": [
          "听主题是否完整陈述",
          "呈示=首次介绍·再现=回来",
          "再现常在大的不稳定后",
          "调性统一是标志"
        ],
        "tip": "位置+稳定性"
      }
    ],
    "mistakes": [
      "把奏鸣曲式等同于奏鸣曲（曲式是结构·奏鸣曲是用此曲式的体裁）",
      "认为展开部是「随便写」（主题材料来自呈示部）"
    ]
  },
