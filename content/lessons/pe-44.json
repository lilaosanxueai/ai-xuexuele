  "story": "每年夏天溺水事故超过五万起——大部分遇难者不是不会游泳·而是不会自救；大部分救人者也不是溺水者——而是\"会游泳但不会救人\"的施救者被拖下水。这一课学最关键的水上知识。",
  "goals": [
    "掌握落水自救四步",
    "学会岸上优先施救",
    "识别真正的溺水信号"
  ],
  "aiIntro": "🛟 能救你的不是力气是知识——游泳自救",
  "param": {
    "name": "ws",
    "label": "自救站",
    "min": 1,
    "max": 3,
    "step": 1,
    "value": 1
  },
  "explore": [
    "落水了先做什么？",
    "同伴溺水你跳下去吗？",
    "真正的溺水是什么样的？"
  ],
  "views": [
    {
      "when": 1,
      "title": "自救",
      "subtitle": "落水四步",
      "color": "blue",
      "emoji": "🏊",
      "blocks": [
        {
          "kind": "steps",
          "title": "落水自救",
          "items": [
            "不要慌张不要挣扎——恐慌消耗体力是第一杀手：告诉自己\"我能漂起来\"",
            "仰漂：头后仰·口鼻露出水面·四肢放松——人体肺里有空气=天然救生圈：静待救援",
            "大声呼救：挥手喊救命（不喊就不会有人知道",
            "抓漂浮物：木棍·泡沫·空瓶——任何能浮的东西都行"
          ]
        },
        {
          "kind": "info",
          "icon": "⚠️",
          "title": "抽筋怎么办",
          "text": "小腿抽筋→抓住脚趾往身体方向拉（反向拉伸）·深呼吸保持仰漂：抽筋不可怕·恐慌才可怕：平复后慢慢游向岸边"
        },
        {
          "kind": "highlight",
          "text": "落水第一件事不是游泳是冷静——仰漂是保命技能"
        }
      ]
    },
    {
      "when": 2,
      "title": "救人",
      "subtitle": "岸上优先",
      "color": "green",
      "emoji": "🛟",
      "blocks": [
        {
          "kind": "compare",
          "title": "施救三选",
          "items": [
            {
              "label": "最优先",
              "value": "岸上救援：扔救生圈·递竹竿·抛绳——自己不下水"
            },
            {
              "label": "其次",
              "value": "抛漂浮物：空瓶·泡沫·书包——能浮就行"
            },
            {
              "label": "最后",
              "value": "下水救人——仅在受过专业训练时：从背后接近（正面会被死死抱住）"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🚫",
          "title": "绝对不要",
          "text": "不要徒手正面接近溺水者——溺水者会本能地死死抱住你（不是故意的·是求生本能）：两人一起沉的悲剧大多由此发生：记住\"叫伸抛·不到万不得已不下水\""
        },
        {
          "kind": "highlight",
          "text": "叫（喊人）伸（递竿）抛（扔圈）——岸上救援三招"
        }
      ]
    },
    {
      "when": 3,
      "title": "识别",
      "subtitle": "真溺水不喊",
      "color": "rose",
      "emoji": "⚠️",
      "blocks": [
        {
          "kind": "compare",
          "title": "真溺水vs影视",
          "items": [
            {
              "label": "影视版",
              "value": "大喊大叫·疯狂拍水——水面很戏剧化"
            },
            {
              "label": "真溺水",
              "value": "安静无声·头一沉一浮·眼神呆滞·看起来像站着——溺水者的嘴在水面上下·来不及喊"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "👁️",
          "title": "五个信号",
          "text": "头后仰嘴在水面·眼神涣散·身体直立·腿不踢水·安静——发现任何一个立刻问\"你还好吗\"：没回答=立刻呼救"
        },
        {
          "kind": "info",
          "icon": "📞",
          "title": "记住",
          "text": "拨打110/120·说清位置（XX水库东侧·有标志物描述）——不挂电话等对方先挂：救援的第一步永远是呼救"
        },
        {
          "kind": "highlight",
          "text": "真溺水是无声的——安静的水面才是最危险的"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "落水自救",
        "body": "【第一】冷静不挣扎。仰漂保命。呼救。抓漂浮物。\n【抽筋】反向拉伸。"
      },
      {
        "title": "岸上救人",
        "body": "【优先级】叫伸抛→不下水。正面接近=两人沉。"
      },
      {
        "title": "溺水识别",
        "body": "【真实】安静无声·头一沉一浮·直立·不踢水。\n【影视】大喊拍水——假的。\n【求助】110/120。"
      }
    ],
    "examples": [
      {
        "q": "同伴在水中挣扎",
        "steps": [
          "大声呼救",
          "扔漂浮物或递竿",
          "不徒手下水",
          "等专业救援"
        ],
        "tip": "岸上优先"
      },
      {
        "q": "自己落水不会游",
        "steps": [
          "冷静",
          "仰漂",
          "呼救",
          "等救援"
        ],
        "tip": "冷静第一"
      }
    ],
    "mistakes": [
      "认为会游泳就敢下水救人（正面接近会被拖沉）",
      "认为溺水者会大喊拍水（真溺水是无声的）"
    ]
  },
