      "blocks": [
        {
          "kind": "steps",
          "title": "昆虫的三个特征",
          "items": [
            "六条腿：数一数·三对足——这是昆虫最铁的标志",
            "身体分三节：头·胸·腹——头长感觉·胸长腿和翅·腹部长内脏",
            "大多有翅有触角：一对触角当「天线」·大多数有翅膀（蚂蚁的婚蚁也有翅）"
          ]
        },
        {
          "kind": "info",
          "icon": "❓",
          "title": "它们是昆虫吗",
          "text": "蜘蛛8条腿——不是昆虫（蛛形纲）；蜈蚣好多腿——不是（多足类）；蜗牛软趴趴——不是（软体动物）；蚂蚁蜜蜂蝴蝶七星瓢虫萤火虫——都是！认昆虫先数腿"
        },
        {
          "kind": "highlight",
          "text": "六条腿+头胸腹三节=昆虫——先数腿再说"
        }
      ]
    },
    {
      "when": 2,
      "title": "观察",
      "subtitle": "侦探三件套",
      "color": "green",
      "emoji": "🔍",
      "blocks": [
        {
          "kind": "steps",
          "title": "观察三步",
          "items": [
            "找：花丛·草地·树皮·石头下——清晨和傍晚昆虫最活跃",
            "看：放大镜看细节——触角什么形状？翅膀几对？腿上有没有小刺？",
            "记：画下它的样子·写上发现（「触角像两根小天线」）——侦探都要做笔记"
          ]
        },
        {
          "kind": "info",
          "icon": "💞",
          "title": "观察的规矩",
          "text": "轻轻看·不乱抓·不伤害：观察完让它回家（放回发现它的地方）；不用手直接碰不认识的虫（有的会咬人蜇人·有的皮肤会过敏）：好奇心重要·尊重和安全更重要"
        },
        {
          "kind": "info",
          "icon": "📖",
          "title": "向法布尔学习",
          "text": "一百年前的法布尔蹲在荒草地里看了几十年昆虫·写成《昆虫记》——蝉怎样地下等四年·蜣螂怎样滚粪球：伟大的发现从「蹲下来看」开始"
        },
        {
          "kind": "highlight",
          "text": "找·看·记三步+不伤害的规矩——小侦探守则"
        }
      ]
    },
    {
      "when": 3,
      "title": "贡献",
      "subtitle": "虫不可貌相",
      "color": "amber",
      "emoji": "🌸",
      "blocks": [
        {
          "kind": "compare",
          "title": "昆虫的本领",
          "items": [
            {
              "label": "传粉",
              "value": "蜜蜂蝴蝶给花传粉——没有它们·很多水果蔬菜结不出果：全球三分之一的食物要谢谢传粉昆虫"
            },
            {
              "label": "清洁",
              "value": "蜣螂（屎壳郎）清理粪便·蚯蚓松土（小伙伴）·分解死去的动植物——大自然的清洁工"
            },
            {
              "label": "食物链",
              "value": "昆虫是鸟·蛙·鱼的食物——没有虫·一整条食物链塌方：小小的身体·大大的位置"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "⚖️",
          "title": "益虫与害虫",
          "text": "吃庄稼的蝗虫·传疾病的蚊子是害虫；蜜蜂七星瓢虫（吃蚜虫）是益虫：分类不靠长相·看它做什么——用农药要适量·别把朋友也伤了"
        },
        {
          "kind": "highlight",
          "text": "传粉清洁当食物——六条腿的小英雄"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "昆虫特征",
        "body": "【三特征】六条腿·头胸腹三节·多翅触角。\n【排除】蜘蛛8腿蜈蚣多腿蜗牛软体。"
      },
      {
        "title": "观察方法",
        "body": "【三步】找→放大镜看→画记笔记。\n【规矩】轻看不伤害·放回家·不乱碰。\n【榜样】法布尔昆虫记。"
      },
      {
        "title": "昆虫贡献",
        "body": "【传粉】三分之一食物靠它。\n【清洁】分解垃圾松土。【链条】鸟蛙的粮食。\n【分辨】益虫害虫看做什么。"
      }
    ],
    "examples": [
      {
        "q": "观察校园里的一只蚂蚁",
        "steps": [
          "蹲下轻轻跟踪",
          "放大镜数腿看触角",
          "画在本上写发现",
          "看完送回原地"
        ],
        "tip": "小侦探笔记"
      },
      {
        "q": "分不清蜘蛛是不是昆虫",
        "steps": [
          "数腿：八条",
          "昆虫六条腿",
          "身体分头胸腹吗",
          "不是昆虫·是蛛形纲"
        ],
        "tip": "数腿定身份"
      }
    ],
    "mistakes": [
      "把蜘蛛蜈蚣当成昆虫（腿数不对）",
      "观察时乱抓乱捏（安全+爱护小生命）"
    ]
  },
