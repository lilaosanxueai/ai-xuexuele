  "teach": {
    "sections": [
      {
        "title": "增长率模型",
        "body": "【原量 × (1+增长率)ⁿ = n 年后的量】\n100 元年增 20%：一年后 120，两年后 120×1.2 = 144（不是 140）。\n列方程：a(1+x)² = b，展开成二次方程求解。"
      },
      {
        "title": "面积问题",
        "body": "长比宽多 2 米、面积 15：设宽 x，则 x(x+2) = 15。\n解出 x = 3 或 x = −5，负值不合实际，舍去。\n几何量的根必须为正且有实际意义。"
      },
      {
        "title": "根的检验",
        "body": "【应用题的解必须同时满足：方程成立 + 实际意义】\n长度、时间为负 → 舍；增长率 < −100% → 舍。\n\"验根\"是应用题的收尾动作，不能省。"
      }
    ],
    "examples": [
      {
        "q": "某厂产值 200 万元，年均增长率为 x，两年后达 288 万元。求 x。",
        "steps": [
          "列方程：200(1+x)² = 288",
          "(1+x)² = 1.44",
          "1+x = 1.2（取正根）",
          "x = 0.2 = 20%"
        ],
        "tip": "开平方取正根：1+x 不可能为负"
      },
      {
        "q": "矩形长比宽多 3cm，面积 40cm²，求宽。",
        "steps": [
          "设宽 x cm，长 (x+3) cm",
          "x(x+3) = 40 → x²+3x−40=0",
          "(x+8)(x−5)=0 → x=5 或 x=−8",
          "宽为正：x = 5 cm"
        ],
        "tip": "负根直接舍去并说明理由"
      }
    ],
    "mistakes": [
      "两年增长写成 (1+2x)（漏了复利效应）",
      "忘舍负根：宽 −8cm 这类解必须舍去"
    ]
  },
