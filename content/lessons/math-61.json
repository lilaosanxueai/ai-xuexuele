  "starterCode": "# 增长率问题探索台\nr = 20   # 增长率（%）\n\nhide()\nf = r / 100\nv1 = 100 * (1 + f)\nv2 = 100 * (1 + f) * (1 + f)\nnaive = 100 + 2 * r\n# 三根柱：原量 / 两年后(真实) / 两年后(简单加)\nfill_rect(-120, -70 + 50, 60, 100, \"#94a3b8\")\nwrite(\"原量 100\", -120, -85, \"#475569\", 11)\nh2 = v2\nfill_rect(0, -70 + h2 / 2, 60, h2, \"#16a34a\")\nwrite(\"两年后\", 0, -85, \"#15803d\", 11)\nwrite(v2, 0, -105, \"#15803d\", 12)\nfill_rect(120, -70 + naive / 2, 60, naive, \"#fdba74\")\nwrite(\"误解 100+2r\", 120, -85, \"#b45309\", 11)\nwrite(naive, 120, -105, \"#b45309\", 12)\nwrite(\"真实两年后 = 100×(1+\" + f + \")² = \" + v2, -150, 140, \"#16a34a\", 13)\nwrite(\"简单相加误算 = \" + naive + \"，少了 \" + (v2 - naive), -150, 115, \"#ea580c\", 12)\nwrite(\"第二年是在第一年的基础上再涨——利滚利！\", -180, 90, \"#1d4ed8\", 11)\nwrite(\"方程：100(1+x)² = \" + v2 + \"，x=\" + f, -150, -130, \"#0f172a\", 12)\n",
