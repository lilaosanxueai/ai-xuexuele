  "teach": {
    "sections": [
      {
        "title": "三视图",
        "body": "【正视图（从前看）、侧视图（从左看）、俯视图（从上看）】\n长方体三视图都是矩形，尺寸分别是\"长×高\"\"宽×高\"\"长×宽\"。\n圆柱正侧视图是矩形、俯视图是圆；圆锥正侧视图是三角形。"
      },
      {
        "title": "体积公式",
        "body": "【柱体 V=Sh；锥体 V=Sh/3；球 V=4πr³/3】\n长方体 V=abc；圆柱 V=πr²h；圆锥 V=πr²h/3。\n球半径 2 倍 → 体积 8 倍（立方关系）。"
      },
      {
        "title": "组合体",
        "body": "组合体体积 = 各部分之和（或差）。\n\"圆柱挖去圆锥\"\"长方体上放半球\"——分块算再拼。\n关键：找准各部分的底和高（半径）。"
      }
    ],
    "examples": [
      {
        "q": "长方体长 5、宽 4、高 3，求体积与正视图面积。",
        "steps": [
          "体积 V = 5×4×3 = 60",
          "正视图 = 长×高 = 5×3",
          "= 15"
        ],
        "tip": "分清体积（三维）与视图面积（二维）"
      },
      {
        "q": "球半径为 3，体积是多少？（π 取 3.14）",
        "steps": [
          "V = (4/3)πr³",
          "= (4/3)×3.14×27",
          "= 113.04？先算 4×27=108，108/3=36，36×3.14",
          "= 113.04"
        ],
        "tip": "先算 4r³/3 再乘 π，数字更整齐"
      }
    ],
    "mistakes": [
      "球体积用 4πr²（那是表面积）",
      "组合体重复计算重叠部分"
    ]
  },
