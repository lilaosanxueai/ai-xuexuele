  "starterCode": "# 长方体三视图探索台\nw = 4   # 宽\nh = 5   # 高\n\nhide()\nd = 3\nV = w * h * d\n# 立体感：正面矩形 + 斜移顶面侧面\nfill_rect(-130, 20, w * 20, h * 20, \"#bfdbfe\")\nfill_rect(-130 + 26, 20 + 26, w * 20, h * 20, \"#93c5fd\")\npen_color(\"#60a5fa\")\npen_down()\ngo_to(-130 - w * 10, 20 + h * 10)\ngo_to(-130 - w * 10 + 26, 20 + h * 10 + 26)\npen_up()\nwrite(\"长方体 w=\" + w + \" h=\" + h + \" d=3\", -130, -70, \"#1d4ed8\", 12)\n# 正视图（左下）：宽×高\nfill_rect(-150, -140 + h * 10, w * 16, h * 16, \"#fdba74\")\nwrite(\"正视图 \" + w + \"×\" + h, -150, -165, \"#b45309\", 10)\n# 俯视图（中下）：宽×深\nfill_rect(0, -140 + 24, w * 16, 48, \"#86efac\")\nwrite(\"俯视图 \" + w + \"×3\", 0, -165, \"#15803d\", 10)\n# 侧视图（右下）：深×高\nfill_rect(150, -140 + h * 16 / 2, 48, h * 16, \"#f9a8d4\")\nwrite(\"侧视图 3×\" + h, 150, -165, \"#be185d\", 10)\nwrite(\"体积 V = whd = \" + w + \"×\" + h + \"×3 = \" + V, -80, 165, \"#dc2626\", 13)\nwrite(\"球 V=4/3πr³  圆柱 V=πr²h  圆锥 V=πr²h/3\", -180, 140, \"#1d4ed8\", 11)\n",
