  ],
  "views": [
    {
      "when": 1,
      "title": "开会",
      "subtitle": "家的事大家定",
      "color": "blue",
      "emoji": "📋",
      "blocks": [
        {
          "kind": "info",
          "icon": "🏠",
          "title": "什么是家庭会议",
          "text": "全家定期（比如每周日晚饭后）坐下来·商量家里的事：周末去哪·屏幕时间规则·假期计划·家里养不养宠物——不是爸妈宣布·是一起商量"
        },
        {
          "kind": "info",
          "icon": "❌",
          "title": "它不是什么",
          "text": "不是批斗会（专门数落你的会）·不是表决机器（举完手就散）·不是吵架现场——它是「有话好好说」的练习场：气氛不对时宁可先停下"
        },
        {
          "kind": "info",
          "icon": "✅",
          "title": "它是什么",
          "text": "是一个家里每个人——包括小孩——都能安全说出想法的地方：说了不会被嘲笑·不会被骂·会被认真听完：这是家庭会议最重要的规则"
        },
        {
          "kind": "highlight",
          "text": "家庭会议=每个人的想法都被认真听完的地方"
        }
      ]
    },
    {
      "when": 2,
      "title": "规则",
      "subtitle": "怎样开好",
      "color": "green",
      "emoji": "⚖️",
      "blocks": [
        {
          "kind": "steps",
          "title": "开会四规则",
          "items": [
            "轮流说·不打断：拿一个「发言棒」（毛绒玩具就行）·谁拿着谁说·其他人听完——抢话就传棒",
            "说事实和感受：「我很委屈·因为弟弟弄坏我的模型没道歉」——比「你们都偏心」有用一百倍",
            "一起想办法：头脑风暴·天马行空都行·先不批评——「去月球野餐」也先记下来再说",
            "举手表决：办法列出来全家投票——孩子的票和爸妈的票一样重"
          ]
        },
        {
          "kind": "info",
          "icon": "📝",
          "title": "会议小装备",
          "text": "一张「议题表」（谁想商量什么提前写上）+一个「记录本」（决定了什么写下来·下周检查做到了没）——写下来的约定比口头的有力气"
        },
        {
          "kind": "highlight",
          "text": "发言棒·说感受·不批评·举手表决——开会四规则"
        }
      ]
    },
    {
      "when": 3,
      "title": "收获",
      "subtitle": "练出什么",
      "color": "amber",
      "emoji": "💪",
      "blocks": [
        {
          "kind": "compare",
          "title": "三种能力",
          "items": [
            {
              "label": "表达力",
              "value": "把「我就是生气」翻译成「我生气因为…我希望…」——一生的受用本事：从家里练起"
            },
            {
              "label": "倾听力",
              "value": "听弟弟讲完不翻白眼·听爸妈的难处不插嘴——会听的人·别人也更愿意听他"
            },
            {
              "label": "规则感",
              "value": "自己投票参与定的规则·遵守起来心服口服——比「被要求遵守」强大得多：这就是参与的力量"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🌱",
          "title": "小提议",
          "text": "今晚就可以提议开第一次会：议题选「本周全家屏幕时间怎么定」——准备你的发言棒·想想你的「事实与感受」：第一次开会·你就是发起人"
        },
        {
          "kind": "highlight",
          "text": "会说·会听·守自己定的规则——家庭会议送你三件礼物"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "什么是",
        "body": "【定义】全家定期商量家里的事。\n【不是】批斗会·表决机器·吵架现场。\n【核心】每个想法被认真听完。"
      },
      {
        "title": "四规则",
        "body": "【发言棒】拿着才说。【感受】我…因为…希望…。\n【风暴】先不批评。【表决】孩子的票一样重。"
      },
      {
        "title": "收获",
        "body": "【表达】把情绪翻译成事实和希望。\n【倾听】听完不翻白眼。【规则】参与定的更愿遵守。"
      }
    ],
    "examples": [
      {
        "q": "觉得屏幕时间规定不公平",
        "steps": [
          "写进家庭会议议题",
          "开会时说：我希望…因为…",
          "听爸妈说担心什么",
          "一起商量出双方能接受的方案"
        ],
        "tip": "用事实和感受"
      },
      {
        "q": "会上弟弟一直在抢话",
        "steps": [
          "把发言棒递给他",
          "「你先说·说完了我再说」",
          "他说完谢谢你再发言",
          "提醒规则人人平等"
        ],
        "tip": "棒子说话"
      }
    ],
    "mistakes": [
      "用「你们都偏心」开头（说事实和感受才有人听）",
      "认为开会就是让孩子赢（是商量出全家都能接受的方案）"
    ]
  },
