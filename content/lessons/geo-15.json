  "teach": {
    "sections": [
      {
        "title": "三级行政区划",
        "body": "【省级（省/自治区/直辖市/特别行政区）→ 县级 → 乡级】\n34 个省级行政区 = 23 省 + 5 自治区 + 4 直辖市（京津沪渝）+ 2 特别行政区（港澳）。\n我国的行政中心：北京。"
      },
      {
        "title": "简称的由来",
        "body": "【取全名一字：京、津、吉、辽、苏、浙、川……】\n【用历史古称：冀（河北）、晋（山西）、皖（安徽）、鄂（湖北）、湘（湖南）、粤（广东）、蜀（四川）、滇（云南）、黔（贵州）、陇（甘肃）、秦（陕西）】\n【用境内河流：湘江→湘、赣江→赣、沪（沪渎）】"
      },
      {
        "title": "形状记忆法",
        "body": "【黑龙江像天鹅，云南像孔雀，青海像兔子，内蒙古像弯弓】\n【陕西像跪俑，广东像大象头，山东像伸出的大拇指】\n组合记：东北三省排一排，黄河流经九省区（青川甘宁蒙晋陕豫鲁）。\n每天描一遍中国政区图，两周拿下 34 兄弟。"
      }
    ],
    "examples": [
      {
        "q": "黄河流经哪 9 个省区？",
        "steps": [
          "自源头向下游：青海",
          "四川 甘肃 宁夏",
          "内蒙古 山西 陕西",
          "河南 山东 入海",
          "口诀：青川甘宁蒙，晋陕豫鲁"
        ],
        "tip": "顺流背诵"
      },
      {
        "q": "渝 是哪个城市的简称？",
        "steps": [
          "渝=重庆",
          "源自隋代渝州",
          "四大直辖市之一",
          "京津沪渝"
        ],
        "tip": "古称系列"
      }
    ],
    "mistakes": [
      "认为省会和简称一一对应字面（成都≠川字面）",
      "忘记港澳台也属省级行政区"
    ]
  },
