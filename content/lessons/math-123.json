  "teach": {
    "sections": [
      {
        "title": "思想四步",
        "body": "【分割】切 n 段。【近似】每段作矩形。\n【求和】黎曼和。【极限】n→∞ 即定积分。"
      },
      {
        "title": "基本定理",
        "body": "【公式】∫ₐᵇf(x)dx=F(b)−F(a)。\n【F】f 的原函数（F′=f）。\n【互逆】微分与积分互逆。\n【例】∫₀¹x²dx=1/3。"
      },
      {
        "title": "应用",
        "body": "【几何】面积体积弧长。【物理】v→s·F→W。\n【概率】密度曲线下面积=概率。\n【现代】CT·信号·火箭轨道。"
      }
    ],
    "examples": [
      {
        "q": "算 ∫₀² 3x² dx",
        "steps": [
          "原函数 F=x³",
          "F(2)−F(0)",
          "8−0",
          "=8"
        ],
        "tip": "原函数两端差"
      },
      {
        "q": "速度 v(t)=2t·前3秒路程",
        "steps": [
          "路程=∫₀³2t·dt",
          "原函数 t²",
          "9−0=9",
          "路程9米"
        ],
        "tip": "积分回路程"
      }
    ],
    "mistakes": [
      "忘记代上限减下限（写成 F(b)+F(a)）",
      "被积函数在区间内变号时直接当面积（需分段取绝对值）"
    ]
  },
