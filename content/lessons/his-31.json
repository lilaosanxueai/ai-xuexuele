  "teach": {
    "sections": [
      {
        "title": "文艺复兴",
        "body": "【时间地点】14世纪意大利→16世纪西欧。\n【核心思潮】人文主义：以人为中心，肯定人的价值。\n【代表】但丁《神曲》·达·芬奇·莎士比亚。\n【实质】资产阶级思想文化运动的兴起。"
      },
      {
        "title": "新航路的开辟",
        "body": "【原因】经济根源（商品经济·寻金热）·商路阻断·宗教传播·技术条件。\n【过程】迪亚士→好望角；达·伽马→印度；哥伦布→美洲；麦哲伦船队→环球。\n【影响】世界连成一体·欧洲大西洋沿岸繁荣·殖民扩张开始。"
      },
      {
        "title": "走向近代",
        "body": "【经济】手工工场·租地农场，资本主义萌芽。\n【思想】文艺复兴解放思想。\n【全球】新航路+殖民掠夺=世界市场雏形。\n【理解】生产力发展是近代社会转型的根本动力。"
      }
    ],
    "examples": [
      {
        "q": "文艺复兴为什么「借古人之名」？",
        "steps": [
          "教会势力强大，直接反教会风险大",
          "借复兴古希腊罗马文化为旗帜",
          "实际宣传资产阶级新思想",
          "「旧瓶装新酒」的斗争策略"
        ],
        "tip": "实质是创新"
      },
      {
        "q": "新航路开辟和中国郑和下西洋有何不同？",
        "steps": [
          "目的：开拓市场寻金 vs 扬国威友好交往",
          "性质：殖民扩张开端 vs 和平之旅",
          "结果：资本原始积累 vs 财政难以维持",
          "同一片海洋，两种时代走向"
        ],
        "tip": "对比出真知"
      }
    ],
    "mistakes": [
      "认为文艺复兴是复古运动（实质是资产阶级新文化运动）",
      "认为哥伦布到达的是印度（他至死以为是印度，实际是美洲；所以叫「印第安人」）"
    ]
  },
