      "emoji": "📅",
      "blocks": [
        {
          "kind": "info",
          "icon": "📋",
          "title": "细胞周期",
          "text": "一次分裂结束到下一次结束——大部分时间（90%以上）在「分裂间期」：DNA 复制·蛋白质合成·为复印「备纸备墨」：分裂期（M期）反而短促"
        },
        {
          "kind": "info",
          "icon": "🧵",
          "title": "染色质与染色体",
          "text": "间期 DNA 呈细丝状（染色质·方便复制）——分裂时凝缩成粗棒（染色体·方便搬运）：同一物质两种形态·像「毛线 vs 线团」·搬运时必须打包"
        },
        {
          "kind": "highlight",
          "text": "间期备料·分裂期搬运——90% 时间在准备"
        }
      ]
    },
    {
      "when": 2,
      "title": "四期",
      "subtitle": "复印流程",
      "color": "green",
      "emoji": "🖨️",
      "blocks": [
        {
          "kind": "compare",
          "title": "分裂四期口诀",
          "items": [
            {
              "label": "前期",
              "value": "膜仁消失显两体——核膜核仁消失·染色体出现·纺锤体形成"
            },
            {
              "label": "中期",
              "value": "形定数赤齐——染色体形态最清晰·着丝点排在赤道板（观察染色体最佳时期）"
            },
            {
              "label": "后期",
              "value": "点裂数加均两极——着丝点分裂·姐妹染色单体分开·染色体数目暂时加倍·被拉向两极"
            },
            {
              "label": "末期",
              "value": "两消两现重开始——染色体变回染色质·核膜核仁重现·细胞一分为二"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🧬",
          "title": "质检与误差",
          "text": "纺锤丝「牵错」→染色体不均分→子细胞异常（癌症相关）；「检查点」机制卡在关键步骤等质检通过——细胞周期调控是抗癌药物的重要靶点（抑制分裂过快）"
        },
        {
          "kind": "highlight",
          "text": "膜仁消失显两体·点裂数加均两极——两期口诀记牢"
        }
      ]
    },
    {
      "when": 3,
      "title": "实验",
      "subtitle": "洋葱根尖",
      "color": "amber",
      "emoji": "🔬",
      "blocks": [
        {
          "kind": "steps",
          "title": "观察实验四步",
          "items": [
            "取材：洋葱根尖（分生区·分裂旺盛）",
            "解离：盐酸酒精使细胞分散固定（细胞已死·定格各期）",
            "染色：龙胆紫或醋酸洋红染染色体",
            "压片镜检：找分生区（细胞方形紧密）·辨认各期图像——一张切片看尽复印流程"
          ]
        },
        {
          "kind": "info",
          "icon": "🔬",
          "title": "一个常见误区",
          "text": "看到的细胞是「定格」的——解离已杀死细胞·不能追踪同一个细胞的变化：要看「不同细胞的不同时期」拼出动态过程：理解实验原理·才知道看到的是什么"
        },
        {
          "kind": "highlight",
          "text": "解离时细胞已死——看的是快照拼不出动画"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "细胞周期",
        "body": "【间期】>90%·DNA复制蛋白合成。\n【染色质↔染色体】毛线与线团。\n【检查点】质量控制系统。"
      },
      {
        "title": "四期口诀",
        "body": "【前】膜仁消失显两体。【中】形定数赤齐（观察佳期）。\n【后】点裂数加均两极。【末】两消两现重开始。"
      },
      {
        "title": "实验",
        "body": "【四步】取材·解离·染色·压片。\n【注意】解离已杀死·快照非动画。\n【材料】洋葱根尖分生区。"
      }
    ],
    "examples": [
      {
        "q": "辨认显微镜下的中期细胞",
        "steps": [
          "染色体形态清晰",
          "着丝点整齐排在赤道板",
          "数目最好数",
          "即中期"
        ],
        "tip": "数染色体选中期"
      },
      {
        "q": "为什么选根尖作材料",
        "steps": [
          "分生区细胞分裂旺盛",
          "易找到各期图像",
          "伸长区成熟区分裂少",
          "材料决定成功率"
        ],
        "tip": "找「打印机」所在"
      }
    ],
    "mistakes": [
      "认为分裂期占细胞周期大部分（间期>90%）",
      "染色单体分开后还叫染色单体（已成为染色体）"
    ]
  },
