  "teach": {
    "sections": [
      {
        "title": "章法",
        "body": "【章法=整幅字的布局安排：字距、行距、正文+款识+印章的整体】\n常见幅式：中堂、条幅、对联、扇面、斗方。\n核心原则：计白当黑——空白处也是构图；首字管全篇（第一个字定大小基调）。"
      },
      {
        "title": "落款",
        "body": "【内容：时间（乙巳年秋月）+地点（可省）+姓名+谦词（书/录/撰）】\n规矩：款字小于正文；双款（上款送人+下款署名）分上下；位置在正文之后偏下，不喧宾夺主。\n农历纪年雅致：乙巳年、仲春、腊月。"
      },
      {
        "title": "钤印",
        "body": "【名章：白文（字白底红）盖在款字之后，压角稳全局】\n【闲章：朱文引首章盖右上角起首处——内容雅趣（墨趣、静观）】\n规矩：印不过三；大小与款字相当；名章闲章一白一朱相映。\n红印是黑白世界里唯一的颜色——点睛之笔。"
      }
    ],
    "examples": [
      {
        "q": "一幅字显憋闷，最可能的问题？",
        "steps": [
          "看行距是否太挤",
          "看四边留白是否太窄",
          "调整疏密与留白",
          "字本身没问题也显闷"
        ],
        "tip": "透气感在留白"
      },
      {
        "q": "给作品写落款：乙巳年秋天，李明书写。",
        "steps": [
          "时间雅称：乙巳之秋/乙巳秋月",
          "姓名+谦词：李明书",
          "组合：乙巳秋月 李明书",
          "字要小于正文写在末行下方"
        ],
        "tip": "时间+姓名+谦词"
      }
    ],
