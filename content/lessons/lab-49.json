  "teach": {
    "sections": [
      {
        "title": "断舍离",
        "body": "【断】不买不需要。【舍】处理用不上。\n【离】不执着物品。\n【难点】损失厌恶·万一心理·纪念意义。"
      },
      {
        "title": "三箱法",
        "body": "【三箱】保留·转赠·告别。\n【两问】一年用过吗·下月用吗。\n【纪念品】拍照留·宝物盒留三五件。"
      },
      {
        "title": "维持",
        "body": "【铁律】一进一出。\n【节奏】季度一小时小整理。\n【环保】少买=省水少垃圾。"
      }
    ],
    "examples": [
      {
        "q": "书桌抽屉塞满了",
        "steps": [
          "全部摊开在桌面",
          "三箱分流：常用留下",
