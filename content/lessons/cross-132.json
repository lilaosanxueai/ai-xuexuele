  "teach": {
    "sections": [
      {
        "title": "家庭电路的组成",
        "body": "【进户线（火线/零线）→ 电能表 → 总开关 → 保险丝 → 用电器】\n家庭电路电压 220V；火线与零线间 220V。\n测电笔：接触火线氖管发光。"
      },
      {
        "title": "保险丝与空气开关",
        "body": "【电流过大时：保险丝发热熔断 / 空气开关跳闸，自动切断电路】\n电流过大两个原因：短路（电流剧增）、过载（用电器总功率过大）。\n铜丝铁丝代替保险丝 = 重大隐患！"
      },
      {
        "title": "安全用电",
        "body": "【不接触低压带电体、不靠近高压带电体】\n湿手不碰开关（水导电）；不弄湿用电器；破损电线及时换。\n三孔插座的第三个孔接地——防止外壳带电伤人。"
      }
    ],
    "examples": [
      {
        "q": "家里同时使用 2000W 电磁炉和 1500W 空调，总电流多大？会怎样？（保险限额 10A）",
        "steps": [
          "总功率 P = 2000 + 1500 = 3500W",
          "I = P/U = 3500 ÷ 220 ≈ 15.9A",
          "超过 10A 限额",
          "空气开关跳闸（保护电路）"
        ],
        "tip": "先算总功率再除以 220V"
      },
      {
        "q": "为什么不能用铜丝代替保险丝？",
        "steps": [
          "保险丝电阻大熔点低，超流时先熔断",
          "铜丝电阻小熔点高，超流也不熔断",
          "失去保护作用，可能烧毁线路引发火灾"
        ],
        "tip": "保险丝是\"用自己熔断保护全家的牺牲者\""
      }
    ],
    "mistakes": [
      "认为零线碰了没事（零线在特定情况下也危险）",
      "用铜丝铁丝代替保险丝"
    ]
