  "teach": {
    "sections": [
      {
        "title": "三份法",
        "body": "【花】30%——计划内消费不内疚。\n【存】50%——大件目标。\n【帮】20%——礼物和捐赠。"
      },
      {
        "title": "储蓄目标",
        "body": "【四步】写目标→算时间→画进度→庆祝。\n【等待】有目标的等待叫\"攒\"。"
      },
      {
        "title": "分享",
        "body": "【礼物】给家人的心意。\n【捐助】改变别人的100元。\n【意义】钱的价值=让谁变好。"
      }
    ],
    "examples": [
      {
        "q": "收到1500元压岁钱",
        "steps": [
          "消费份：450元",
          "储蓄份：750元",
