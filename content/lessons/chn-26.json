  "teach": {
    "sections": [
      {
        "title": "倾听的姿态",
        "body": "【眼睛看对方、身体朝对方、手空下来（不摆弄文具玩具）】\n不插话、不抢答、听到最后。\n点头微笑是最好的无声鼓励。\n姿态对了，对方才愿意把话说完。"
      },
      {
        "title": "听懂要点",
        "body": "【边听边抓关键词：谁？什么时间？做什么？要求是什么？】\n听老师布置：记\"时间+任务+方式\"三要素。\n听故事发言：记\"起因—经过—结果\"。\n听不懂马上记下来，等对方说完再问。"
      },
      {
        "title": "有回应的听",
        "body": "【复述式回应：我听到你说……（确认没听错）】\n【提问式回应：我想问……（把不懂的问清）】\n【共情式回应：听起来你很……（先接情绪）】\n倾听不是沉默——有来有回才是真正的交流。"
      }
    ],
    "examples": [
      {
        "q": "同学发言时你在折纸飞机，对吗？",
        "steps": [
          "手没空下来，心也不在",
          "放下手里的东西",
          "眼睛看向发言的同学",
          "听完再举手补充"
        ],
        "tip": "手空眼看"
      },
      {
        "q": "老师说\"周五交观察日记，不少于三句话\"，你要记住哪些关键词？",
        "steps": [
          "时间：周五",
          "任务：观察日记",
          "要求：不少于三句话",
          "三要素缺一不可"
        ],
        "tip": "时+事+要求"
      }
    ],
    "mistakes": [
      "听到一半就插嘴（听完整是底线）",
      "不懂装懂点头（该问就问）"
