  "title": "平面向量与数量积",
  "emoji": "➡️",
  "textbook": "人教A版数学（必修二）",
  "curriculum": {
    "module": "平面向量",
    "points": [
      "向量的概念与运算",
      "数量积",
      "向量的应用"
    ]
  },
  "story": "「向东北走 5 公里」——既有大小又有方向的量就是向量。物理学把它当语言（力·速度·加速度），数学把它当工具（数形结合的桥）：数量积一算·角度和长度全出来。",
  "goals": [
    "掌握向量的线性运算",
    "掌握数量积",
    "用向量解几何问题"
  ],
  "aiIntro": "➡️ 有方向的量——平面向量",
  "param": {
    "name": "vc",
    "label": "向量站",
    "min": 1,
    "max": 3,
    "step": 1,
    "value": 1
  },
  "explore": [
    "向量怎样加减？",
    "数量积算出什么？",
    "怎样证明垂直？"
  ],
  "views": [
    {
      "when": 1,
      "title": "运算",
      "subtitle": "几何与坐标",
      "color": "blue",
      "emoji": "🧭",
      "blocks": [
        {
          "kind": "compare",
          "title": "两类运算",
          "items": [
            {
              "label": "加减（三角形/平行四边形法则）",
              "value": "位移的合成——a+b 首尾相接：A→B→C 等于 A→C；坐标版：(x₁,y₁)+(x₂,y₂)=(x₁+x₂, y₁+y₂)"
            },
            {
              "label": "数乘",
              "value": "λa：伸缩（|λ|>1 放大）+ 反向（λ<0 掉头）：共线的判定 λa∥b ⇔ x₁y₂−x₂y₁=0"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "⚖️",
          "title": "向量是「自动记账」",
          "text": "物理里的合力·位移合成·速度分解——全部是向量加法：既管大小又管方向·一笔算清两个信息：标量要算两遍的事·向量一遍搞定"
        },
        {
          "kind": "highlight",
          "text": "加减=位移合成·数乘=伸缩换向——共线看 x₁y₂−x₂y₁"
        }
      ]
    },
    {
      "when": 2,
      "title": "数量积",
      "subtitle": "角度探测器",
      "color": "green",
      "emoji": "📐",
      "blocks": [
        {
          "kind": "info",
          "icon": "📜",
          "title": "定义与坐标式",
          "text": "a·b = |a||b|cosθ——一个数（所以叫「数量」积）：坐标版 a·b = x₁x₂ + y₁y₂：长度和角度的信息压缩进一个乘法"
        },
        {
          "kind": "compare",
          "title": "三大应用",
          "items": [
            {
              "label": "求角",
              "value": "cosθ = a·b / (|a||b|)——夹角一步到位"
            },
            {
              "label": "证垂直",
              "value": "a⊥b ⇔ a·b = 0 ⇔ x₁x₂+y₁y₂=0：垂直判定变成一次乘加·快到飞起"
            },
            {
              "label": "求模长",
              "value": "|a|² = a·a = x²+y²——模长也是数量积的特例"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "💡",
          "title": "物理原型：功",
          "text": "W = F·s·cosθ——力做的功就是力向量与位移向量的数量积：数学公式直接来自物理：数量积是「有效分量」的度量（力只有沿位移方向的分量才做功）"
        },
        {
          "kind": "highlight",
          "text": "a·b=0 即垂直——角度与长度一积全知"
        }
      ]
    },
    {
      "when": 3,
      "title": "应用",
      "subtitle": "数形之桥",
      "color": "violet",
      "emoji": "🌉",
      "blocks": [
        {
          "kind": "steps",
          "title": "向量法解几何",
          "items": [
            "设坐标：把几何图形放进坐标系（选直角·让顶点坐标整齐）",
            "向量表示：边·线段全部写成向量坐标",
            "翻译条件：垂直→数量积为 0·共线→交叉相乘相等·等长→模相等",
            "代数运算出结论——几何证明变成计算：会算就会证"
          ]
        },
        {
          "kind": "info",
          "icon": "🚀",
          "title": "为什么重要",
          "text": "向量是「代数与几何的翻译官」——解析几何·立体几何（math-107 空间向量）·物理·计算机图形学（游戏里每个物体的朝向速度都是向量）：现代科学的地基语言"
        },
        {
          "kind": "info",
          "icon": "🎮",
          "title": "游戏里的向量",
          "text": "角色移动方向·子弹轨迹·碰撞检测·视角朝向——游戏引擎每帧做百万次向量运算：你玩过的每一款 3D 游戏·背后都是本节课的公式在跑"
        },
        {
          "kind": "highlight",
          "text": "设坐标→向量表示→翻译条件→计算——会算就会证"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "线性运算",
        "body": "【加】三角形法则·坐标相加。【数乘】伸缩反向。\n【共线】x₁y₂−x₂y₁=0。\n【原型】合力·位移合成。"
      },
      {
        "title": "数量积",
        "body": "【定义】a·b=|a||b|cosθ=x₁x₂+y₁y₂。\n【求角】除以模之积。【垂直】数量积=0。\n【模】|a|²=a·a。【物理】功。"
      },
      {
        "title": "向量法",
        "body": "【四步】设坐标→表示→翻译（垂直/共线/等长）→计算。\n【地位】代数几何翻译官·游戏引擎在跑。"
      }
    ],
    "examples": [
      {
        "q": "a=(1,2)，b=(3,−1) 求 a·b",
        "steps": [
          "坐标乘加",
          "1×3+2×(−1)",
          "=3−2",
          "=1"
        ],
        "tip": "x·x+y·y"
      },
      {
        "q": "证明 A(0,0) B(2,1) C(4,−3) 中 ∠A 是直角",
        "steps": [
          "AB=(2,1)·AC=(4,−3)",
          "AB·AC=8−3=5≠0",
          "咦·不是直角",
          "换成 AB·BC：2×2+1×(−4)=0 √"
        ],
        "tip": "换对向量再验"
      }
    ],
    "mistakes": [
      "数量积忘了除以模积求角（a·b 不是 cosθ 本身）",
      "把向量加法算成模长相加（|a+b|≠|a|+|b| 除非同向）"
    ]
  },
