  "teach": {
    "sections": [
      {
        "title": "队列基本口令",
        "body": "【立正/稍息】开机与待机。\n【看齐】向左·向右·向前看齐——转头·碎步·站定。\n【报数】短促响亮·头不动。\n【行进】齐步走——左脚先出·摆臂自然。"
      },
      {
        "title": "动作要领",
        "body": "【立正】三直：腿直·背直·颈直；二平：肩平·眼平。\n【看齐】参照物=前面同学的耳朵；调整=小碎步。\n【距离】前后一臂·左右一拳（做操要一臂间隔）。"
      },
      {
        "title": "队列与集体",
        "body": "【仪式】升旗·开学典礼——队伍是庄严感的一部分。\n【安全】行进·集合·疏散的秩序保障。\n【品质】专注·协同·为他人着想——队列是最好的集体主义体验课。"
      }
    ],
    "examples": [
      {
        "q": "向左看齐时发现自己靠后了怎么办？",
        "steps": [
          "头保持看左前",
          "小碎步快速跟上",
          "对齐排面立刻站定",
          "不跳不跑不东张西望"
        ],
        "tip": "碎步是队列的微调器"
      },
      {
        "q": "为什么老师喜欢让稳的同学当排头？",
        "steps": [
          "排头是全排的参照物",
          "他动一下全排跟着歪",
          "排头稳=基准稳",
          "所以排头是信任不是官职"
        ],
        "tip": "基准的价值"
      }
    ],
    "mistakes": [
      "认为看齐看后脑勺（耳朵才是纵向参照线）",
      "认为队列就是\"罚站\"（它是安全协议+集体礼仪的训练）"
    ]
  },
