  "teach": {
    "sections": [
      {
        "title": "家庭结构变迁",
        "body": "【扩展家庭→核心家庭】原因：工业化城市化（人口流动）·生育率下降·个人主义上升。\n中国独生子女一代（80后90后）创造了史上最多\"421结构\"：4老人+2父母+1孩子。"
      },
      {
        "title": "家庭功能",
        "body": "经济支持·情感港湾·社会化·抚育赡养。\n学校和社会可以部分替代（学校教育·社会保障），但情感功能永远无法被替代。"
      },
      {
        "title": "尊重多元",
        "body": "法律保护各种形态的家庭；道德要求我们不用\"正常/不正常\"评判别人的家。\n一个家的健康指标：沟通是否畅通·情绪是否安全·冲突是否能修复。"
      }
    ],
    "examples": [
      {
        "q": "为什么以前家庭大？",
        "steps": [
          "农业社会需要大量劳动力",
          "没有社保，养儿防老",
          "死亡率高，多生保障存活",
          "聚族而居的土地绑定"
        ],
        "tip": "结构是环境的答案"
      },
      {
        "q": "同学家只有妈妈，你会怎么对待？",
        "steps": [
          "不追问不猎奇",
          "不叫\"没爸爸的\"",
          "正常来往：约他玩·聊共同话题",
          "如果他想聊家事就认真听"
        ],
        "tip": "尊重从\"不当回事\"开始"
      }
    ],
    "mistakes": [
      "认为小家庭比大家庭\"更好\"（各有优劣，是环境选择的结果）",
      "认为单亲家庭的孩子\"有问题\"（关键看爱的质量不是人数）"
    ]
  },
