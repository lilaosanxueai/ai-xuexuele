  "starterCode": "# 幂运算法则探索台\nn = 2   # 指数 n\nm = 3   # 指数 m\n\nhide()\n# 四个幂的柱高对比（以 2 为底）\nh1 = n * 16\nh2 = m * 16\nh3 = (n + m) * 16\nh4 = n * m * 16\nfill_rect(-170, -80 + h1 / 2, 44, h1, \"#93c5fd\")\nwrite(\"2^\" + n, -170, -100, \"#1d4ed8\", 11)\nfill_rect(-90, -80 + h2 / 2, 44, h2, \"#93c5fd\")\nwrite(\"2^\" + m, -90, -100, \"#1d4ed8\", 11)\nfill_rect(0, -80 + h3 / 2, 44, h3, \"#86efac\")\nwrite(\"2^\" + (n + m), 0, -100, \"#15803d\", 11)\nfill_rect(100, -80 + h4 / 2, 44, h4, \"#fdba74\")\nwrite(\"2^\" + n * m, 100, -100, \"#b45309\", 11)\nwrite(\"乘：2^n × 2^m = 2^(n+m) = 2^\" + n + m, -190, 140, \"#16a34a\", 12)\nwrite(\"乘方：(2^n)^m = 2^(n×m) = 2^\" + n * m, -190, 115, \"#ea580c\", 12)\nwrite(\"同底数幂相乘 → 指数相加\", -190, 90, \"#1d4ed8\", 12)\nwrite(\"幂的乘方 → 指数相乘\", -190, 65, \"#1d4ed8\", 12)\nwrite(\"除法：2^n ÷ 2^m = 2^(n−m) = 2^\" + (n - m), -190, 40, \"#0369a1\", 12)\n",
