  "teach": {
    "sections": [
      {
        "title": "同底数幂的乘除",
        "body": "【aⁿ · aᵐ = aⁿ⁺ᵐ；aⁿ ÷ aᵐ = aⁿ⁻ᵐ（a≠0）】\n10²×10³ = 10⁵：3 个 10 乘 2 个 10 共 5 个 10 相乘。\n底数必须相同才能用；底数不变，指数加减。"
      },
      {
        "title": "幂的乘方与积的乘方",
        "body": "【(aⁿ)ᵐ = aⁿᵐ；(ab)ⁿ = aⁿbⁿ】\n(2³)² = 2⁶：三个 2 一组，共两组 → 6 个 2。\n注意区分：aⁿ·aᵐ 是\"加\"，(aⁿ)ᵐ 是\"乘\"——看运算是乘法还是乘方。"
      },
      {
        "title": "零指数与推广",
        "body": "【a⁰ = 1（a≠0）】\n由除法法则：aⁿ÷aⁿ = a⁰，又等于 1。\n负整数指数：a⁻ⁿ = 1/aⁿ（如 2⁻² = 1/4）。\n科学记数法的理论基础就在这里。"
      }
    ],
    "examples": [
      {
        "q": "计算：x³ · x⁵ ÷ x⁶",
        "steps": [
          "同底数幂相乘：x³·x⁵ = x⁸",
          "再除：x⁸ ÷ x⁶",
          "= x²"
        ],
        "tip": "从左往右逐步算，指数先加后减"
      },
      {
        "q": "计算：(a²)³ · a⁴",
        "steps": [
          "幂的乘方：(a²)³ = a⁶",
          "同底相乘：a⁶ · a⁴",
          "= a¹⁰"
        ],
        "tip": "先算括号里的乘方，再做乘法"
      }
    ],
    "mistakes": [
      "a³·a² 算成 a⁶（指数应相加得 a⁵）",
      "(a³)² 与 a³·a² 混淆：前者指数相乘 a⁶，后者相加 a⁵"
    ]
  },
