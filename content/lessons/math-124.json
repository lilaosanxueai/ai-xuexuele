  "views": [
    {
      "when": 1,
      "title": "裂项",
      "subtitle": "拆开相消",
      "color": "blue",
      "emoji": "✂️",
      "blocks": [
        {
          "kind": "info",
          "icon": "📜",
          "title": "基本模式",
          "text": "分母是两项相乘时——1/[n(n+1)] = 1/n − 1/(n+1)：一项拆成两项之差·求和时中间项全部抵消——只剩头和尾：像多米诺骨牌依次倒下"
        },
        {
          "kind": "steps",
          "title": "经典一例",
          "items": [
            "S = 1/(1×2) + 1/(2×3) + … + 1/[n(n+1)]",
            "每项裂开 = (1/1−1/2)+(1/2−1/3)+…+(1/n−1/(n+1))",
            "中间项 ±1/2·±1/3…全部成对抵消",
            "S = 1 − 1/(n+1) → n→∞ 时 S→1：一列消去·答案自现"
          ]
        },
        {
          "kind": "info",
          "icon": "🎯",
          "title": "常见裂项模板",
          "text": "1/[n(n+k)] → (1/k)[1/n − 1/(n+k)]；1/[√n+√(n+1)] → √(n+1)−√n（分母有理化也是裂项）：识别分母「两因子之差恰与分子相关」——就上裂项"
        },
        {
          "kind": "highlight",
          "text": "拆成差·中间消——只剩头尾"
        }
      ]
    },
    {
      "when": 2,
      "title": "错位",
      "subtitle": "差比数列",
      "color": "green",
      "emoji": "↔️",
      "blocks": [
        {
          "kind": "steps",
          "title": "错位相减五步",
          "items": [
            "识别：等差×等比（如 aₙ = n·2ⁿ）——「差比数列」",
            "写 Sₙ = 1·2 + 2·2² + 3·2³ + … + n·2ⁿ",
            "两边乘公比：2Sₙ = 1·2² + 2·2³ + … + n·2ⁿ⁺¹",
            "两式错位相减（同幂对齐）：大部分项消去",
            "解出 Sₙ——剩下首尾几项·一算即得"
          ]
        },
        {
          "kind": "info",
          "icon": "⚠️",
          "title": "两个易错点",
          "text": "①相减时最后一项 n·2ⁿ⁺¹ 别漏（它是「多出来的尾巴」）；②除以 (1−q) 时符号——除以负数要变号：错位相减的失分九成在这两处"
        },
        {
          "kind": "highlight",
          "text": "差比结构→乘公比→错位减——盯住尾巴"
        }
      ]
    },
    {
      "when": 3,
      "title": "识别",
      "subtitle": "选对武器",
      "color": "amber",
      "emoji": "🧭",
      "blocks": [
        {
          "kind": "compare",
          "title": "三大求和策略",
          "items": [
            {
              "label": "裂项相消",
              "value": "信号：分母两因子相乘（且差可通分子）；本质：拆差抵消"
            },
            {
              "label": "错位相减",
              "value": "信号：等差×等比；本质：乘公比构造相同结构"
            },
            {
              "label": "分组求和",
              "value": "信号：奇偶项规律不同或可拆成等差+等比；本质：拆开各算各的再合"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🧠",
          "title": "更高一层",
          "text": "所有求和技巧的哲学：不是「硬加」而是「改造结构让项自我抵消」——化归思想的巅峰：考试看到 Sₙ 别急着算·先花 30 秒识别类型·选对武器再动手"
        },
        {
          "kind": "highlight",
          "text": "看结构选方法——改造结构让项自己消"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "裂项相消",
        "body": "【模板】1/[n(n+1)]=1/n−1/(n+1)。\n【推广】1/[n(n+k)]=(1/k)(1/n−1/(n+k))。\n【结果】中间消·剩头尾。"
      },
      {
        "title": "错位相减",
        "body": "【对象】等差×等比（差比数列）。\n【五步】写和·乘公比·错位减·解出·验尾项。\n【易错】漏尾项·除负变号。"
      },
      {
        "title": "识别策略",
        "body": "【分母积】裂项。【差×比】错位减。\n【奇偶异】分组。核心：改造结构促消。"
      }
    ],
    "examples": [
      {
        "q": "求 1/(1×2)+…+1/(9×10)",
        "steps": [
          "裂项：(1/1−1/2)+…+(1/9−1/10)",
          "中间全消",
          "1 − 1/10",
          "= 9/10"
        ],
        "tip": "头尾之差"
      },
      {
        "q": "求 S=1+2·2+3·2²+…+n·2ⁿ⁻¹",
        "steps": [
          "差比结构→错位相减",
          "2S=2+2·2²+…+n·2ⁿ",
          "相减得 −S=1+(2+…+2ⁿ⁻¹)−n·2ⁿ",
          "S=(n−1)2ⁿ+1"
        ],
        "tip": "盯尾项"
      }
    ],
    "mistakes": [
      "裂项时系数忘了乘 1/k（差不是1）",
      "错位相减漏掉最后一项或多减一项"
    ]
  },
