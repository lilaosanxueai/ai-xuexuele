  "teach": {
    "sections": [
      {
        "title": "记账方法",
        "body": "【分类】需要/想要/储蓄三分法。\n【记录】当场记·工具不限。\n【复盘】周复盘看结构——看见即改变。"
      },
      {
        "title": "预算编制",
        "body": "【三桶】固定桶·自由桶（设上限）·未来桶（先存后花）。\n【调整】超支是数据：滚动修正。\n【原则】先储蓄后消费。"
      },
      {
        "title": "资金规划与红线",
        "body": "【压岁钱】长钱+目标专款+月度分摊+自由金。\n【红线】不借贷消费·不信\"代客理财\"。\n【素养】零花钱是成本最低的理财练习场。"
      }
    ],
    "examples": [
      {
        "q": "月零花 300 元总是月中见底，怎样破？",
        "steps": [
          "记账两周看清去向",
          "三桶法：固定120·自由120·存60",
          "自由桶周上限30",
          "周日复盘微调"
        ],
        "tip": "仪表盘先行"
      },
      {
        "q": "同学拉你拼单买千元球鞋\"分期无息\"",
        "steps": [
          "红线：不碰分期",
          "三问：需要吗值吗被裹挟吗",
          "目标专款：想买就列储蓄计划",
          "等攒够——可能就不想要了"
        ],
        "tip": "延迟过滤冲动"
      }
    ],
    "mistakes": [
      "认为记账=抠门（是知情权不是吝啬）",
      "预算定得一点弹性没有（崩了就放弃——要留自由金）"
    ]
  },
