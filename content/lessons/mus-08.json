  "teach": {
    "sections": [
      {
        "title": "弦乐：乐队的地基",
        "body": "【小提琴（高音皇后）、中提琴（温厚）、大提琴（深情男中音）、低音提琴（深沉基石）】\n弦乐靠弓摩擦琴弦发声，揉弦带来歌唱性。\n人数占全团一半以上，是乐团的\"主唱天团\"。"
      },
      {
        "title": "木管与铜管",
        "body": "【木管：长笛（清亮）、双簧管（田园）、单簧管（圆润）、大管（幽默低音）——以吹孔/簧片发声，材质早已不限于木头】\n【铜管：小号（嘹亮）、圆号（圆润防洪）、长号（庄严滑音）、大号（低音巨兽）——嘴唇振动发声】\n双簧管负责开场对音：全团以它的 A 音为准。"
      },
      {
        "title": "打击乐与席位",
        "body": "【定音鼓是打击乐队长：可调音高，掌控节奏与气势】【小军鼓、镲、三角铁点缀色彩】\n席位：指挥正前方是弦乐，其后木管居左、铜管居右，打击乐最后排。\n指挥是\"声音的交通警察\"。"
      }
    ],
    "examples": [
      {
        "q": "音乐会开场前全团对音听谁的？",
        "steps": [
          "双簧管先吹出标准音 A",
          "其他乐器依次对准",
          "因为双簧管音准最稳定",
          "这是百年传统"
        ],
        "tip": "双簧管=A音"
      },
      {
        "q": "听到辉煌嘹亮、气势磅礴的旋律，大概率是？",
        "steps": [
          "音色特征：明亮有力",
          "铜管家族擅长强奏",
          "小号/长号齐鸣的高潮段落",
          "答案：铜管家族"
        ],
        "tip": "按音色认家族"
      }
    ],
    "mistakes": [
      "认为长笛是铜管（按发声原理归类木管）",
      "认为打击乐只是敲敲打打（定音鼓可调音高）"
    ]
