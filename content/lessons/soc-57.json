  ],
  "views": [
    {
      "when": 1,
      "title": "家的样子",
      "subtitle": "大调查",
      "color": "blue",
      "emoji": "📊",
      "blocks": [
        {
          "kind": "compare",
          "title": "三种常见家",
          "items": [
            {
              "label": "两代之家",
              "value": "爸爸+妈妈+孩子（三口/四口）：最常见的「标准像」——但只是其中一种"
            },
            {
              "label": "三代同堂",
              "value": "爷爷奶奶爸妈孩子住一起：热闹有依靠——传统「大家庭」的样子"
            },
            {
              "label": "单亲之家",
              "value": "爸爸或妈妈一个人带孩子：爱不减半·只是人少一点——同样完整的爱"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🌍",
          "title": "还有更多样子",
          "text": "和祖辈生活的·爸妈在国外工作的·重组家庭（新的爸爸妈妈+孩子）·领养家庭：世界上的家就像树叶——没有两片完全一样"
        },
        {
          "kind": "highlight",
          "text": "两代·三代·单亲·重组——都是家的正常样子"
        }
      ]
    },
    {
      "when": 2,
      "title": "家的共同点",
      "subtitle": "万变不离其宗",
      "color": "amber",
      "emoji": "❤️",
      "blocks": [
        {
          "kind": "info",
          "icon": "🍚",
          "title": "三样东西都有",
          "text": "①有人照顾你长大；②有个地方回（房子或出租屋都算）；③彼此牵挂——生病时着急·进步时开心：家的定义不写在户口本上·写在这三样里"
        },
        {
          "kind": "info",
          "icon": "🧩",
          "title": "家的本质是关系",
          "text": "家不是「必须爸爸妈妈孩子三件套」——是一群人选择互相照顾：所以单亲家庭的爱不少·重组家庭的爱不假·领养家庭的爱不掺水：爱是唯一的度量衡"
        },
        {
          "kind": "highlight",
          "text": "照顾+归属+牵挂——家的三条底线，跟人数无关"
        }
      ]
    },
    {
      "when": 3,
      "title": "尊重不同",
      "subtitle": "嘴下留情",
      "color": "green",
      "emoji": "🤝",
      "blocks": [
        {
          "kind": "info",
          "icon": "🤐",
          "title": "三句话不说",
          "text": "「你没有爸爸/妈妈啊？」（扎心）；「你家怎么和别人不一样」（家不是标准件）；「他不是你亲的」（亲人由爱定义不由血缘独占）：好奇可以·伤人不行"
        },
        {
          "kind": "info",
          "icon": "💬",
          "title": "更好的问法",
          "text": "想了解同学的家：先分享自己的（「我家是……你家呢？」）；同学不想说就不追问——每个家都有自己的故事·说与不说由TA定：尊重=给对方选择权"
        },
        {
          "kind": "highlight",
          "text": "好奇不越界——先分享·不追问·不说刺"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "家的样子",
        "body": "【常见】两代·三代·单亲。\n【更多】重组·领养·跨国家庭。\n【结论】没有两片相同的树叶。"
      },
      {
        "title": "家的共同点",
        "body": "【三样】照顾·归属·牵挂。\n【本质】关系不是人数配置。\n【度量】爱是唯一单位。"
      },
      {
        "title": "尊重不同",
        "body": "【三不说】不戳痛处不比较不质疑。\n【会问】先分享自己。\n【边界】不想说不追问。"
      }
    ],
    "examples": [
      {
        "q": "同学说「我和妈妈住」",
        "steps": [
          "平常回应：哦～和我家不太一样",
          "不追问爸爸的事",
          "照常约他玩",
          "需要时说他可以找你聊"
        ],
        "tip": "平常心就是尊重"
      },
      {
        "q": "画「我的家」",
        "steps": [
          "画住在一起的人",
          "写每人一个特点",
          "分享时只讲开心的部分",
          "听别人讲不插嘴比较"
        ],
        "tip": "每个家都值得鼓掌"
      }
    ],
    "mistakes": [
      "以为只有「爸妈+孩子」才算家（照顾+归属+牵挂就是家）",
      "拿同学家庭情况开玩笑（那不是玩笑是伤害）"
    ]
  },
