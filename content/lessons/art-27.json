  ],
  "views": [
    {
      "when": 1,
      "title": "三分法",
      "subtitle": "井字格",
      "color": "sky",
      "emoji": "#",
      "blocks": [
        {
          "kind": "steps",
          "title": "怎么做",
          "items": [
            "想象画面被井字线分成九格",
            "把最重要的东西放在交叉点上",
            "不要放在正中间",
            "拍风景：地平线放在上1/3或下1/3线"
          ]
        },
        {
          "kind": "info",
          "icon": "🤔",
          "title": "为什么不放中间",
          "text": "放中间=四平八稳但呆板；放在交叉点=画面有了\"呼吸空间\"和\"动势\"——观众的眼睛会自然被吸引到那个点"
        },
        {
          "kind": "highlight",
          "text": "手机相机设置里打开\"网格线\"——照着交叉点放主体"
        }
      ]
    },
    {
      "when": 2,
      "title": "引导线",
      "subtitle": "用线条带路",
      "color": "green",
      "emoji": "📏",
