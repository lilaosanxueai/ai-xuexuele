  "teach": {
    "sections": [
      {
        "title": "构图三法则",
        "body": "【三分法】主体放交叉点·不放正中。\n【引导线】利用线条引导视线到主体。\n【留白】主体周围留空间——不要塞满画面。"
      },
      {
        "title": "光线运用",
        "body": "【最佳时段】日出后/日落前1小时——金色柔和光。\n【最差时段】正午顶光——生硬阴影。\n【特殊效果】逆光拍剪影·侧光拍质感·顺光拍色彩。"
      },
      {
        "title": "手机摄影技巧",
        "body": "【擦镜头】拍之前擦一下——指纹是画质杀手。\n【锁定对焦】点住屏幕锁定曝光——控制亮暗。\n【多拍几张】同一个场景换角度换构图多拍——选最好的。\n【后期微调】裁剪·调亮·饱和度+5——微调就好不要过度。"
      }
    ],
    "examples": [
      {
        "q": "拍同学站在花前怎么构图？",
        "steps": [
          "打开网格线",
          "人放在左边交叉点",
          "花在右侧留白处",
          "光线用侧光——脸更立体"
        ],
        "tip": "三分+侧光"
      },
      {
        "q": "怎样才能拍出有纵深感的风景？",
        "steps": [
          "找一条引导线（路·河·栏杆）",
          "线从画面底部出发",
          "延伸到远处的主体",
          "汇透视=纵深感"
        ],
        "tip": "线条带路"
      }
    ],
    "mistakes": [
      "认为好照片需要贵设备（构图和光线比设备重要100倍）",
      "认为后期可以拯救一切（前期拍好才是根本）"
    ]
  },
