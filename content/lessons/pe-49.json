  ],
  "views": [
    {
      "when": 1,
      "title": "仰漂",
      "subtitle": "先躺平",
      "color": "blue",
      "emoji": "🛟",
      "blocks": [
        {
          "kind": "steps",
          "title": "仰漂三要领",
          "items": [
            "挺：肚子向上顶·像有人拽你的下巴和脚尖往两头拉——一塌腰就沉",
            "头：耳朵浸在水里·眼睛看天花板——抬头看脚必沉：信任水",
            "慢呼吸：胸式轻呼吸——呼吸太猛身体上下颠"
          ]
        },
        {
          "kind": "steps",
          "title": "仰泳打腿",
          "items": [
            "大腿带动小腿·像鞭子一样交替上踢下压",
            "膝盖不露出水面·脚背踢水——水花「煮开」就行·别踢出喷泉",
            "脚趾绷直内旋（内八字脚）——脚背像两片桨"
          ]
        },
        {
          "kind": "highlight",
          "text": "肚子挺·耳朵进水·大腿带小腿——躺平才能漂起来"
        }
      ]
    },
    {
      "when": 2,
      "title": "划臂",
      "subtitle": "交替爬山",
      "color": "green",
      "emoji": "💪",
      "blocks": [
        {
          "kind": "steps",
          "title": "手臂循环四拍",
          "items": [
            "入水：手臂伸直·小指先入水（像翻掌切水）——在肩膀延长线上",
            "抱水：沉肘屈臂·手掌向后对水——像抱住一个大球",
            "推水：向后下方推到大腿边——前进的主要动力",
            "移臂：直臂贴耳朵出水·小指向上像跟人握手——放松不发力"
          ]
        },
        {
          "kind": "info",
          "icon": "🦀",
          "title": "配合节奏",
          "text": "六次打腿+两臂各划一次=一个循环；身体随划臂自然转动（像烤串转动）——别平板一块；呼吸最自由：嘴永远在水上·左臂移臂时吸气右臂移臂时呼气"
        },
        {
          "kind": "info",
          "icon": "🚩",
          "title": "头顶的旗线",
          "text": "泳池5米处上方的旗线是给仰泳的——过旗后数好划臂次数·到点翻身触壁：躺着看不见墙·旗线就是你的墙（初学：到旗线就减速站起来最安全）"
        },
        {
          "kind": "highlight",
          "text": "小指入水·抱推移臂·六腿两臂——躺着也稳步前进"
        }
      ]
    },
    {
      "when": 3,
      "title": "价值",
      "subtitle": "保命与安全",
      "color": "amber",
      "emoji": "🛟",
      "blocks": [
        {
          "kind": "info",
          "icon": "⚓",
          "title": "最省力的自救姿势",
          "text": "落水后体力有限——仰漂省力·呼吸自由·能坚持很久：海难幸存案例里·仰漂救过无数人。学会仰漂=随身携带救生圈"
        },
        {
          "kind": "info",
          "icon": "🦴",
          "title": "顺带治驼背",
          "text": "仰泳主要练背肌和肩后侧——正好是对抗「手机驼背」的肌群：蛙泳练胸·自由泳练肩·仰泳练背——四种泳姿是均衡的全身课表"
        },
        {
          "kind": "info",
          "icon": "⚠️",
          "title": "安全三则",
          "text": "①入水前看清身后：没人没墙再蹬壁出发②泳池边永远走不跑（湿滑）③在开放水域必须有人陪护·仰泳看不见前方障碍——安全永远是第一课"
        },
        {
          "kind": "highlight",
          "text": "省力保命+治驼背——但先看清身后的墙"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "仰漂打腿",
        "body": "【要领】肚子挺·耳朵入水·看天花板。\n【打腿】大腿带小腿·膝盖不出水。\n【脚】绷直内八字·脚背做桨。"
      },
      {
        "title": "划臂配合",
        "body": "【四拍】小指入水-抱水-推水-移臂。\n【节奏】六腿两臂·身体像烤串转。\n【旗线】5米旗=你的墙。"
      },
      {
        "title": "价值安全",
        "body": "【自救】最省力漂浮呼吸自由。\n【体态】练背肌抗驼背。\n【三则】看清身后·池边不跑·有人陪护。"
      }
    ],
    "examples": [
      {
        "q": "仰漂总是下沉",
        "steps": [
          "肚子往上顶别塌腰",
          "头往后仰耳朵入水",
          "呼吸放轻",
          "别人托一下后背找感觉"
        ],
        "tip": "一挺一仰"
      },
      {
        "q": "仰泳总撞到池壁",
        "steps": [
          "记住5米旗线的位置",
          "过旗后开始数划臂次数",
          "数到自己的数就减速",
          "初学过旗直接站住"
        ],
        "tip": "旗线是墙"
      }
    ],
    "mistakes": [
