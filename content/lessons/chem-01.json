  "teach": {
    "sections": [
      {
        "title": "五步计算法",
        "body": "【①设未知量 ②写化学方程式 ③找相关量（相对分子质量×系数）④列比例式 ⑤求解作答】\n以 2Mg+O₂=2MgO 为例：24g 镁对应 40g 氧化镁，比例 24/40 恒定。\n方程式必须配平，这是计算的前提。"
      },
      {
        "title": "质量守恒的应用",
        "body": "【反应物总质量 = 生成物总质量】\n知道两种量即可求第三种：24g 镁燃烧需氧气 = 24×32÷24 = 32g？验证：24+16×2=56？直接算：2Mg(48)+O₂(32)=2MgO(80)，24gMg 需 O₂=24×32/48=16g，生成 MgO=40g，24+16=40 ✓。"
      },
      {
        "title": "杂质换算",
        "body": "【先算纯物质质量 = 样品质量 × 纯度，再代入方程式】\n含杂质 20% 的铁矿石 100t，纯铁只有 80t。\n结果要\"纯净物\"时同理换算回去。"
      }
    ],
    "examples": [
      {
        "q": "24g 镁在足量氧气中完全燃烧，生成氧化镁多少克？（Mg-24, O-16）",
        "steps": [
          "设生成 MgO x g",
          "2Mg + O₂ =点燃= 2MgO",
          "48………80",
          "24/x = 48/80",
          "x = 40g"
        ],
        "tip": "48=2×24，80=2×(24+16)"
      },
      {
        "q": "含氧化铁 80% 的铁矿石 100t，理论上可炼出多少铁？（Fe-56, O-16）",
        "steps": [
          "纯 Fe₂O₃ = 100×80% = 80t",
          "Fe₂O₃ + 3CO = 2Fe + 3CO₂",
          "160………112",
          "80/x = 160/112",
          "x = 56t"
        ],
        "tip": "先除杂再计算"
      }
    ],
    "mistakes": [
      "方程式未配平就开始计算",
      "忘记把样品换算成纯净物"
    ]
  },
