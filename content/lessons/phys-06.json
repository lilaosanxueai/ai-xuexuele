  "starterCode": "# 理想气体检疫站\nT = 300   # 温度（开尔文）\nV = 2     # 体积（格）\n\nhide()\np = 3.0 * T / 300 / V * 2\nw = 60 * V\nfill_rect(-w / 2, 40, w, 90, \"#eff6ff\")\npen_color(\"#1d4ed8\")\npen_down()\ngo_to(-w / 2, 40)\ngo_to(-w / 2, 130)\ngo_to(w / 2, 130)\ngo_to(w / 2, 40)\npen_up()\nfill_rect(0, 128, w + 8, 10, \"#475569\")\ni = 0\nwhile i < V * 4:\n    write(\"●\", -w / 2 + 12 + i * 13, 40 + 25 * sin(i * 90), \"#2563eb\", 10)\n    i = i + 1\nfill_rect(0, -30, 120, 44, \"#dc2626\")\nwrite(\"p = \" + p + \" atm\", 0, -30, \"#fff\", 13)\nwrite(\"活塞\", 0, 138, \"#334155\", 9)\nfill_rect(0, 80, 20, 44, \"#94a3b8\")\nwrite(\"T=\" + T + \"K\", 40, 80, \"#dc2626\", 11)\nwrite(\"V = \" + V + \" 格\", -110, 0, \"#1d4ed8\", 12)\nfill_rect(0, -95, 360, 30, \"#7c3aed\")\nwrite(\"pV/T = 恒量：一升一降，跷跷板守恒\", 0, -95, \"#fff\", 11)\nwrite(\"微观：压强 = 大量分子不停撞击器壁的累计效果\", 0, -125, \"#0369a1\", 10)\n",
