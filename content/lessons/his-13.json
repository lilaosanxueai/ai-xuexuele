  "teach": {
    "sections": [
      {
        "title": "经济的繁荣",
        "body": "【农业】曲辕犁·筒车，垦田面积扩大。\n【手工业】蜀锦·越窑青瓷·邢窑白瓷·唐三彩。\n【商业】长安人口百万·坊市分明·国际都会。"
      },
      {
        "title": "民族交融与对外交流",
        "body": "【民族】唐太宗被尊「天可汗」；文成公主入藏带去技术与文化。\n【外交】遣唐使来华·鉴真东渡·玄奘西行。\n政策开明，交流双向。"
      },
      {
        "title": "社会风气与文学",
        "body": "【风气】昂扬进取·刚健豪迈·开放包容，妇女地位相对较高。\n【诗歌】李白「诗仙」豪放飘逸；杜甫「诗圣」反映现实。\n书法：颜真卿·柳公权·欧阳询；绘画：阎立本·吴道子。"
      }
    ],
    "examples": [
      {
        "q": "为什么说唐朝是开放的时代？",
        "steps": [
          "对外：遣唐使·东渡·西行，双向交流",
          "对内：各族「和同为一家」",
          "社会：妇女骑马穿胡服",
          "开放带来繁荣，繁荣支撑开放"
        ],
        "tip": "开放双向"
      },
      {
        "q": "李白和杜甫的诗风为何不同？",
        "steps": [
          "李白主要生活在盛唐鼎盛期",
          "时代自信豪迈，诗风浪漫奔放",
          "杜甫经历安史之乱由盛转衰",
          "诗风沉郁，记录民间疾苦"
        ],
        "tip": "诗风反映时代"
      }
    ],
    "mistakes": [
