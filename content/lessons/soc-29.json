  "teach": {
    "sections": [
      {
        "title": "互惠原则",
        "body": "【规则】收受好处→适度回报——人类社会的普遍机制。\n【功能】编织关系网·建立信任·确认群体成员身份。\n【人类学】库拉圈等经典研究：礼物创造联结。"
      },
      {
        "title": "礼物的心意学",
        "body": "【三要素】对方喜欢·用心思·合适的度。\n【侦探式倾听】把日常提及变成惊喜。\n【禁忌】攀比价格·过贵造成回礼压力。"
      },
      {
        "title": "送礼收礼礼仪",
        "body": "【收】双手接·先谢后拆·不问价格·不嫌弃。\n【送】小而准·附上手写卡片更佳。\n【边界】师生间遵守纪律·心意可以不落俗套。"
      }
    ],
    "examples": [
      {
        "q": "好朋友生日，零花钱只有10元，送什么？",
        "steps": [
          "想他喜欢什么：爱看书",
          "手绘书签+写一句话",
          "10元内买不到更\"懂他\"的了",
          "心意>价格"
        ],
        "tip": "小而准"
      },
      {
        "q": "收到不喜欢的礼物怎么表现？",
        "steps": [
          "先双手接住说谢谢",
          "谢的是心意",
          "不当面说不喜欢",
          "以后悄悄记住对方喜好"
        ],
        "tip": "护住那根线"
      }
    ],
    "mistakes": [
      "认为礼物越贵越好（价格会压弯关系的天平）",
      "认为收礼不用回礼（互惠是关系的呼吸）"
    ]
  },
