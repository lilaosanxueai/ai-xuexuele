  "teach": {
    "sections": [
      {
        "title": "河流旅程",
        "body": "【三跳】源头→中游→入海口。\n【性格】上游急切峡谷·下游宽缓拐弯。\n【规律】水只往低处走。"
      },
      {
        "title": "湖泊",
        "body": "【成因】地壳凹·火山口·旧河床。\n【淡水湖】有出口·盐分走。\n【咸水湖】只进不出·越晒越咸。"
      },
      {
        "title": "母亲河",
        "body": "【长江】最长·黄金水道。\n【黄河】带泥沙·造平原。\n【原因】有水有平地好安家。"
      }
    ],
    "examples": [
      {
        "q": "看地图找河",
        "steps": [
          "找蓝色的弯曲线",
          "线越来越粗是下游",
          "最粗的尽头是大海",
          "细的那头是源头"
        ],
        "tip": "由细到粗入海"
      },
      {
        "q": "分清淡水湖咸水湖",
        "steps": [
          "看湖有没有出口",
          "有出口水会流动",
          "咸湖只进不出",
          "青海湖就是咸的"
        ],
        "tip": "看出口"
      }
    ],
    "mistakes": [
      "以为所有湖都是淡水湖（只进不出的湖会越来越咸）",
      "以为黄河天生是黄的（是黄土高原的泥沙染黄的）"
    ]
  },
