  "views": [
    {
      "when": 1,
      "title": "三个问题",
      "subtitle": "看画秘诀",
      "color": "blue",
      "emoji": "❓",
      "blocks": [
        {
          "kind": "info",
          "icon": "1️⃣",
          "title": "画了什么？",
          "text": "先当侦探：画里有谁？在做什么？什么时间什么地方？——把画当故事看：看懂「画了什么」是第一步，不着急看懂「为什么"
        },
        {
          "kind": "info",
          "icon": "2️⃣",
          "title": "怎么画的？",
          "text": "再当工匠：颜色是亮还是暗？线条是粗还是细？东西画得像还是变形？——画家的小秘密都藏在手法里：变形不是画错，是故意的"
        },
        {
          "kind": "info",
          "icon": "3️⃣",
          "title": "我感觉到什么？",
          "text": "最后当自己：看完心里是开心·安静·紧张还是难过？——你的感受就是最好的答案：没有标准答案，说出来的都算数"
        },
        {
          "kind": "highlight",
          "text": "画了什么→怎么画的→我感觉什么——三个问题走天下"
        }
      ]
    },
    {
      "when": 2,
      "title": "三幅名画",
      "subtitle": "第一次见面",
      "color": "amber",
      "emoji": "🌟",
      "blocks": [
        {
          "kind": "compare",
          "title": "三位新朋友",
          "items": [
            {
              "label": "《蒙娜丽莎》",
              "value": "达·芬奇画：一位微笑的女士·微笑像藏了秘密（几百年来大家猜不停）：手法「晕涂法」让轮廓朦朦胧胧——像加了柔光滤镜"
            },
            {
              "label": "《星空》",
              "value": "梵高画：夜空像大漩涡在转动·星星一圈圈发光：画家生病时画的·把心里的激动全画进天空：变形的柏树像火焰冲上天"
            },
            {
              "label": "《呐喊》",
              "value": "蒙克画：桥上的人捂脸尖叫·背景的线都跟着扭动：画的是「着急害怕」这种感觉本身——颜色像尖叫一样刺"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🔍",
          "title": "用三个问题试试《星空》",
          "text": "画了什么：翻滚的夜空·安静的村庄·燃烧的柏树；怎么画的：短笔触一圈圈转·蓝黄撞色；我感觉到：激动又安静——两种感觉搅在一起"
        },
        {
          "kind": "highlight",
          "text": "微笑的谜·旋转的星·尖叫的线——每幅画一种性格"
        }
      ]
    },
    {
      "when": 3,
      "title": "说出感受",
      "subtitle": "不比对错",
      "color": "green",
      "emoji": "💬",
      "blocks": [
        {
          "kind": "info",
          "icon": "🗣️",
          "title": "感受句式",
          "text": "「我看到……（描述）」+「我觉得……因为……（感受+理由）」：例：我看到天空在转圈，我觉得有点晕，因为线条全是漩涡——这就是一句专业的画评！"
        },
        {
          "kind": "info",
          "icon": "🙅",
          "title": "可以说不喜欢",
          "text": "「我不喜欢这幅，太吵了」——完全允许！说清为什么就是鉴赏：连大评论家也吵架——感受没有标准答案·理由才是本事"
        },
        {
          "kind": "highlight",
          "text": "说出感受+讲出理由——你就是小小评论家"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "三个问题",
        "body": "【一】画了什么——当侦探。\n【二】怎么画的——当工匠。\n【三】我感觉什么——当自己。"
      },
      {
        "title": "三幅名画",
        "body": "【蒙娜丽莎】藏秘密的微笑。\n【星空】梵高转动的夜空。\n【呐喊】把害怕画出来。"
      },
      {
        "title": "说感受",
        "body": "【句式】我看到+我觉得因为。\n【权利】可以说不喜欢。\n【关键】理由比结论重要。"
      }
    ],
    "examples": [
      {
        "q": "看《星空》的步骤",
