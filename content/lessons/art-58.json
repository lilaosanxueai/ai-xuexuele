          "先找：夜空村庄柏树",
          "再看：漩涡短笔触",
          "然后问自己晕不晕",
          "最后说出感受和理由"
        ],
        "tip": "三问走天下"
      },
      {
        "q": "同学说名画丑",
        "steps": [
          "先别笑话他",
          "问他哪里觉得丑",
          "说出你看到的",
          "两种感受都对"
        ],
        "tip": "感受无对错"
      }
    ],
    "mistakes": [
