  "views": [
    {
      "when": 1,
      "title": "陌生人",
      "subtitle": "门是防线",
      "color": "amber",
      "emoji": "🚪",
      "blocks": [
        {
          "kind": "steps",
          "title": "敲门三不",
          "items": [
            "不开门：不管他说查水表·送快递·认识你爸妈——一律不开",
            "不透露：隔着门说「爸爸妈妈在忙，请稍后再来」——不说自己独自在家",
            "不轻信：真有急事·请他给爸妈打电话——爸妈没说过的人一律当陌生人"
          ]
        },
        {
          "kind": "info",
          "icon": "📞",
          "title": "电话也要防",
          "text": "陌生电话问「家里有大人在吗」——回答「在忙·您是谁有什么事」；不报地址·不说学校·不透露什么时候家里没人：电话和门一样是防线"
        },
        {
          "kind": "info",
          "icon": "🔑",
          "title": "和爸妈约暗号",
          "text": "跟爸妈定一个只有你们知道的「家庭暗号」——如果有人说「你爸妈让我来接你/取东西」·先问暗号：答不上就是假的"
        },
        {
          "kind": "highlight",
          "text": "不开门·不透露·不轻信——门和电话都是防线"
        }
      ]
    },
    {
      "when": 2,
      "title": "家中",
      "subtitle": "水电燃气",
      "color": "blue",
      "emoji": "⚠️",
      "blocks": [
        {
          "kind": "info",
          "icon": "💨",
          "title": "闻到燃气味",
          "text": "臭鸡蛋味=可能燃气泄漏：①开窗通风②关燃气总阀③千万不开灯不打火不按电器按钮（电火花会引爆）④到室外打给爸妈和燃气公司：顺序别搞错"
        },
        {
          "kind": "info",
          "icon": "🔌",
          "title": "用电安全",
          "text": "湿手不碰插座开关·不把手指或铁丝捅进插孔·一个插座别插太多电器·发现电线破了不碰并告诉爸妈——电看不见摸得着会咬人"
        },
        {
          "kind": "info",
          "icon": "🚫",
          "title": "绝对不做",
          "text": "不爬窗台阳台栏杆·不玩打火机火柴·不把小东西塞进鼻孔耳朵·不乱吃药箱里的药——独自在家时危险动作一律不做"
        },
        {
          "kind": "highlight",
          "text": "燃气臭味开窗关阀不开电——这条顺序能救命"
        }
      ]
    },
    {
      "when": 3,
      "title": "求助",
      "subtitle": "打电话",
      "color": "red",
      "emoji": "☎️",
