  "teach": {
    "sections": [
      {
        "title": "压力的双面",
        "body": "【曲线】太小散·刚好专注·太大崩。\n【机制】紧张=身体送弹药（战斗准备）。\n【目标】不是零压力是刚好。"
      },
      {
        "title": "减压三件套",
        "body": "【身体】呼吸4-6·运动放电·睡眠护底。\n【头脑】写下·变小·说出。\n【组合】身体治标头脑治本。"
      },
      {
        "title": "小升初心态",
        "body": "【期待】列3件初中想做的事。\n【话术】\"怎么办\"→\"慢慢适应\"。\n【锚点】家是退路。\n【家长】做锚不做浪。"
      }
    ],
    "examples": [
      {
        "q": "考前紧张到失眠",
        "steps": [
          "写下来：担心什么写什么",
          "呼吸4-6三轮",
          "明早比今晚多刷一套题有用",
          "睡眠护底第一"
        ],
        "tip": "先身体后头脑"
      },
      {
        "q": "一想到初中就心慌",
        "steps": [
          "写期待清单（社团·朋友）",
          "换话术：慢慢适应",
          "跟爸妈聊一次（锚点确认）",
          "心慌→期待换挡"
        ],
        "tip": "行囊换物"
      }
    ],
    "mistakes": [
      "认为压力全是坏的（刚好时是最佳状态）",
      "考前熬夜刷题牺牲睡眠（睡眠是存盘时间）"
    ]
  },
