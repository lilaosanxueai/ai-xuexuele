  "views": [
    {
      "when": 1,
      "title": "挡拆",
      "subtitle": "两人撬动全场",
      "color": "amber",
      "emoji": "🧱",
      "blocks": [
        {
          "kind": "steps",
          "title": "挡拆四变",
          "items": [
            "基本式：队友挡住防守人·持球人借掩护突破——墙+门的组合",
            "拆：掩护完立刻转身切向篮下——防守换人瞬间出现空位（挡完不拆=半套战术）",
            "假挡真切：还没贴上就反跑——防守提前绕前时致命",
            "外弹：掩护后拉出三分线——大个子会投三分时无解（现代篮球的答案）"
          ]
        },
        {
          "kind": "info",
          "icon": "🧠",
          "title": "挡拆的本质",
          "text": "制造\"二选一\"困境：防守换人则拆的人空了·不换则突破的人空了——好战术不是跑得快·是让对手怎么选都错：这就是\"以策胜力\""
        },
        {
          "kind": "highlight",
          "text": "挡拆是篮球里的国际象棋——每步都在算两步之后"
        }
      ]
    },
    {
      "when": 2,
      "title": "联防",
      "subtitle": "守区域",
      "color": "blue",
      "emoji": "🛡️",
      "blocks": [
        {
          "kind": "compare",
          "title": "2-3 联防",
          "items": [
            {
              "label": "站位",
              "value": "两人弧顶·三人篮下呈\"2-3\"——每人守一片区域而不是一个人"
            },
            {
              "label": "强项",
              "value": "护筐防突破·篮板有保证——对付突破型球队一剂猛药"
            },
            {
              "label": "命门",
              "value": "外线传球转移+底角三分——所以对手三分准时别守2-3"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🔁",
          "title": "轮转",
          "text": "球到侧翼→弱侧人收缩护筐；对手底角三分→整体轮转补位——联防不是站桩·是五个人像水一样跟着球流动"
        },
        {
          "kind": "info",
          "icon": "🆚",
          "title": "联防vs盯人",
          "text": "盯人责任清晰但怕掩护·联防省力护筐但怕投射——教练临场切换的两种武器：没有最好·只有最合适"
        },
        {
          "kind": "highlight",
          "text": "防守五个人一条心——联防的\"联\"字是灵魂"
        }
      ]
    },
    {
      "when": 3,
      "title": "阅读",
      "subtitle": "看懂比赛",
      "color": "green",
      "emoji": "👁️",
      "blocks": [
        {
          "kind": "steps",
          "title": "观赛三层",
          "items": [
            "看球：谁得分·集锦回放——最浅的一层",
            "看人：无球队员的跑位掩护——教练看的层（得分的种子在这里种下）",
            "看空间与时机：为什么这时候叫挡拆·为什么突然换联防——战术博弈的层"
          ]
        },
        {
          "kind": "info",
          "icon": "🧪",
          "title": "实践作业",
          "text": "看一场比赛只盯无球队员10分钟：你会发现80%的胜负手发生在接球之前——观赛眼力=上场意识"
        },
        {
          "kind": "highlight",
          "text": "普通人练身体·聪明人练战术——两者都练的是赢家"
        }
      ]
    }
