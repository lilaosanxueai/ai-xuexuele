  "teach": {
    "sections": [
      {
        "title": "挡拆战术",
        "body": "【四变】基本突破·顺下拆·假挡真切·外弹投。\n【本质】制造换与不换的两难。\n【时机】防守贴近·中路开阔时。\n【口诀】挡完必拆——墙与门。"
      },
      {
        "title": "区域联防",
        "body": "【2-3】护筐防突·篮板优势。\n【轮转】随球流动·弱侧收缩·底角补位。\n【克制】快速转移球+底角三分。\n【对比】盯人责任清晰怕掩护·按对手选择。"
      },
      {
        "title": "比赛阅读",
        "body": "【三层】看球→看人→看空间时机。\n【训练】盯无球队员观赛法。\n【意识】80%胜负在接球前决定。"
      }
    ],
    "examples": [
      {
        "q": "对方中锋防不出来，挡拆怎么打？",
        "steps": [
          "识别：大个子沉退护筐",
          "选择：外弹（掩护人拉出投）",
          "或持球人中距离惩罚沉退",
          "防守姿势决定你的答案"
        ],
        "tip": "看防守做选择"
      },
      {
        "q": "对手三分连中三个，防守怎么调？",
        "steps": [
          "2-3联防的命门暴露",
          "换人盯人或扩防",
          "贴死接球点",
          "防守跟着对手的特点走"
        ],
        "tip": "临场应变"
      }
    ],
    "mistakes": [
      "认为战术是职业队的事（班级赛一个挡拆就能赢一半）",
      "认为联防=站在格子里不动（轮转流动才是联防）"
    ]
  },
