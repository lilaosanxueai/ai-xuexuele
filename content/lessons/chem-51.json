  "views": [
    {
      "when": 1,
      "title": "本质",
      "subtitle": "电子转移",
      "color": "blue",
      "emoji": "⚡",
      "blocks": [
        {
          "kind": "info",
          "icon": "🧲",
          "title": "看化合价",
          "text": "反应前后化合价有升降⇒氧化还原反应：升（失电子）被氧化·降（得电子）被还原——口诀「升失氧·降得还」：化合价是电子转移的「账本」"
        },
        {
          "kind": "compare",
          "title": "四大概念对",
          "items": [
            {
              "label": "氧化反应",
              "value": "失电子·化合价升高——还原剂干的活（它被氧化）"
            },
            {
              "label": "还原反应",
              "value": "得电子·化合价降低——氧化剂干的活（它被还原）"
            },
            {
              "label": "氧化剂",
              "value": "得电子的一方（Cl₂·KMnO₄·浓硫酸……）"
            },
            {
              "label": "还原剂",
              "value": "失电子的一方（活泼金属·CO·H₂·C……）"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🧠",
          "title": "记忆锚点",
          "text": "「氧」和「还」都指反应类型·而「剂」指物质身份——氧化剂被还原·还原剂被氧化（名字恰好相反·别绕晕）：像「施救者被感谢·被救者获新生」"
        },
        {
          "kind": "highlight",
          "text": "升失氧·降得还——化合价是电子的账本"
        }
      ]
    },
    {
      "when": 2,
      "title": "守恒",
      "subtitle": "电子不凭空",
      "color": "green",
      "emoji": "⚖️",
      "blocks": [
        {
          "kind": "info",
          "icon": "🔢",
          "title": "电子守恒",
          "text": "失电子总数 = 得电子总数（电子不会凭空产生或消失）——这是配平氧化还原方程式的黄金法则：也是快速计算（不写方程直接算）的利器"
        },
        {
          "kind": "steps",
          "title": "守恒法配平一例",
          "items": [
            "MnO₄⁻ + Fe²⁺ → Mn²⁺ + Fe³⁺（酸性）",
            "Mn：+7→+2 得 5e⁻；Fe：+2→+3 失 1e⁻",
            "最小公倍数 5：1 个 Mn⁷⁺ 配 5 个 Fe²⁺",
            "MnO₄⁻ + 5Fe²⁺ + 8H⁺ = Mn²⁺ + 5Fe³⁺ + 4H₂O（电荷·原子双守恒）"
          ]
        },
        {
          "kind": "info",
          "icon": "🧮",
          "title": "不写方程也能算",
          "text": "「0.1 mol MnO₄⁻ 完全还原到 Mn²⁺·能氧化多少 Fe²⁺？」——直接用电子守恒：0.1×5 = n×1 → n = 0.5 mol：电子守恒是计算题的「高速公路」·跳过方程直达答案"
        },
        {
          "kind": "highlight",
          "text": "失电子总数=得电子总数——守恒即捷径"
        }
      ]
    },
    {
      "when": 3,
      "title": "身边",
      "subtitle": "无处不在",
      "color": "amber",
      "emoji": "🏭",
      "blocks": [
        {
          "kind": "compare",
          "title": "四大现场",
          "items": [
            {
              "label": "金属冶炼",
              "value": "从矿石里把金属「还原」出来——高炉炼铁（CO 还原 Fe₂O₃）·铝热反应：人类冶金史=还原剂进化史"
            },
            {
              "label": "电池",
              "value": "原电池=把氧化还原的电子转移「引到外电路」做电功：负极失电子（氧化）·正极得电子（还原）·上一课的伏笔"
            },
            {
              "label": "呼吸与燃烧",
              "value": "细胞呼吸本质是葡萄糖被缓慢「氧化」·缓慢释放能量——生命是一场合控的燃烧"
            },
            {
              "label": "消毒漂白",
              "value": "84消毒液·双氧水——强氧化剂破坏病菌结构：氧化性的日常应用"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🔧",
          "title": "防锈的反向思维",
          "text": "既然生锈是氧化·防锈就是「阻止电子转移」：刷漆隔绝空气·镀锌（牺牲锌保护铁——牺牲阳极）·烤蓝生成致密氧化膜：懂了原理·防锈招数全说得通"
        },
        {
          "kind": "highlight",
          "text": "冶炼·电池·呼吸·消毒——氧还是化学的主旋律"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "本质概念",
        "body": "【标志】化合价有升降。【升失氧】失电子被氧化。\n【降得还】得电子被还原。\n【剂】氧化剂被还原·还原剂被氧化。"
      },
      {
        "title": "电子守恒",
        "body": "【法则】失电子总数=得电子总数。\n【配平】找变价→求公倍→双守恒。\n【计算】不写方程·守恒直算。"
      },
      {
        "title": "应用",
        "body": "【冶炼】CO还原铁矿。【电池】电子走外电路。\n【生命】呼吸=受控氧化。【防锈】阻断转移+牺牲阳极。"
      }
    ],
    "examples": [
      {
        "q": "判断 Fe+CuSO₄→FeSO₄+Cu 的类型",
        "steps": [
          "Fe：0→+2 升（失电子）",
          "Cu：+2→0 降（得电子）",
          "有升降⇒氧化还原",
          "Fe 是还原剂·CuSO₄ 是氧化剂"
        ],
        "tip": "看化合价"
      },
      {
        "q": "0.2 mol Cl₂ 完全还原到 Cl⁻ 得电子多少",
        "steps": [
          "Cl：0→−1·每个得 1e⁻",
          "0.2×2=0.4 mol 电子",
          "守恒直算",
          "无需写方程"
        ],
        "tip": "守恒高速路"
      }
    ],
    "mistakes": [
      "把氧化剂当成「被氧化」的物质（氧化剂得电子被还原）",
      "配平时只管原子不管电荷（离子方程式双守恒）"
    ]
  },
