  "teach": {
    "sections": [
      {
        "title": "二次根式的概念",
        "body": "【形如 √a（a≥0）的式子叫二次根式】\n双重非负性：被开方数 a≥0，且 √a 本身 ≥0。\n√(−4) 没有意义（负数不能开平方）。"
      },
      {
        "title": "最简二次根式",
        "body": "【被开方数不含分母、不含能开得尽的因数】\n化简方法：找平方因子开出来。√8 = √(4×2) = 2√2；√50 = 5√2；√27 = 3√3。\n√a·√b = √(ab)：乘进去开出来都合法。"
      },
      {
        "title": "同类二次根式与加减",
        "body": "【化简后被开方数相同的根式可以合并：2√3 + 5√3 = 7√3】\n√2 + √3 不能合并（不是同类）！\n加减前先全部化成最简，再合并同类。"
      }
    ],
    "examples": [
      {
        "q": "化简：√72",
        "steps": [
          "72 = 36×2（36 是平方数）",
          "√72 = √36 × √2",
          "= 6√2"
        ],
        "tip": "找最大的平方因子：36、25、16、9、4"
      },
      {
        "q": "计算：√48 + √27 − √12",
        "steps": [
          "逐个化简：√48 = 4√3",
          "√27 = 3√3；√12 = 2√3",
          "原式 = 4√3 + 3√3 − 2√3",
          "= 5√3"
        ],
        "tip": "先化简再合并，顺序不能反"
      }
    ],
    "mistakes": [
      "√2+√3 算成 √5（非同类不能合并）",
      "√(a+b) 与 √a+√b 混淆：√(9+16)=5 ≠ 3+4=7"
    ]
  },
