  "teach": {
    "sections": [
      {
        "title": "乘法分配律",
        "body": "【(a + b) × c = a × c + b × c】\n先加再乘 = 分别乘再相加，结果一样。\n它像\"发糖\"：10 个小朋友，每人 3 颗水果糖 + 2 颗牛奶糖，一共 (3+2)×10，也可以 3×10 + 2×10。"
      },
      {
        "title": "正着用与反着用",
        "body": "正着用（展开）：(4 + 5) × 3 = 4×3 + 5×3\n反着用（提取公因数）：4×3 + 5×3 =（4+5）×3\n反着用是简便计算的好帮手：37×99 + 37 = 37×(99+1) = 3700。"
      }
    ],
    "examples": [
      {
        "q": "简便计算：102 × 25",
        "steps": [
          "把 102 拆成 100 + 2",
          "102 × 25 = (100 + 2) × 25",
          "= 100×25 + 2×25",
          "= 2500 + 50 = 2550"
        ],
        "tip": "见到接近整百的数，想想分配律"
      }
    ],
    "mistakes": [
      "分配律误用到乘法结合律：(2+3)×4 ≠ 2×4 + 3（丢了乘 4）"
    ]
  }
