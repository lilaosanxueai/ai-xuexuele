      "blocks": [
        {
          "kind": "compare",
          "title": "四色四家",
          "items": [
            {
              "label": "蓝色·可回收",
              "value": "能卖钱的：纸箱·塑料瓶·易拉罐·旧书报——回收再造新东西：一个瓶子能变衣服纤维"
            },
            {
              "label": "绿色·厨余",
              "value": "容易烂的：剩饭·果皮·菜叶·鸡蛋壳——能变成花肥：香蕉皮的归宿"
            },
            {
              "label": "红色·有害",
              "value": "有毒危险的：废电池·过期药·水银体温计——小小一节电池污染一大片土：必须单独送"
            },
            {
              "label": "灰色·其他",
              "value": "其余都归它：用过的纸巾·陶瓷碎片·尘土——最难处理·大多烧掉或填埋"
            }
          ]
        },
        {
          "kind": "highlight",
          "text": "蓝卖钱·绿变肥·红有毒·灰兜底"
        }
      ]
    },
    {
      "when": 2,
      "title": "分类口诀",
      "subtitle": "坑题也怕它",
      "color": "amber",
      "emoji": "🧠",
      "blocks": [
        {
          "kind": "info",
          "icon": "🦴",
          "title": "大棒骨之谜",
          "text": "大棒骨看着是厨余？错！它太硬太难腐烂·机器绞不动——归「其他垃圾」；鸡骨头鱼刺小而软——才是厨余：判断标准是「烂得掉烂不掉」不是「是不是吃的」"
        },
        {
          "kind": "info",
          "icon": "🥤",
          "title": "一杯奶茶的拆解",
          "text": "喝剩的奶茶：珍珠倒进厨余·液体倒水池·杯子归其他——一杯奶茶分三家：复杂的垃圾先拆开再投放——这叫「拆解投放」"
        },
        {
          "kind": "info",
          "icon": "🧻",
          "title": "纸巾悖论",
          "text": "纸巾是纸·为什么不可回收？用过的纸巾太脏·纤维太短——回收厂不要：干净的大纸箱才收：不是所有「纸」都能回收"
        },
        {
          "kind": "highlight",
          "text": "烂得掉是厨余·大棒骨去其他·奶茶要拆家"
        }
      ]
    },
    {
      "when": 3,
      "title": "家庭行动",
      "subtitle": "今天就开始",
      "color": "green",
      "emoji": "🏠",
      "blocks": [
        {
          "kind": "info",
          "icon": "📦",
          "title": "两桶起步",
          "text": "家里不用四桶齐上：先设两个——「厨余桶」（厨房）+「其他袋」（客厅）；纸箱瓶子攒在阳台纸箱里·满了叫回收：简单才能坚持"
        },
        {
          "kind": "info",
          "icon": "📅",
          "title": "小卫士任务卡",
          "text": "每天倒厨余·每周卖一次可回收·发现电池交给爸妈送红桶：坚持一个月·家里垃圾少一半：还能教爷爷奶奶——小卫士管全家"
        },
        {
          "kind": "highlight",
          "text": "两桶起步·全家跟上——坚持才是真分类"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "四色垃圾桶",
        "body": "【蓝】可回收——卖钱。\n【绿】厨余——变肥。\n【红】有害——单独送。\n【灰】其他——兜底。"
      },
      {
        "title": "分类口诀",
        "body": "【标准】烂得掉才是厨余。\n【大棒骨】硬·难腐烂→其他。\n【奶茶】珍珠厨余·杯其他。"
      },
      {
        "title": "家庭分类",
        "body": "【起步】厨余+其他两桶。\n【可回收】攒着定期卖。\n【坚持】一个月见效果。"
      }
    ],
    "examples": [
      {
        "q": "整理一顿饭后垃圾",
        "steps": [
          "鱼刺菜叶进厨余",
          "饮料瓶冲洗攒起来",
          "用过的纸巾进其他",
          "电池单独问家长"
        ],
        "tip": "先拆解再投放"
      },
      {
        "q": "教爷爷奶奶分类",
        "steps": [
          "把四色口诀写下来贴墙上",
          "举三个例子各归哪家",
          "让他们考你一道题",
          "每周一起数攒的瓶子"
        ],
        "tip": "口诀上墙"
      }
    ],
    "mistakes": [
      "以为吃的都是厨余（大棒骨难腐烂归其他）",
      "用过的纸巾扔可回收（太脏纤维短不回收）"
    ]
  },
