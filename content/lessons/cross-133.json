  "teach": {
    "sections": [
      {
        "title": "电功率",
        "body": "【电功率表示消耗电能的快慢：P = UI = W/t，单位瓦特(W)】\n100W 的灯比 60W 的灯耗电快。\n千瓦(kW) = 1000W，空调常标 1.5kW。"
      },
      {
        "title": "电功与\"度\"",
        "body": "【W = Pt；1 度 = 1 千瓦时 = 1kW×1h = 3.6×10⁶ 焦】\n100W 灯开 10 小时 = 1 度电。\n电能表测的就是电功（度数）。"
      },
      {
        "title": "额定与实际",
        "body": "【额定功率：用电器在额定电压下的功率（灯泡上标的）】\n实际电压偏低 → 实际功率低于额定 → 灯变暗。\n实际电压过高 → 实际功率超标 → 烧毁。"
      }
    ],
    "examples": [
      {
        "q": "一台 1.5kW 的空调每天用 4 小时，一个月（30 天）耗电多少度？",
        "steps": [
          "每天耗电 = 1.5kW × 4h = 6 度",
          "每月 = 6 × 30",
          "= 180 度"
        ],
        "tip": "千瓦 × 小时 = 度，单位直接配好"
      },
      {
        "q": "标有\"220V 100W\"的灯泡接在 110V 电路上，实际功率？",
        "options_ignore": true,
        "steps": [
          "电阻不变：R = 220²/100 = 484Ω",
          "实际功率 P = 110²/484 = 25W",
          "只有额定的四分之一——灯很暗"
        ],
        "tip": "电压减半，功率变为四分之一（平方关系）"
      }
    ],
    "mistakes": [
      "把功率当耗电量（还要乘时间）",
      "电压减半以为功率也减半（实际是四分之一）"
    ]
  },
