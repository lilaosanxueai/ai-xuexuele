  "id": "ai-24",
  "order": 908,
  "title": "电脑怎样思考：CPU 和内存",
  "emoji": "🖥️",
  "textbook": "信息科技（小学）",
  "curriculum": {
    "module": "硬件基础",
    "points": [
      "CPU是大脑",
      "内存是桌面",
      "硬盘是仓库"
    ]
  },
  "story": "你按一下键盘·屏幕上就出现一个字——中间发生了什么？电脑里面有大脑（CPU）有桌面（内存）有仓库（硬盘）——三个伙伴协作让你玩游戏看视频。这一课打开机箱看看。",
  "goals": [
    "理解CPU的作用",
    "理解内存和硬盘的区别",
    "了解电脑的基本组成"
  ],
  "aiIntro": "🖥️ 打开机箱看电脑的三个伙伴",
  "param": {
    "name": "pc",
    "label": "电脑站",
    "min": 1,
    "max": 3,
    "step": 1,
    "value": 1
  },
  "explore": [
    "电脑的\"大脑\"是什么？",
    "为什么内存大就快？",
    "关机后东西存在哪？"
  ],
  "views": [
    {
      "when": 1,
      "title": "CPU",
      "subtitle": "大脑",
      "color": "blue",
      "emoji": "🧠",
      "blocks": [
        {
          "kind": "info",
          "icon": "⚙️",
          "title": "CPU=中央处理器",
          "text": "电脑的大脑：负责计算和决策——你玩游戏时的画面·听音乐时的声音·打字时的每个字都是CPU在\"想\""
        },
        {
          "kind": "compare",
          "title": "CPU跑多快",
          "items": [
            {
              "label": "速度单位",
              "value": "GHz（每秒十亿次运算）——3GHz=每秒30亿步：比你眨眼快几亿倍"
            },
            {
              "label": "多核",
              "value": "一个CPU里有多个\"小脑\"（4核·8核）——同时干多件事不卡"
            },
            {
              "label": "品牌",
              "value": "Intel（英特尔）·AMD·Apple M系列——手机的CPU是骁龙和A系列"
            }
          ]
        },
        {
          "kind": "highlight",
          "text": "CPU=大脑——一切计算都在这里发生"
        }
      ]
    },
    {
      "when": 2,
      "title": "内存",
      "subtitle": "桌面",
      "color": "green",
      "emoji": "🗂️",
      "blocks": [
        {
          "kind": "info",
          "icon": "⚡",
          "title": "内存=临时桌面",
          "text": "你正在用的程序和数据放在内存（RAM）——关机就清空：就像桌上的作业本·做完收进抽屉（硬盘）·明天再拿出来"
        },
        {
          "kind": "compare",
          "title": "内存vs硬盘",
          "items": [
            {
              "label": "速度",
              "value": "内存快一万倍——CPU等内存等得起·等硬盘等不起"
            },
            {
              "label": "容量",
              "value": "内存小（8-16GB）·硬盘大（512GB-2TB）"
            },
            {
              "label": "关机",
              "value": "内存关机清空——硬盘永久保存"
            },
            {
              "label": "比喻",
              "value": "内存=桌面（快但小·收工清空）——硬盘=抽屉（慢但大·永远记着）"
            }
          ]
        },
        {
          "kind": "highlight",
          "text": "内存=桌面（快但临时）·硬盘=抽屉（大但永久）"
        }
      ]
    },
    {
      "when": 3,
      "title": "协作",
      "subtitle": "三兄弟",
      "color": "amber",
      "emoji": "🤝",
      "blocks": [
        {
          "kind": "steps",
          "title": "打开一个游戏发生了什么",
          "items": [
            "硬盘：从仓库里找游戏文件→搬到内存（桌面）——加载中……",
            "内存：把游戏数据准备好让CPU随时取",
            "CPU：飞快计算——画面·声音·角色反应",
            "显示卡（GPU）：把CPU的算好的结果画到屏幕上",
            "你按键盘→CPU收到→更新画面→屏幕响应"
          ]
        },
        {
          "kind": "info",
          "icon": "🐢",
          "title": "为什么电脑卡",
          "text": "内存不够→桌面太小放不下→CPU要跑去仓库慢慢搬→卡。清理后台程序（关掉桌面的\"本子\"）释放内存→变快"
        },
        {
          "kind": "highlight",
          "text": "硬盘存→内存备→CPU算→GPU画——四兄弟一条链"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "CPU",
        "body": "【本质】大脑·计算决策。\n【速度】GHz=每秒十亿步。\n【多核】多任务并行。"
      },
      {
        "title": "内存与硬盘",
        "body": "【内存】快但小+关机清空=桌面。\n【硬盘】慢但大+永久保存=抽屉。\n【卡顿原因】内存不够→去硬盘搬→慢。"
      },
      {
        "title": "协作流程",
        "body": "【链路】硬盘找→内存备→CPU算→GPU画。\n【操作】按键盘→CPU响应→更新画面。"
      }
    ],
    "examples": [
      {
        "q": "电脑越用越卡",
        "steps": [
          "后台程序太多→内存不够",
          "关掉不用的程序",
          "清理桌面（释放内存）",
          "还卡→重启清空内存"
        ],
        "tip": "桌面整理"
      },
      {
        "q": "手机和电脑的CPU一样吗",
        "steps": [
          "手机CPU更小更省电",
          "电脑CPU更快更强",
          "原理一样：大脑",
          "手机叫SoC（CPU+GPU+内存合体）"
        ],
        "tip": "同类不同级"
      }
    ],
    "mistakes": [
      "认为硬盘大=电脑快（快主要看内存和CPU）",
      "认为关机丢数据（硬盘永久·只是内存清空）"
    ]
  },
