  "teach": {
    "sections": [
      {
        "title": "选项指纹",
        "body": "【代词类：this/that/such/they——必指前文某名词】\n【逻辑类：but/however/therefore/for example——必衔接特定逻辑】\n【句式类：疑问句回上句的回答；祈使句多在段尾建议】\n读选项 30 秒分类，比直接读原文省一半时间。"
      },
      {
        "title": "空格形状",
        "body": "【段首空：常是主题句——看上一段尾句+本段内容定主题】\n【段中空：承上启下——空前后的代词/逻辑词是抓手】\n【段尾空：总结句或建议句——for example 型选项多在此】\n小标题空：看该段首句关键词。"
      },
      {
        "title": "验证三查",
        "body": "【一查代词有着落：this 指的东西在前文能找到吗？】\n【二查逻辑通顺：but 后面真的转折了吗？】\n【三查话题一致：整段说的是同一件事吗？】\n全部填完通读一遍——通读不顺畅，优先重查代词。"
      }
    ],
    "examples": [
      {
        "q": "选项 C 以 However, 开头，该放哪类空格？",
        "steps": [
          "However 表转折",
          "找原文空前有转折关系的位置",
          "通常在前文陈述了相反观点处",
          "答案：转折衔接空"
        ],
        "tip": "逻辑词定位置"
      },
      {
        "q": "空格后一句是 \"By doing so, ...\"，提示什么？",
        "steps": [
          "By doing so 指代某个做法",
          "空格必含一个具体行为/建议",
          "找含祈使句或建议的选项",
          "代词反推内容"
        ],
        "tip": "指代反查"
      }
    ],
    "mistakes": [
      "只看空格前后两三个词就选（线索可能隔得远）",
      "不回填验证（错一个可能连环错）"
    ]
  },
