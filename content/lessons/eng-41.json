  "story": "背了忘忘了背——词汇是英语最痛的事。但你知道吗：记不住不是记性差·是方法不对。这一课教你三个科学验证的记忆方法——让每个单词花更少时间记得更牢。",
  "goals": [
    "掌握词根词缀法",
    "学会联想记忆法",
    "了解间隔重复法"
  ],
  "aiIntro": "🧠 告别死记硬背——词汇记忆法",
  "param": {
    "name": "vm",
    "label": "记忆站",
    "min": 1,
    "max": 3,
    "step": 1,
    "value": 1
  },
  "explore": [
    "为什么总是背了就忘？",
    "词根词缀怎样帮记忆？",
    "什么时候复习最科学？"
  ],
  "views": [
    {
      "when": 1,
      "title": "词根",
      "subtitle": "拆单词",
      "color": "blue",
      "emoji": "🧩",
      "blocks": [
        {
          "kind": "info",
          "icon": "pre",
          "title": "前缀=方向",
          "text": "un-（不）·re-（再）·pre-（前）·dis-（否定）——unhappy不快乐·rewrite重写·preview预习——学会20个前缀=猜出几百个新词"
        },
        {
          "kind": "info",
          "icon": "📖",
          "title": "词根=核心",
          "text": "port=搬运：import进口（往里搬）·export出口（往外搬）·transport运输（跨着搬）——知道port=搬·看新词都能猜：一个词根串一串单词"
        },
        {
          "kind": "info",
          "icon": "post",
          "title": "后缀=词性",
          "text": "-tion名词·-ful形容词·-ly副词——action行动·careful小心的·quickly快速地：知道后缀→猜词性→语法不犯错"
        },
        {
          "kind": "highlight",
          "text": "前缀定方向+词根定意思+后缀定词性=拆解一切生词"
        }
      ]
    },
    {
      "when": 2,
      "title": "联想",
      "subtitle": "挂钩",
      "color": "green",
      "emoji": "🔗",
      "blocks": [
        {
          "kind": "compare",
          "title": "三种联想",
          "items": [
            {
              "label": "谐音法",
              "value": "ambulance救护车 → 谐音\"俺不能死\"→记住意思。不是每个词都能谐音·能谐音的都是好记的"
            },
            {
              "label": "词中词法",
              "value": "island岛 → is+land（是陆地但被水围→岛）：拆出认识的短词+联想——好拆=好记"
            },
            {
              "label": "画面法",
              "value": "gloomy阴暗 → 想象一个房间gl-oom-y（昏暗的房间）：画面比文字的记忆深十倍"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "😄",
          "title": "越荒谬越好记",
          "text": "联想的画面越离谱越忘不掉——\"俺不能死\"比\"A-M-B-U...\"好记一万倍。有趣的联想本身就是记忆的胶水"
        },
        {
          "kind": "highlight",
          "text": "联想=给新词挂钩——越荒谬挂得越牢"
        }
      ]
    },
    {
      "when": 3,
      "title": "间隔",
      "subtitle": "科学复习",
      "color": "violet",
      "emoji": "⏰",
      "blocks": [
        {
          "kind": "steps",
          "title": "遗忘曲线",
          "items": [
            "刚背完：记住100%",
            "20分钟后：忘42%",
            "1天后：忘67%",
            "7天后：忘75%——然后趋于稳定。如果不复习大部分一天就忘了"
          ]
        },
        {
          "kind": "info",
          "icon": "🔄",
          "title": "对抗遗忘",
          "text": "在快忘的时候复习一次→忘得慢十倍。节奏：当天→第2天→第4天→第7天→第15天——五次就能转入长期记忆。这叫间隔重复——AnkiApp自动化帮你做"
        },
        {
          "kind": "info",
          "icon": "📝",
          "title": "组合拳",
          "text": "新词：拆词根+联想 → 用手写三遍（肌肉记忆）→ 造一个句（用出来）→ 第二天复习。四步+间隔=记得又牢又久"
        },
        {
          "kind": "highlight",
          "text": "对抗遗忘的武器=在快忘的时候复习一次"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "词根词缀",
        "body": "【前缀】un不·re再·pre前·dis否。\n【词根】port搬→import/export/transport。\n【后缀】tion名·ful形·ly副。"
      },
      {
        "title": "联想记忆",
        "body": "【谐音】俺不能死=ambulance。\n【词中词】is+land。\n【画面】越荒谬越好记。"
      },
      {
        "title": "间隔重复",
        "body": "【遗忘】1天忘67%。\n【对策】当天→2天→4天→7天→15天。\n【四步】拆+写+造句+复习。"
      }
    ],
    "examples": [
      {
        "q": "记住 telescope（望远镜）",
        "steps": [
          "拆：tele（远）+ scope（看）",
          "联想：看远处的东西",
          "写三遍+造句：I look at stars with a telescope",
          "明天复习一次"
        ],
        "tip": "词根+四步"
      },
      {
        "q": "总是今天背明天忘",
        "steps": [
          "正常：1天忘67%",
          "不是记性差是没复习",
          "当天+第2天各复习一次",
          "用Anki或自制卡片"
        ],
        "tip": "间隔重复"
      }
    ],
    "mistakes": [
      "一遍一遍抄写（被动重复效果差）",
      "今天背完不复习（一天忘67%）"
    ]
  },
