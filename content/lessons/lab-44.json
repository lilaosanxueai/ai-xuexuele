  "story": "吃自己种的番茄——味道跟买的不一样。不是因为\"爱心加成\"·是因为从枝头到餐桌只有一米而不是一千公里。这一课从一粒种子开始·在阳台上建一个小菜园。",
  "goals": [
    "选择适合阳台的植物",
    "掌握日常养护方法",
    "学会诊断常见问题"
  ],
  "aiIntro": "🌱 从种子到餐桌——阳台种植",
  "param": {
    "name": "gl",
    "label": "种植站",
    "min": 1,
    "max": 3,
    "step": 1,
    "value": 1
  },
  "explore": [
    "什么植物最适合新手？",
    "浇水多少才对？",
    "叶子发黄怎么办？"
  ],
  "views": [
    {
      "when": 1,
      "title": "选植物",
      "subtitle": "新手友好",
      "color": "green",
      "emoji": "🥬",
      "blocks": [
        {
          "kind": "compare",
          "title": "阳台植物推荐",
          "items": [
            {
              "label": "最容易",
              "value": "葱·蒜苗·生菜——把根部插土里就长：一周见效·成就感爆棚"
            },
            {
              "label": "进阶",
              "value": "小番茄·辣椒·草莓——3个月收获果实：需要阳光充足"
            },
            {
              "label": "香草",
              "value": "薄荷·罗勒·迷迭香——随掐随长·做菜用：可以水培"
            },
            {
              "label": "观赏",
              "value": "多肉·绿萝·太阳花——好养好看：净化空气加分"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "☀️",
          "title": "先看阳光",
          "text": "朝南阳台（全日照6h+）：番茄辣椒草莓都行。朝北阳台（散光）：生菜薄荷绿萝。先数你家阳台每天几小时直射阳光→再选植物：光照是第一条件"
        },
        {
          "kind": "highlight",
          "text": "新手从葱蒜生菜开始——一周见效建立信心"
        }
      ]
    },
    {
      "when": 2,
      "title": "养护",
      "subtitle": "日常",
      "color": "blue",
      "emoji": "💧",
      "blocks": [
        {
          "kind": "steps",
          "title": "浇水原则",
          "items": [
            "\"见干见湿\"：土干了再浇·浇就浇透（盆底流出水）——不干不浇",
            "判断干不干：手指插入土中第二关节——干的就浇。不是每天定时浇",
            "夏天早晚浇·冬天中午浇（避开暴晒和严寒时间）",
            "浇多了比浇少了更危险（烂根死掉了）——新手八成是浇死不是渴死"
          ]
        },
        {
          "kind": "info",
          "icon": "🌱",
          "title": "土壤和施肥",
          "text": "土：营养土（花市2元一袋）就行——不要挖公园的土（可能板结有虫）；肥：有机复合肥每月一次·宁少勿多"
        },
        {
          "kind": "info",
          "icon": "🪴",
          "title": "容器",
          "text": "花盆·泡沫箱·饮料瓶剪开都行——底部必须有排水孔：无孔=积水烂根。深度：叶菜10cm·番茄辣椒20cm+"
        },
        {
          "kind": "highlight",
          "text": "浇水宁少勿多——新手的花是浇死的不是渴死的"
        }
      ]
    },
    {
      "when": 3,
      "title": "诊断",
      "subtitle": "看叶识病",
      "color": "amber",
      "emoji": "🔍",
      "blocks": [
        {
          "kind": "compare",
          "title": "叶片信号",
          "items": [
            {
              "label": "发黄",
              "value": "老叶黄→缺肥。新叶黄→浇多了。全株黄→光照不够。看哪片黄就知道哪出问题"
            },
            {
              "label": "发蔫",
              "value": "土干→缺水浇透。土湿还蔫→烂根（停止浇水·松土通风）"
            },
            {
              "label": "虫子",
              "value": "蚜虫（绿小虫）→用水冲或肥皂水。白色小飞虫→土壤太湿"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🌾",
          "title": "从种子到收获",
          "text": "生菜30天·葱蒜15天·小番茄80天·辣椒90天。播种深度=种子直径的2倍·间距按品种。发芽前保持湿润不暴晒"
        },
        {
          "kind": "highlight",
          "text": "叶子是植物的表情——学会看叶就学会了种植物"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "植物选择",
        "body": "【新手】葱蒜生菜一周见效。\n【进阶】番茄辣椒草莓。\n【光照】朝南全日照·朝北散光。"
      },
      {
        "title": "日常养护",
        "body": "【浇水】见干见湿·宁少勿多。\n【判断】手指插土二关节。\n【容器】有排水孔。"
      },
      {
        "title": "诊断",
        "body": "【老叶黄】缺肥。【新叶黄】浇多。\n【蔫+土干】缺水。【蔫+土湿】烂根。\n【收获】生菜30天·番茄80天。"
      }
    ],
    "examples": [
      {
        "q": "想在阳台种菜从哪种开始",
        "steps": [
          "看阳台朝向",
          "南→选生菜小番茄",
          "北→选葱蒜薄荷",
          "一周浇一次不贪多"
        ],
        "tip": "先易后难"
      },
      {
        "q": "叶子发蔫了",
        "steps": [
          "先摸土",
          "土干→浇透",
          "土湿→可能烂根",
          "停水松土通风"
        ],
        "tip": "摸土判断"
      }
    ],
    "mistakes": [
      "每天定时浇水（见干见湿不是定时定量）",
      "认为种植物需要天赋（是观察和耐心）"
    ]
  },
