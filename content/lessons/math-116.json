  "views": [
    {
      "when": 1,
      "title": "对称",
      "subtitle": "公式的本质",
      "color": "blue",
      "emoji": "🪞",
      "blocks": [
        {
          "kind": "info",
          "icon": "⭕",
          "title": "单位圆的对称性",
          "text": "三角函数是单位圆上的坐标——圆是完美对称的：关于 x 轴·y 轴·原点·直线 y=x 对称：诱导公式=对称性的代数表达·十个公式其实是「圆很对称」的十句话"
        },
        {
          "kind": "compare",
          "title": "四组基本变形",
          "items": [
            {
              "label": "−α（关于x轴）",
              "value": "sin(−α)=−sinα·cos(−α)=cosα——偶余奇正"
            },
            {
              "label": "180°±α（原点）",
              "value": "sin(180°+α)=−sinα·cos(180°+α)=−cosα——都变号"
            },
            {
              "label": "90°−α（y=x对称）",
              "value": "sin(90°−α)=cosα——函数「互换了名字」"
            }
          ]
        },
        {
          "kind": "highlight",
          "text": "诱导公式=单位圆的对称性——十句话讲一件事"
        }
      ]
    },
    {
      "when": 2,
      "title": "口诀",
      "subtitle": "奇变偶不变",
      "color": "green",
      "emoji": "🔑",
      "blocks": [
        {
          "kind": "steps",
          "title": "一句口诀走天下",
          "items": [
            "「奇变偶不变·符号看象限」",
            "奇偶：90° 的奇数倍→函数名变（sin⇄cos）；偶数倍→函数名不变",
            "符号：把 α 当锐角·看原角落在第几象限·原函数在该象限的正负就是结果的正负",
            "例：sin(90°+α)——90° 奇数倍→变 cos；90°+α 在第二象限 sin 为正→得 cosα"
          ]
        },
        {
          "kind": "info",
          "icon": "🧪",
          "title": "验证一个",
          "text": "sin150°：150°=180°−30°（180° 偶数倍→不变 sin）·180°−30° 在第二象限·sin 为正→sin30°=½：口诀一遍过·计算器验证吻合——记忆是有数学保证的"
        },
        {
          "kind": "highlight",
          "text": "奇变偶不变·符号看象限——把 α 看成锐角"
        }
      ]
    },
    {
      "when": 3,
      "title": "化简",
      "subtitle": "实战三步",
      "color": "amber",
      "emoji": "⚔️",
      "blocks": [
        {
          "kind": "steps",
          "title": "化简求值流程",
          "items": [
            "负角先正：sin(−α)=−sinα（把负号吃掉）",
            "大角化小：反复用诱导公式·把角度拉回 0°~90°（像长除法一样「剥」）",
            "特殊角查表：30/45/60 的值·收尾求值"
          ]
        },
        {
          "kind": "info",
          "icon": "🎯",
          "title": "考试中的角色",
          "text": "诱导公式很少单独出大题——它是三角化简·求值·证明的「中间工序」（像乘法口诀）：高考三角大题第一问基本都要过它：熟到条件反射"
        },
        {
          "kind": "info",
          "icon": "🧠",
          "title": "物理里的回响",
          "text": "三角函数描述振动与波——sin(180°+α)=−sinα 意味着「转半圈波形反相」：音响的相位·交流电的正负半周：对称公式在物理里是「反相」·同源同构"
        },
        {
          "kind": "highlight",
          "text": "负角先正·大角化小·查表收尾——三层剥洋葱"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "对称本质",
        "body": "【−α】偶余奇正。【180°±α】全变号。\n【90°−α】函数名互换。\n【本质】单位圆的对称性。"
      },
      {
        "title": "口诀",
        "body": "【奇偶】90°奇倍变名·偶倍不变。\n【符号】α当锐角·看象限定正负。\n【验证】sin150°=½。"
      },
      {
        "title": "化简流程",
        "body": "【一】负角先正。【二】大角化小到0~90°。\n【三】特殊角查表收尾。\n【物理】反相=对称公式。"
      }
    ],
    "examples": [
      {
        "q": "化简 sin(−60°)",
        "steps": [
          "负角先正：−sin60°",
          "查表：−√3/2",
          "完成",
          "验证：第四象限正弦为负"
        ],
        "tip": "负号先吃"
      },
      {
        "q": "求 cos210°",
        "steps": [
          "210°=180°+30°",
          "偶倍不变·符号看象限",
          "第三象限 cos 为负",
          "=−cos30°=−√3/2"
        ],
        "tip": "口诀两步"
      }
    ],
    "mistakes": [
      "符号看象限时把新函数当原函数看象限（应看原函数）",
      "90° 的奇数倍忘记变函数名（sin 没换成 cos）"
    ]
  },
