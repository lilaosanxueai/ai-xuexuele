  "teach": {
    "sections": [
      {
        "title": "四种基本情绪",
        "body": "【喜·怒·哀·惧】是人类共有的基本情绪，全世界的人表情都一样。\n每种情绪都有功能：喜=继续做；怒=边界警报；哀=珍惜与修复；惧=远离危险。\n情绪没有好坏，只有信息。"
      },
      {
        "title": "情绪的身体信号",
        "body": "【怒】心跳快、脸热、肌肉紧；【惧】手心汗、想跑；【哀】没力气、想哭。\n先发现身体信号，再说出情绪名字——\"我注意到我在生气\"，火气就小了一半。\n这叫\"情绪命名\"，心理学最实用的一招。"
      },
      {
        "title": "三个调节工具",
        "body": "【深呼吸】吸 4 秒呼 6 秒，来三轮，给大脑降温。\n【数十下】生气时先数十再说话，雷雨转小。\n【说出来】告诉信任的人\"我很难过\"——雨天里递来伞的人就在身边。"
      }
    ],
    "examples": [
      {
        "q": "被同学撞倒还挨骂，怒气冲头怎么办？",
        "steps": [
          "身体信号：脸热心跳快",
          "心里默念：我在生气，它在报警",
          "深呼吸数十下再开口",
          "说事实：\"你撞到我了，我很生气\""
        ],
        "tip": "先降温再表达"
      },
      {
        "q": "心爱的宠物去世了，一直难过正常吗？",
        "steps": [
          "难过是珍惜的证据",
          "允许自己哭、说出来",
          "慢慢纪念它：画一张像",
          "雨天会一点一点转晴"
        ],
        "tip": "悲伤有开始就有结束"
      }
    ],
    "mistakes": [
      "认为负面情绪是坏的要压制（压住的火会从别处冒出来）",
      "认为哭是懦弱（眼泪是身体的自我修复）"
    ]
  },
