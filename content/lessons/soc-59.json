  "teach": {
    "sections": [
      {
        "title": "社区骨架",
        "body": "【主人】业主大会。\n【代表】业委会。\n【管家】物业（受雇）。\n【桥梁】居委会。"
      },
      {
        "title": "议事三步",
        "body": "【提议】10%联名列议题。\n【共议】方案公示讨论。\n【表决】双过半通过。"
      },
      {
        "title": "我能参与",
        "body": "【观察】议事会青少年席。\n【调查】数据代替我觉得。\n【志愿】活动+助老+督导。"
      }
    ],
    "examples": [
      {
        "q": "电梯坏了该走的流程",
        "steps": [
          "拍照记录找证据",
          "向业委会提议题",
          "参与表决选方案",
          "监督维修验收"
        ],
        "tip": "先提案再表决"
      },
      {
        "q": "做充电口小调查",
        "steps": [
          "数现有充电口数量",
          "问卷问邻居需求",
          "汇总数据写建议",
          "交居委会或业委会"
        ],
        "tip": "数据说话"
      }
    ],
    "mistakes": [
      "以为物业是小区的老大（物业是业主雇的管家·业委会才有话语权）",
      "觉得小区事务与小孩无关（观察席·调查·志愿都是参与入口）"
    ]
  },
