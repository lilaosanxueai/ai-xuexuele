  "starterCode": "# 城市化进程仪表盘\nyr = 1950   # 年份\n\nhide()\nu = (yr - 1800) / 250\npct = 100 / (1 + 90 * (1 - u) * (1 - u) * (1 - u))\nif yr >= 2025:\n    pct = 57 + (yr - 2025) * 0.18\nfill_rect(0, 130, 340, 30, \"#1d4ed8\")\nwrite(\"年份 \" + yr + \"：世界城市化率约 \" + pct + \"%\", 0, 130, \"#fff\", 12)\npen_color(\"#dc2626\")\npen_down()\nt = 0\ngo_to(-170, -80)\nwhile t < 1.01:\n    y = 100 / (1 + 90 * (1 - t) * (1 - t) * (1 - t))\n    go_to(-170 + t * 340, -80 + y * 1.6)\n    t = t + 0.05\npen_up()\nx = -170 + u * 340\ny = -80 + pct * 1.6\ncircle(x, y, 6, \"#0f172a\")\nif u < 0.3:\n    write(\"初期阶段：缓慢增长（早期发达国家）\", -30, 105, \"#0369a1\", 11)\nif u >= 0.3:\n    if u < 0.75:\n        write(\"加速阶段：农村人口大量进城（发展中大国）\", -30, 105, \"#b45309\", 11)\nif u >= 0.75:\n    write(\"后期阶段：增速放缓（发达国家 80% 左右）\", -30, 105, \"#16a34a\", 11)\nwrite(\"S 形曲线：慢—快—慢\", -100, 145, \"#7c3aed\", 11)\n",
