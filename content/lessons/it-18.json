  "starterCode": "# 数组和链表演示台\nds = 1   # 1数组 2链表\n\nhide()\nt = \"数组：连续座位\"\nd = \"内存里紧挨着排队，编号 0 1 2 3\"\na1 = \"查找第 n 个：一步到位 O(1)\"\na2 = \"中间插入：后面全体后移 O(n)\"\nif ds == 2:\n    t = \"链表：手拉手队伍\"\n    d = \"每个节点存数据+下一家的地址，散落各处\"\n    a1 = \"查找第 n 个：从头走 n 步 O(n)\"\n    a2 = \"中间插入：改两个指针 O(1)\"\nfill_rect(0, 130, 360, 30, \"#1d4ed8\")\nwrite(t, 0, 130, \"#fff\", 13)\nfill_rect(0, 80, 360, 36, \"#f1f5f9\")\nwrite(d, 0, 80, \"#0f172a\", 11)\nfill_rect(-105, 20, 56, 36, \"#3b82f6\")\nwrite(\"A[0]\", -105, 20, \"#fff\", 10)\nif ds == 1:\n    fill_rect(-42, 20, 56, 36, \"#3b82f6\")\n    fill_rect(21, 20, 56, 36, \"#3b82f6\")\n    fill_rect(84, 20, 56, 36, \"#3b82f6\")\n    write(\"A[1]\", -42, 20, \"#fff\", 10)\n    write(\"A[2]\", 21, 20, \"#fff\", 10)\n    write(\"A[3]\", 84, 20, \"#fff\", 10)\nif ds == 2:\n    fill_rect(-20, 20, 44, 36, \"#f59e0b\")\n    write(\"B|→\", -20, 20, \"#fff\", 9)\n    fill_rect(40, 20, 44, 36, \"#f59e0b\")\n    write(\"C|→\", 40, 20, \"#fff\", 9)\n    fill_rect(120, 20, 44, 36, \"#f59e0b\")\n    write(\"D|∅\", 120, 20, \"#fff\", 9)\nfill_rect(0, -30, 360, 34, \"#eff6ff\")\nwrite(a1, 0, -30, \"#1d4ed8\", 11)\nfill_rect(0, -68, 360, 34, \"#fef3c7\")\nwrite(a2, 0, -68, \"#b45309\", 11)\nwrite(\"选择口诀：查得多用数组，插得多用链表\", -20, -110, \"#dc2626\", 11)\n",
