  "teach": {
    "sections": [
      {
        "title": "城镇化的机制",
        "body": "【推拉模型】推力（乡村收入低）+拉力（城市机会）=人口流动。\n集聚效应：人才·资本·信息聚在一起效率倍增——但也推高房价（集聚的代价）。"
      },
      {
        "title": "城乡的功能分工",
        "body": "城市=效率中心（制造·创新·服务），乡村=生态与粮食基底。\n二者通过市场·交通·网络连接：谁也离不开谁。"
      },
      {
        "title": "乡村振兴战略",
        "body": "产业兴旺·生态宜居·乡风文明·治理有效·生活富裕。\n核心：让人\"愿意来·留得住·过得好\"——归根到底是人的振兴。"
      }
    ],
    "examples": [
      {
        "q": "为什么年轻人都往城里跑？",
        "steps": [
          "拉力：就业选择多·收入高",
          "推力：农业需要人减少",
          "教育医疗资源集中",
          "推+拉=迁徙潮"
        ],
        "tip": "推拉合力"
      },
      {
        "q": "家乡的桃子很好吃但卖不出去，怎么破？",
        "steps": [
          "电商+直播打开销路",
          "冷链物流解决运输",
          "做品牌+故事（不止卖桃卖乡愁）",
          "顺便发展采摘旅游"
        ],
        "tip": "把资源变资产"
      }
    ],
    "mistakes": [
      "认为乡村=落后注定消失（是转型不是消亡）",
      "认为城镇化率越高越好（超大城市病需要平衡）"
    ]
  },
