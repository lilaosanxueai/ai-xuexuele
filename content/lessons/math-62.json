  "starterCode": "# 抛物线拱桥探索台\nspan = 20   # 桥跨度（米）\nh = 4       # 拱高（米）\n\nhide()\n# 水面\nfill_rect(0, -110, 440, 30, \"#93c5fd\")\n# 拱桥：顶点在 (0, h*20)，过 (±span/2*15, -110)\npen_color(\"#64748b\")\npen_down()\nx = 0 - span * 7.5\ngo_to(x, -110)\nwhile x < span * 7.5 + 1:\n    y = -110 + (h * 20) * (1 - (x / (span * 7.5)) * (x / (span * 7.5)))\n    go_to(x, y)\n    x = x + 4\npen_up()\n# 桥面\nfill_rect(0, -110 + h * 20 + 14, span * 15 + 40, 12, \"#78716c\")\nwrite(\"跨度 \" + span + \" 米，拱高 \" + h + \" 米\", -150, 155, \"#0f172a\", 12)\n# 解析式提示（以水面为 x 轴、桥中为原点）\nwrite(\"建模：y = \" + h * 20 / 100 + \"·(1 − x²/\" + span * 7.5 * span * 7.5 / 100 + \")\", -190, 130, \"#1d4ed8\", 11)\nwrite(\"水面为 x 轴、桥中心为 y 轴最方便\", -190, -145, \"#16a34a\", 11)\nwrite(\"求某点高度：代入 x 算 y\", -190, -160, \"#64748b\", 10)\n",
