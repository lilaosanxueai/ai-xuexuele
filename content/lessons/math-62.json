  "teach": {
    "sections": [
      {
        "title": "建模三步",
        "body": "【①建坐标系（拱顶/水面中点为原点）②设解析式 ③代入已知点求系数】\n常用顶点式 y=a(x−h)²+k：拱顶已知时最方便。\n坐标系不同，解析式不同，但答案一致。"
      },
      {
        "title": "拱桥典型题",
        "body": "跨度 20（水面 x=±10）、拱高 4（顶点 (0,4)）：设 y=ax²+4。\n代入 (10, 0)：100a+4=0 → a=−0.04。\n解析式 y=−0.04x²+4，代入任何 x 可求高度。"
      },
      {
        "title": "由函数到决策",
        "body": "船高 3 米能过吗？令 y=3 求出此时的 x 范围，宽度够就通过。\n数学建模的最后一步是\"回答实际问题\"，不只是解方程。"
      }
    ],
    "examples": [
      {
        "q": "抛物线拱桥跨度 20 米（水面处 x=±10）、拱高 4 米。求解析式（顶点为原点向下的坐标系里顶点 (0,4)）。",
        "steps": [
          "设 y = ax² + 4（顶点在 y 轴）",
          "代入点 (10, 0)：100a + 4 = 0",
          "a = −0.04",
          "y = −0.04x² + 4"
        ],
        "tip": "拱顶已知用顶点式，只需再代一个点"
      },
      {
        "q": "上题桥中，离中心 5 米处桥高多少？",
        "steps": [
          "代入 x = 5",
          "y = −0.04×25 + 4",
          "= 3 米"
        ],
        "tip": "求高度就是求函数值"
      }
    ],
    "mistakes": [
      "坐标系建错导致符号混乱（顶点在 x 轴上方开口向下，a 必为负）",
      "跨度当半径用（跨度 20 则水面处 x=±10，不是 ±20）"
    ]
  },
