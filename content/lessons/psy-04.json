  "teach": {
    "sections": [
      {
        "title": "玩笑与欺凌的分界",
        "body": "【玩笑】双方都笑·点到为止·说了停就停。\n【欺凌】一方痛苦·反复发生·力量不对等。\n记住：让你不舒服的\"玩笑\"，你有权当场喊停。"
      },
      {
        "title": "为什么不敢说",
        "body": "怕报复·怕被叫胆小鬼·怕大人说\"为什么只欺负你\"。\n事实：说出来的人被打扰率反而下降——欺凌者专挑沉默的目标。\n大人需要知道才能帮你，这不是告状。"
      },
      {
        "title": "旁观者不沉默",
        "body": "围观和笑声是欺凌的燃料。\n三件事：不笑不转发·陪在被欺负同学身边·报告老师。\n班级里只要有两三个\"敢站着的人\"，欺凌就很难持续。"
      }
    ],
    "examples": [
      {
        "q": "同学总叫你难听外号，说了别叫还叫",
        "steps": [
          "已明确表示不舒服仍继续=越界",
          "坚定说停，走开",
          "告诉老师事实经过",
          "记住：这不是你的错"
        ],
        "tip": "越界两次就该求助"
      },
      {
        "q": "看到同学被围住嘲笑，怎么办？",
        "steps": [
          "不围观不起哄",
          "走过去站在同学身边说\"别这样\"",
          "陪他一起离开",
          "课下悄悄告诉老师"
        ],
        "tip": "站着的人多了欺凌就停"
      }
    ],
    "mistakes": [
      "认为告诉老师是打小报告（求助是让伤害停止）",
      "认为被欺负是因为自己不好（错在欺凌者，永远是欺凌者的错）"
    ]
  },
