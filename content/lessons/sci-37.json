  "explore": [
    "植物的根有什么用？",
    "叶子为什么是绿色的？",
    "蒲公英的种子怎样飞？"
  ],
  "views": [
    {
      "when": 1,
      "title": "器官",
      "subtitle": "六件套",
      "color": " ",
      "emoji": "🌱",
      "blocks": [
        {
          "kind": "compare",
          "title": "植物的身体",
          "items": [
            {
              "label": "根",
              "value": "吸水+固定——像吸管和锚：大树的根比树冠还大（地下隐藏的另一半）"
            },
            {
              "label": "茎",
              "value": "运输+支撑——像电梯+柱子：把水从根送到叶·把糖从叶送到全身"
            },
            {
              "label": "叶",
              "value": "制造食物的厨房——光合作用在这里：绿色=含有叶绿素"
            },
            {
              "label": "花果实种子",
              "value": "繁殖三部曲——花吸引传粉→果实保护种子→种子长新植物"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🥕",
          "title": "我们吃的部位",
          "text": "萝卜=根·土豆=茎（不是根！）·白菜=叶·花菜=花·苹果=果实·花生=种子——一顿饭吃了植物的很多个器官"
        },
        {
          "kind": "highlight",
          "text": "根吸水·茎运输·叶做饭·花结果——六大器官缺一不可"
        }
      ]
    },
    {
      "when": 2,
      "title": "光合",
      "subtitle": "叶子的厨房",
      "color": "green",
      "emoji": "☀️",
      "blocks": [
        {
          "kind": "info",
          "icon": "🏭",
          "title": "世界上最大的工厂",
          "text": "叶子用阳光+水+二氧化碳→制造葡萄糖+氧气——这个过程叫光合作用：没有叶绿素就没有绿色世界：地球上几乎所有食物链的起点"
        },
        {
          "kind": "info",
          "icon": "🫁",
          "title": "氧气来自哪",
          "text": "你呼吸的氧气大部分来自海洋藻类（约70%）·陆地植物贡献约30%——森林是\"地球之肺\"·海洋才是\"地球之肺中的肺\""
        },
        {
          "kind": "info",
          "icon": "🌙",
          "title": "晚上植物也做光合吗",
          "text": "不——没有阳光就没有光合作用：晚上植物也呼吸（吸收氧气放出二氧化碳）：但白天光合远大于呼吸·净效果是放氧气"
        },
        {
          "kind": "highlight",
          "text": "叶子=用阳光做食物的厨房——地球生命的第一步"
        }
      ]
    },
    {
      "when": 3,
      "title": "种子",
      "subtitle": "旅行家",
      "color": "amber",
      "emoji": "🌬️",
      "blocks": [
        {
          "kind": "compare",
          "title": "四种旅行方式",
          "items": [
            {
              "label": "风力",
              "value": "蒲公英的降落伞·枫树的翅膀——轻+翼=飞得远"
            },
            {
              "label": "动物",
              "value": "苍耳的钩子挂动物毛·樱桃被鸟吃后排出来——搭便车"
            },
            {
              "label": "水力",
              "value": "椰子漂洋过海·莲蓬顺水漂流——水路运输"
            },
            {
              "label": "弹射",
              "value": "凤仙花的荚一碰就炸——种子弹出去几米远：自力更生"
            }
          ]
        },
        {
          "kind": "info",
          "icon": "🔬",
          "title": "小实验",
          "text": "把绿豆泡在湿纸巾上·观察：种皮裂开→根先出来（向下）→茎和叶后出来（向上）——根永远向下·芽永远向上（向地性+向光性）：植物也有\"方向感\""
        },
        {
          "kind": "highlight",
          "text": "种子的四种旅行：飞·搭车·漂流·弹射——各显神通"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "植物器官",
        "body": "【六件】根茎叶花果实种子。\n【根】吸水固定·【茎】运输支撑·【叶】光合。\n【吃】萝卜根·土豆茎·白菜叶。"
      },
      {
        "title": "光合作用",
        "body": "【原料】阳光+水+二氧化碳。\n【产物】葡萄糖+氧气。\n【氧气】海洋藻类贡献约七成。"
      },
      {
        "title": "种子传播",
        "body": "【四式】风力·动物·水力·弹射。\n【实验】绿豆发芽：根向下·芽向上。"
      }
    ],
    "examples": [
      {
        "q": "为什么大树不用浇水也长得好",
        "steps": [
          "根扎得很深",
          "找到地下水",
          "茎运水上叶",
          "叶做光合自给自足"
        ],
        "tip": "自力更生"
      },
      {
        "q": "家里发豆芽",
        "steps": [
          "绿豆泡水一夜",
          "湿纸巾铺底",
          "每天淋水避光",
          "3-5天收成——根向下芽向上"
        ],
        "tip": "动手做"
      }
    ],
    "mistakes": [
      "认为土豆是根（是变态茎）",
      "认为氧气全来自森林（海洋藻类占七成）"
    ]
  },
