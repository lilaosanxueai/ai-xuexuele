  "teach": {
    "sections": [
      {
        "title": "保险的数学",
        "body": "【期望损失】概率×损失金额：5%×300=15元→理论保费15元+运营利润≈30元。\n【大数法则】样本量越大·实际结果越接近理论概率——保险公司靠规模化\"赌\"必赢。"
      },
      {
        "title": "保险分类",
        "body": "【人身】寿险·重疾·意外·医疗；【财产】车险·房屋险。\n【消费型】交了不返（纯保障·便宜）；【返还型】没出事返钱（贵·收益率低）——预算有限选消费型。"
      },
      {
        "title": "风险管理阶梯",
        "body": "【避免】不去做危险的事（不酒驾）；【降低】戴头盔·装防盗锁；【自留】小额可承受的；【转移】大额不可承受的买保险。\n四阶梯按成本从低到高排列：先避免降低·再自留·最后才买保险。"
      }
    ],
    "examples": [
      {
        "q": "要不要给手机买碎屏险？",
        "steps": [
          "碎屏概率约10%·维修800元",
          "期望损失=10%×800=80元",
          "碎屏险卖150元→保费>期望损失+合理利润",
          "结论：不如自己存800元应急金"
        ],
        "tip": "小风险自留"
      },
      {
        "q": "爸妈要买\"全能保障\"险？",
        "steps": [
          "看条款：每项保额多少？免赔多少？",
          "拆分对比：分开买单险可能更便宜更好",
          "返还型算IRR：可能跑不赢通胀",
          "先保障后理财——不混买"
        ],
        "tip": "保障归保障理财归理财"
      }
    ],
    "mistakes": [
      "认为保险=浪费钱（对大风险是救命钱）",
      "认为返还型保险=省钱（通常贵且收益差）"
    ]
  },
