    {
      "when": 2,
      "title": "陪护技巧",
      "subtitle": "让家人安心",
      "color": "green",
      "emoji": "🫖",
      "blocks": [
        {
          "kind": "steps",
          "title": "发烧照护四件事",
          "items": [
            "补水：温水小口多次（发烧在\"烧水\"）",
            "降温：额头湿毛巾·别捂厚被子发汗",
            "记录：几点量的·多少度·吃了什么药——就医时医生最需要这个",
            "陪伴：递水递纸巾·轻声说话——被照顾的人心情好一半"
          ]
        },
        {
          "kind": "info",
          "icon": "👂",
          "title": "听长辈说\"没事\"",
          "text": "老人常怕麻烦孩子说\"没事\"——真没事的人不会一直皱眉。学会观察：脸色·食欲·睡眠·精神头，有异常主动告诉爸妈：观察比听话更可靠"
        },
        {
          "kind": "info",
          "icon": "💊",
          "title": "用药红线",
          "text": "孩子不配药不给药——拿不准的药一口都不能喂；帮长辈拿药要核对：姓名·药名·时间·剂量（帮\"拿\"不帮\"配\"）"
        },
        {
          "kind": "highlight",
          "text": "照护=知识+耐心+把小事做细"
        }
      ]
    },
    {
      "when": 3,
      "title": "应急",
      "subtitle": "这些要背下来",
      "color": "rose",
      "emoji": "🚨",
      "blocks": [
        {
          "kind": "steps",
          "title": "立刻打120的信号",
          "items": [
            "胸痛·呼吸困难·大汗淋漓",
            "意识不清·叫不醒·说话含糊",
            "摔倒后剧痛不能动（可能骨折——别扶起来）",
            "抽搐不止"
          ]
        },
        {
          "kind": "info",
          "icon": "📞",
          "title": "打120怎么说",
          "text": "三句话：地址（小区楼栋门牌）·情况（谁·什么症状·多久了）·电话；挂电话前等对方先挂——调度员可能还有话问"
        },
        {
          "kind": "info",
          "icon": "🏠",
          "title": "独处时的自我保护",
          "text": "你先照顾好自己才能照顾别人：先打电话给爸妈报备·开大门方便救援·别慌——你的镇定就是家里最需要的"
        },
        {
          "kind": "highlight",
          "text": "背下120三句话：地址·情况·电话——关键时能救命"
        }
      ]
    }
  ],
  "teach": {
    "sections": [
      {
        "title": "生命体征入门",
        "body": "【体温】腋下 36-37℃ 正常·37.3℃ 起为发烧。\n【脉搏】安静时成人 60-100 次/分。\n【呼吸】16-20 次/分。\n【血压】家用电子血压计：高压 90-140·低压 60-90（帮长辈测量时记录数值供医生参考）。"
      },
      {
        "title": "日常陪护",
        "body": "【生病时】补水·监测·记录·陪伴。\n【术后/年老】走路搀扶患侧·门口别堆杂物（防绊倒）·饮食遵医嘱。\n【心理】多聊天多倾听——孤独比疾病更伤老人。"
      },
      {
        "title": "急救红线",
        "body": "【立即120】胸痛·呼吸困难·意识不清·抽搐·疑似骨折。\n【不要做】移动疑似骨折者·喂昏迷者喝水·随意喂药。\n【要做】保持镇定·报备家长·守在身边等救援。"
      }
    ],
    "examples": [
      {
        "q": "奶奶腋温38.2℃，你在家，怎么办？",
        "steps": [
          "告诉爸妈（第一位）",
          "让奶奶多喝温水休息",
          "半小时后复测并记录",
          "超过38.5℃或精神差→陪就医"
        ],
        "tip": "报备+监测+记录"
      },
      {
        "q": "爷爷散步摔倒说腰疼不能动，你扶他起来吗？",
        "steps": [
          "不扶！可能腰椎骨折",
          "让爷爷保持不动原地舒适体位",
          "立刻打120（地址·情况·电话）",
          "通知爸妈·守在旁边安抚"
        ],
        "tip": "疑似骨折千万别移动"
      }
    ],
    "mistakes": [
      "认为\"多喝热水包治百病\"（异常体征要监测记录必要时就医）",
      "认为摔倒的人要马上扶起来（疑似骨折移动会造成二次伤害）"
    ]
  },
