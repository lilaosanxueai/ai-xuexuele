  "views": [
    {
      "when": 1,
      "title": "之前",
      "subtitle": "有备而去",
      "color": "blue",
      "emoji": "🎫",
      "blocks": [
        {
          "kind": "info",
          "icon": "👕",
          "title": "穿什么",
          "text": "整洁得体就好——不必穿礼服（那是电视里的盛况）·但也别穿拖鞋背心：像去别人家做客的打扮——舒服又郑重"
        },
        {
          "kind": "info",
          "icon": "⏰",
          "title": "提前到场",
          "text": "提前十五二十分钟入场——找座位·看节目单·让心静下来：迟到只能等幕间再进（走动会打扰所有人）——提前是最大的从容"
        },
        {
          "kind": "info",
          "icon": "🎧",
          "title": "先认识曲目",
          "text": "出发前听一遍要演的曲子（网上都有）——现场再听就像见到「听过声音的朋友」：熟悉的旋律会让你听得入迷·陌生感减一半"
        },
        {
          "kind": "highlight",
          "text": "整洁·提前·预习曲目——有备而去不慌张"
        }
      ]
    },
    {
      "when": 2,
      "title": "之中",
      "subtitle": "安静与掌声",
      "color": "green",
      "emoji": "🤫",
      "blocks": [
        {
          "kind": "steps",
          "title": "三条约定",
          "items": [
            "管住声音：不聊天·不哼歌·塑料袋提前拿好（哗啦声很响）·手机静音（震动也算）",
            "管住手：演奏中不拍照不录像不举手机——那道光会打扰演奏者·也挡住后面的人",
            "管住掌声：一首多乐章的曲子——乐章之间不鼓掌（还没结束呢）·等指挥完全放下双手再鼓：实在分不清？跟着大家等一等"
          ]
        },
        {
          "kind": "info",
          "icon": "👏",
          "title": "掌声的学问",
          "text": "什么时候鼓：曲目完整结束·指挥转身鞠躬时；孩子演出哪怕不完美·认真的掌声是最好的鼓励；特别感动可以起立鼓掌（standing）——那是给音乐最高的礼遇"
        },
        {
          "kind": "highlight",
          "text": "管住声音·手机和掌声——三样都为同一个目的"
        }
      ]
    },
    {
      "when": 3,
      "title": "为什么",
      "subtitle": "礼仪的心",
      "color": "amber",
      "emoji": "💛",
      "blocks": [
        {
          "kind": "info",
          "icon": "👂",
          "title": "安静让音乐活",
          "text": "交响乐里有一根弦的轻颤·一次换气的停顿——一点点杂音都会盖住它们：安静不是死板·是让所有人（包括你）听见最细的美好：礼仪是给音乐的礼物"
        },
        {
          "kind": "info",
          "icon": "🤝",
          "title": "尊重演奏者",
          "text": "台上的音乐家练了几十年·今晚为你倾尽全力——安静聆听和真诚掌声是你能给的回应：尊重别人努力的人·也会被尊重"
        },
        {
          "kind": "info",
          "icon": "🌟",
          "title": "共同的魔法",
          "text": "一千个人同时安静·同时屏息·同时在结尾鼓掌——这种「一起」的感觉就是现场音乐会的魔法：你在场的安静·也是演出的一部分"
        },
        {
          "kind": "highlight",
          "text": "你的安静也是演出的一部分——礼仪是给音乐的礼物"
        }
      ]
    }
  ],
