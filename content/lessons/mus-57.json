  "teach": {
    "sections": [
      {
        "title": "什么是休止符",
        "body": "【定义】管「静多久」的记号。\n【对应】几分音符配几分休止。\n【要点】不响≠不数拍。"
      },
      {
        "title": "休止符种类",
        "body": "【四分】静一拍——常见款。\n【八分】静半拍——快速眨眼。\n【全体止符】静四拍——整小节安静。"
      },
      {
        "title": "安静的力量",
        "body": "【笑话】停顿让包袱更响。\n【音乐】突然安静攒期待。\n【高手】会静比会响更难。"
      }
    ],
    "examples": [
      {
        "q": "练四拍安静",
        "steps": [
          "嘴巴闭上身体坐正",
          "心里默数1-2-3-4",
          "手脚都不能动",
          "数到4整齐继续"
        ],
        "tip": "心里数拍"
      },
      {
        "q": "唱《小星星》加停顿",
        "steps": [
          "一闪一闪一晶呀",
          "第四句后静两拍",
          "再接「挂在天上」",
          "听听哪个版本更俏皮"
        ],
        "tip": "停出俏皮感"
      }
    ],
    "mistakes": [
