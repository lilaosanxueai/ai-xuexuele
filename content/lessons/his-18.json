  "teach": {
    "sections": [
      {
        "title": "背景与目的",
        "body": "【内忧外患】太平天国运动 + 第二次鸦片战争。\n【目的】利用西方先进技术维护清王朝统治（不是救中国）。\n【时间】19世纪60—90年代中期。\n【代表】中央奕䜣·地方曾国藩·李鸿章·左宗棠·张之洞。"
      },
      {
        "title": "两项口号",
        "body": "【前期「自强」】军事工业：安庆内军械所·江南制造总局·福州船政局。\n【后期「求富」】民用企业：轮船招商局·开平煤矿·汉阳铁厂·湖北织布局。\n【配套】新式学堂（京师同文馆）·留学教育·筹建新式海陆军（南洋·北洋·福建三支海军）。"
      },
      {
        "title": "评价",
        "body": "【性质】一场失败的封建统治者的自救运动。\n【积极】中国近代化的开端：军事经济教育近代化，客观上刺激民族资本主义产生。\n【局限】只学器物不动制度，没有使中国走上富强道路。"
      }
    ],
    "examples": [
      {
        "q": "怎么区分「自强」类和「求富」类企业？",
        "steps": [
          "造枪炮轮船的 = 军事工业 = 自强",
          "开矿纺纱航运的 = 民用企业 = 求富",
          "江南制造总局：自强",
          "轮船招商局：求富"
        ],
        "tip": "军用自强，民用求富"
      },
      {
        "q": "洋务运动为什么失败？",
        "steps": [
          "根本原因：只学技术，不触动腐朽的封建制度",
          "顽固派处处掣肘，经费被挪用",
          "列强不会真心帮助中国强大",
          "甲午一战被打回原形"
        ],
        "tip": "中体西用的矛盾"
      }
    ],
    "mistakes": [
      "认为洋务运动的目的是使中国富强（目的是维护清朝统治）",
      "把江南制造总局归入「求富」类（军事工业属「自强」）"
    ]
  },
