  "views": [
    {
      "when": 1,
      "title": "银行作用",
      "subtitle": "钱的中转站",
      "color": "blue",
      "emoji": "🏛️",
      "blocks": [
        {
          "kind": "info",
          "icon": "🔄",
          "title": "钱的两条路",
          "text": "你的压岁钱存进银行→银行把它借给要开面包店的叔叔→叔叔的面包店赚钱了·还钱时多还一点（利息）：你帮了叔叔·银行牵了线·分你一点甜头"
        },
        {
          "kind": "info",
          "icon": "🛡️",
          "title": "为什么安全",
          "text": "钱放家里怕丢·银行有保险库有监控：国家还管着银行（存款保险制度）——比床底下的鞋盒安全多了：还能随时取·扫码支付背后都是银行在转账"
        },
        {
          "kind": "highlight",
          "text": "你的钱借给别人干活——利息是谢礼"
        }
      ]
    },
    {
      "when": 2,
      "title": "利息",
      "subtitle": "种子发的芽",
      "color": "amber",
      "emoji": "🌱",
      "blocks": [
        {
          "kind": "info",
          "icon": "🧮",
          "title": "算一笔账",
          "text": "存 100 元·年利率 2%：一年后=100+100×2%=102 元：多出的 2 元就是利息——你的钱工作一年挣来的：利率就是「发芽速度」"
        },
        {
          "kind": "compare",
          "title": "三种存法",
          "items": [
            {
              "label": "活期",
              "value": "随时能取——利率低（约0.2%）：像种子撒土面上·发得慢"
            },
            {
              "label": "定期",
              "value": "约好一年不动——利率高（约2%）：像种子埋进土·安心发芽"
            },
            {
              "label": "零钱罐",
              "value": "一分利息也没有·还可能被自己花掉：种子被吃掉了"
            }
          ]
        },
        {
          "kind": "highlight",
          "text": "利率=发芽速度——定期>活期>零钱罐"
        }
      ]
    },
    {
      "when": 3,
      "title": "复利雪球",
      "subtitle": "世界第八奇迹",
      "color": "green",
      "emoji": "❄️",
      "blocks": [
        {
          "kind": "info",
          "icon": "⛄",
          "title": "利息再生利息",
          "text": "第一年 100→102；第二年利息按 102 算→104.04……利息也成了种子·长出的芽再发芽：爱因斯坦（据传）说复利是「世界第八大奇迹」——时间越长滚得越快"
        },
        {
          "kind": "info",
          "icon": "⏳",
          "title": "时间的魔法",
          "text": "同样存钱：早开始 10 年的人·最后可能多一倍不止——不是本金多·是雪球多滚了 10 圈：理财最重要的不是聪明·是「早开始+不中断」"
        },
        {
          "kind": "highlight",
          "text": "利息也发芽——雪球越滚越大·时间是助推器"
        }
      ]
    }
  ],
