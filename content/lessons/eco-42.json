  "teach": {
    "sections": [
      {
        "title": "单价思维",
        "body": "【定义】每g/ml/个的价格。\n【方法】总价÷含量=单价。\n【原则】比单价不比总价。"
      },
      {
        "title": "常见陷阱",
        "body": "【大包装】单价可能更高——验证。\n【原价虚标】看历史价不看折扣力度。\n【捆绑】不需要=100%浪费。"
      },
      {
        "title": "渠道选择",
        "body": "【超市】急用即得。【电商】比价方便。\n【菜场】生鲜可议价。\n【时间成本】省的钱÷花的时间要合理。"
      }
    ],
    "examples": [
      {
        "q": "A 200g卖8元 B 500g卖17元选哪个",
        "steps": [
          "A单价:8÷0.2=40元/kg",
          "B单价:17÷0.5=34元/kg",
          "B更划算",
          "3秒搞定"
        ],
        "tip": "算单价"
      },
      {
        "q": "\"全场满300减100\"要不要凑单",
        "steps": [
          "先问需要不需要",
          "不需要=花200买不需要的",
          "需要+原本要买→凑",
          "最好的省钱=不买不需要的"
        ],
        "tip": "需要优先"
      }
    ],
    "mistakes": [
      "认为大包装一定划算（单价可能更高）",
      "看到\"打折\"就买（原价可能虚标）"
    ]
  },
