  "teach": {
    "sections": [
      {
        "title": "水的电离与 pH",
        "body": "【水是极弱电解质：H₂O ⇌ H⁺ + OH⁻，室温离子积 Kw = 10⁻¹⁴】\n中性：c(H⁺)=c(OH⁻)=10⁻⁷ → pH=7。\n【pH = -lg c(H⁺)】：pH 每降 1，氢离子浓度 ×10。\npH<7 酸性，>7 碱性（仅限室温）。"
      },
      {
        "title": "强弱电解质",
        "body": "【强电解质：完全电离——盐酸、NaOH、NaCl（强酸强碱大部分盐）】\n【弱电解质：部分电离——醋酸、氨水、水】\n同 pH 的盐酸和醋酸：醋酸浓度大得多（还有大量分子没拆）。\n稀释弱酸，电离度增大——越稀越电离。"
      },
      {
        "title": "盐类水解",
        "body": "【有弱才水解：盐中含弱离子才水解】\n规律：谁强显谁性，都强显中性。\nNaCl：强酸强碱盐，中性；Na₂CO₃：强碱弱酸盐，显碱性（纯碱去油污）；NH₄Cl：强酸弱碱盐，显酸性。\n水解是中和的逆过程，吸热。"
      }
    ],
    "examples": [
      {
        "q": "pH=3 的盐酸和 pH=3 的醋酸，谁浓度大？",
        "steps": [
          "pH 相同 → c(H⁺) 相同",
          "盐酸完全电离：浓度=10⁻³",
          "醋酸部分电离：需更多分子才拆出 10⁻³",
          "醋酸浓度大得多"
        ],
        "tip": "弱酸藏后劲"
      },
      {
        "q": "为什么纯碱水能去油污？",
        "steps": [
          "Na₂CO₃ 是强碱弱酸盐",
          "CO₃²⁻ 水解显碱性",
          "碱性溶液促进油脂分解",
          "热水水解更强效果更好"
        ],
        "tip": "谁强显谁性"
      }
    ],
    "mistakes": [
