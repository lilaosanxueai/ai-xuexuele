  "starterCode": "# 分数除法探索台：a/b ÷ c/d = a/b × d/c\na = 2   # 被除数分子\nb = 3   # 被除数分母\nc = 4   # 除数分子\nd = 5   # 除数分母\n\nhide()\n# 左：原式\nfill_rect(-120, 60, 170, 120, \"#eff6ff\")\nwrite(a + \"/\" + b, -120, 92, \"#1d4ed8\", 26)\nwrite(\"÷\", -120, 60, \"#0f172a\", 20)\nwrite(c + \"/\" + d, -120, 28, \"#1d4ed8\", 26)\nwrite(\"原式\", -120, -18, \"#64748b\", 12)\n# 中间大箭头\nfill_rect(-5, 60, 40, 12, \"#16a34a\")\nfill_rect(15, 48, 16, 36, \"#16a34a\")\nwrite(\"÷ → ×\", -5, -18, \"#16a34a\", 12)\nwrite(\"翻转!\", -5, -36, \"#16a34a\", 12)\n# 右：变乘法\nfill_rect(115, 60, 170, 120, \"#fef3c7\")\nwrite(a + \"/\" + b, 115, 92, \"#b45309\", 26)\nwrite(\"×\", 115, 60, \"#0f172a\", 20)\nwrite(d + \"/\" + c, 115, 28, \"#b45309\", 26)\nwrite(\"除数变倒数\", 115, -18, \"#92400e\", 12)\nwrite(\"结果 = \" + a * d + \"/\" + b * c, 0, -85, \"#dc2626\", 18)\nwrite(\"除以一个数 = 乘它的倒数\", -80, -115, \"#1d4ed8\", 13)\nif c * 1 == d:\n    write(\"除数是 1：结果不变\", -60, 130, \"#16a34a\", 12)\nif c < d:\n    write(\"除数小于 1：结果变大！\", -60, 130, \"#ea580c\", 12)\nif c > d:\n    write(\"除数大于 1：结果变小\", -60, 130, \"#0369a1\", 12)\n",
