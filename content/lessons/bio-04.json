  "teach": {
    "sections": [
      {
        "title": "泌尿系统",
        "body": "【肾脏（产尿）→ 输尿管 → 膀胱（储尿）→ 尿道（排尿）】\n每个肾约有 100 万个肾单位——滤过和重吸收的车间。\n排泄：排出废物（尿素等）≠ 排遗（排食物残渣）。"
      },
      {
        "title": "尿液的形成",
        "body": "【①肾小球滤过：血液→原尿（180L/天，除血细胞和大蛋白外全滤出）】【②肾小管重吸收：葡萄糖、大部分水回血液】\n终尿约 1.5L/天——99% 的水被重吸收。\n尿液=水+尿素+无机盐（无糖无蛋白）。"
      },
      {
        "title": "异常尿液的信号",
        "body": "【尿中有糖：可能糖尿病（血糖过高超滤过阈）】【尿中有蛋白：肾小球通透性增大（肾炎）】\n多尿少尿都可能是肾的警报。\n排泄废物是维持内环境稳定的关键。"
      }
    ],
    "examples": [
      {
        "q": "原尿与血浆的主要区别是？",
        "steps": [
          "肾小球滤过时挡住了血细胞和大分子蛋白质",
          "原尿含：水、葡萄糖、氨基酸、尿素、无机盐",
          "不含：血细胞、大分子蛋白",
          "每天约 180L 原尿"
        ],
        "tip": "滤过=筛子，只挡大分子"
      },
      {
        "q": "为什么正常人的尿里没有葡萄糖？",
        "steps": [
          "原尿中有葡萄糖",
          "肾小管把它全部重吸收回血液",
          "所以终尿无糖",
          "有糖说明血糖超过重吸收能力（糖尿病）"
        ],
        "tip": "重吸收是\"第二次利用\""
      }
    ],
    "mistakes": [
      "把排遗（食物残渣）当排泄（代谢废物）",
      "认为原尿就等于尿液（还差重吸收）"
    ]
  },
