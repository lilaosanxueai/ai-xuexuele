  "starterCode": "# 尿液形成探索台\nreabs = 99   # 重吸收率（%）\n\nhide()\n# 肾单位示意\ncircle(-100, 60, 26, \"#fca5a5\")\nwrite(\"肾小球（滤过）\", -100, 98, \"#dc2626\", 10)\nfill_rect(-100, -10, 60, 10, \"#fdba74\")\nwrite(\"肾小囊→原尿 180L/天\", -100, -32, \"#b45309\", 10)\nfill_rect(60, -10, 90, 10, \"#93c5fd\")\nwrite(\"肾小管（重吸收）\", 60, 8, \"#1d4ed8\", 10)\n# 终尿量柱\nurine = 180 - 180 * reabs / 100\nh = urine * 10\nif h > 60:\n    h = 60\nfill_rect(180, -80 + h / 2, 30, h, \"#fde68a\")\nwrite(urine + \"L/天\", 180, -105, \"#b45309\", 10)\nwrite(\"原尿：无大分子·有葡萄糖\", -150, 130, \"#1d4ed8\", 11)\nwrite(urine + \"L\", 180, -55, \"#92400e\", 10)\nwrite(\"终尿：\" + (1 - reabs * 0.01) + \" × 180 = \" + urine + \"L（无糖·有尿素）\", -60, 105, \"#16a34a\", 11)\nwrite(\"重吸收：\" + reabs + \"% 的水回到血液\", -30, 82, \"#0369a1\", 12)\nwrite(\"正常尿中没有葡萄糖和蛋白质\", -100, -130, \"#dc2626\", 12)\nwrite(\"有糖→可能糖尿病；有蛋白→肾小球炎症\", -130, -150, \"#ea580c\", 11)\n",
