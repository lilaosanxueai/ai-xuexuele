  "teach": {
    "sections": [
      {
        "title": "天气预报解读",
        "body": "【温度】最高最低=温差（备衣）。\n【降水】概率50%以上带伞。\n【风】3-4级树叶摇·6级打伞难。"
      },
      {
        "title": "天气符号",
        "body": "【晴/多云/阴/雨/雪/雾】六种基本。\n【AQI】101以上减少外出。"
      },
      {
        "title": "温度与穿衣",
        "body": "【指南】30短袖·20T恤·10外套·0羽绒。\n【体感】湿度+风+太阳影响实际感受。"
      }
    ],
    "examples": [
      {
        "q": "明天最高28°C最低16°C",
        "steps": [
          "温差12°C",
          "白天T恤舒服",
          "晚上需要薄外套",
          "洋葱式穿法：脱穿方便"
        ],
        "tip": "看温差"
      },
      {
        "q": "天气预报降水概率60%",
        "steps": [
          "50%以上带伞",
          "不是60%时间下雨",
          "类似条件6成日子会下",
          "包里放把折叠伞"
        ],
        "tip": "概率正确理解"
      }
    ],
    "mistakes": [
      "认为\"降水概率70%\"=70%时间下雨（是类似天里70%的日子下雨）",
      "只看温度不看风和湿度（体感可能差很多）"
    ]
  },
