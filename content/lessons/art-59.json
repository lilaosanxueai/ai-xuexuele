  "teach": {
    "sections": [
      {
        "title": "光的方向",
        "body": "【顺光】均匀但平。\n【侧光】立体雕刻感。\n【逆光】剪影与金边。\n【方法】绕半圈看光。"
      },
      {
        "title": "硬光与柔光",
        "body": "【硬】小光源·影子锋利。\n【柔】大光源·影子模糊。\n【改造】树荫白墙纱窗。"
      },
      {
        "title": "黄金时刻",
        "body": "【定义】日出后日落前一小时。\n【好处】侧光+金色+柔。\n【蓝调】日落后20分钟拍夜景。"
      }
    ],
    "examples": [
      {
        "q": "给同学拍立体感肖像",
        "steps": [
          "找窗户侧面的位置",
          "让光从侧面照脸",
          "另一侧留出影子",
          "对焦眼睛按下快门"
        ],
        "tip": "窗边侧光万能"
      },
      {
        "q": "正午户外必须拍照",
        "steps": [
          "找树荫或建筑阴影",
          "让人物整个进影子",
          "避开斑驳的光斑",
          "用环境光均匀照亮"
        ],
        "tip": "阴影是大柔光箱"
      }
    ],
    "mistakes": [
      "正午顶光下拍人脸（鼻下眼窝全是阴影·改阴影或侧光位）",
      "以为阴天不能拍照（阴天柔光是人像好天气）"
    ]
  },
