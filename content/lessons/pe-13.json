  "teach": {
    "sections": [
      {
        "title": "常见损伤",
        "body": "【扭伤（脚踝最常见）、拉伤（大腿后侧）、擦伤、骨折（畸形剧痛需固定送医）】\n原因：热身不足、疲劳、动作错误、场地器材问题。\n疲劳时动作变形——连续打球 2 小时后的损伤率飙升。"
      },
      {
        "title": "RICE 原则",
        "body": "【Rest 休息：立刻停止运动】\n【Ice 冰敷：48 小时内每次 15-20 分钟，隔毛巾防冻伤】\n【Compression 加压：弹性绷带包扎，松紧适度】\n【Elevation 抬高：患肢高于心脏，减轻肿胀】\n48 小时后转为热敷+按摩，促进吸收恢复。"
      },
      {
        "title": "预防",
        "body": "【热身 10 分钟：慢跑升温+动态拉伸（高抬腿、弓步走）】\n【护具：护踝护膝在旧伤或高强度时佩戴】\n【运动后静态拉伸 5-10 分钟+补水】\n循序渐进：每周训练量增加不超过 10%。"
      }
    ],
    "examples": [
      {
        "q": "篮球课崴脚，脚踝迅速肿起，怎么处理？",
        "steps": [
          "停止运动坐地（Rest）",
          "冰敷 15 分钟（Ice）",
          "弹性绷带加压（Compression）",
          "垫高脚（Elevation）→严重肿胀及时就医"
        ],
        "tip": "四步顺序走"
      },
      {
        "q": "为什么 48 小时内不能热敷扭伤？",
        "steps": [
          "急性期毛细血管破裂出血",
          "热敷血管扩张加重肿胀",
          "先冰敷收缩血管止血",
          "48h 后再热敷促吸收"
        ],
        "tip": "先冰后热"
      }
    ],
    "mistakes": [
      "崴脚后揉搓热敷（加重出血肿胀）",
      "鼻出血仰头（血倒流呛入气管，应低头捏鼻翼）"
    ]
  },
