  "teach": {
    "sections": [
      {
        "title": "什么是年画",
        "body": "【年画：过年张贴的木版画·祈福纳吉】\n历史：始于古代门神画·明清最盛·天津杨柳青·苏州桃花坞最出名。\n特点：色彩鲜艳·构图饱满·形象喜庆。\n年画是贴在墙上的祝福。"
      },
      {
        "title": "谐音的智慧",
        "body": "【手法：取事物读音的谐音·寄托吉祥】\n鱼→余（年年有余）·蝠→福（五福捧寿）·\n葫芦→福禄·瓶→平安·橘→吉·糕→高（步步高升）。\n不识字也能看懂——民间智慧的传播设计。"
      },
      {
        "title": "经典题材",
        "body": "【娃娃类：胖娃娃抱鱼·连年有余】\n【门神类：秦琼尉迟恭·守家护院】\n【福寿类：五福捧寿·寿星图】\n【农事类：春牛图·祈愿丰收】\n年画=古人的「表情包」·把祝福画出来。"
      }
    ],
    "examples": [
      {
        "q": "给爷爷奶奶祝寿选什么年画？",
        "steps": [
          "祝寿主题",
          "五福捧寿：五只蝙蝠围寿字",
          "或寿星图·仙鹤·松树",
          "避开不相关题材"
        ],
        "tip": "蝠=福"
      },
      {
        "q": "为什么年画多用红黄等鲜艳色？",
        "steps": [
          "过年要喜庆热闹",
          "红黄暖色醒目提情绪",
          "木版印刷成本所限用平涂色",
          "饱满构图+鲜艳色=年味"
        ],
        "tip": "服务于祝福"
      }
    ],
